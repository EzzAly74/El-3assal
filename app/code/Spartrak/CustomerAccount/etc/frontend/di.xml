<?xml version="1.0"?>
<!--
  FRONTEND scope, not global. The only consumer is the storefront account card
  (Figma 821:17286), and the plugin's target — Magento\Customer\Controller\
  Account\EditPost — is a frontend controller that does not exist in the admin
  or in a CLI request. Declaring it globally would load the class into every
  area for a form only one of them serves.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\Controller\Account\EditPost">
        <plugin name="spartrak_split_account_full_name"
                type="Spartrak\CustomerAccount\Plugin\Customer\SplitFullName"
                sortOrder="10"/>
    </type>

    <!--
      Core redirects an empty address book to /customer/address/new and shows
      Magento's stock address form there. Figma's address book is a card with
      its own empty state and its own "اضف عنوان جديد" action, so the page is
      rendered instead of jumped over. Full reasoning in the plugin.
    -->
    <type name="Magento\Customer\Controller\Address\Index">
        <plugin name="spartrak_show_empty_address_book"
                type="Spartrak\CustomerAccount\Plugin\Customer\ShowEmptyAddressBook"/>
    </type>

    <!--
      THE ONE PLUGIN HERE BOUND TO AN INTERFACE RATHER THAN A CLASS, and
      deliberately so. Magento\Sales\Controller\OrderInterface is @api and names
      exactly the ten frontend controllers that serve one customer's OWN orders;
      every guest-facing equivalent is a Magento\Sales\Controller\Guest\* class
      that does not implement it. Binding to the interface therefore guards the
      whole area — history, view, reorder, the print actions — without naming a
      single class we would have to keep in step with Magento_Sales, and without
      any possibility of catching the guest order lookup by accident.

      Magento_Customer binds the same shape of plugin to its own
      Magento\Customer\Controller\AccountInterface. No module in 2.4.8 does it
      for this one, which is the gap the plugin documents.
    -->
    <type name="Magento\Sales\Controller\OrderInterface">
        <plugin name="spartrak_prompt_sign_in_for_guest"
                type="Spartrak\CustomerAccount\Plugin\Sales\PromptSignInForGuest"/>
    </type>
</config>
