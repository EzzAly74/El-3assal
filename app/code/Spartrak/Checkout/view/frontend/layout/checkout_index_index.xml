<?xml version="1.0"?>
<!--
/**
 * Spartrak checkout — component wiring.
 *
 * ONE VALUE IS OVERRIDDEN on the progress bar: the class behind the
 * `progressBar` node. Layout merging is a deep array merge, so naming only the
 * leaf that changes leaves `displayArea` and the `deps` list — which is what
 * defers the bar until the shipping and payment components exist — exactly as
 * Magento_Checkout declared them. Restating the whole node would fork those two
 * values into a second copy that has to be kept in step with core by hand
 * (CLAUDE.md §9).
 *
 * The replacement EXTENDS Magento_Checkout/js/view/progress-bar rather than
 * standing in for it; see the header of web/js/view/progress-bar.js for why
 * that distinction matters (core's component owns checkout's hash routing).
 *
 * ===========================================================================
 * THE PAGE LAYOUT IS CHANGED FROM `checkout` TO `1column`
 * ===========================================================================
 * Magento ships checkout on its own `checkout` page layout, and that layout
 * `<update handle="empty"/>` — it deletes the site header outright and rebuilds
 * a stripped one containing nothing but the logo, on the usual reasoning that a
 * funnel should have no exits.
 *
 * This design does not do that. Figma's checkout frame (549:2753) carries the
 * full SpareTrak chrome: the top promo banner, the utility row, the search bar,
 * the account and cart controls, and the complete footer. Keeping `checkout`
 * would have meant rebuilding every one of those inside a checkout-only header,
 * i.e. a second copy of the site header to maintain.
 *
 * ONE THING IS DROPPED, AND THE DESIGN IS EXPLICIT ABOUT IT. Measured off the
 * frames: the navbar is 157.42 tall on checkout (549:2764) and 223.42 on the
 * cart (553:4674). The 66px difference is exactly the mega-menu row
 * ("Navbar - Menus", 553:4730), which the cart has and checkout does not. So
 * the category navigation is removed here and only here — the funnel keeps the
 * shopper's own controls and loses the browse affordance.
 *
 * `spartrak.primary_nav` is a child block of `porto_header`, rendered by this
 * theme's Smartwave_Porto/templates/html/header.phtml, so removing it by name
 * takes the row out without touching the header template.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="spartrak.primary_nav" remove="true"/>

        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="progressBar" xsi:type="array">
                                    <item name="component" xsi:type="string">Spartrak_Checkout/js/view/progress-bar</item>
                                </item>

                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <!--
                                          ===================================================
                                          THE DELIVERY-MODE SEGMENTS AND THE PICKUP LISTS
                                          ===================================================
                                          Both are children of `shippingAddress`, and both
                                          render through a `displayArea` the theme's
                                          shipping.html asks for by name. That is how a
                                          component reaches a specific point in a template it
                                          does not own - and it is why the two new regions in
                                          that file are `getRegion(...)` calls rather than
                                          hardcoded markup.

                                          ADDED HERE, NOT REPLACING ANYTHING. Every core child
                                          of shippingAddress - the address list, the form, the
                                          method list - is untouched; these two simply join
                                          them, and the template decides which are visible.
                                        -->
                                        <item name="shipping-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="shippingAddress" xsi:type="array">
                                                    <!--
                                                      ===========================================
                                                      THE ADD-ADDRESS DIALOG
                                                      ===========================================
                                                      Figma 557:5173 (desktop, an 800-wide centred
                                                      modal) and 687:15189 (mobile, a bottom
                                                      sheet). Magento's own modal widget does both
                                                      — `responsive: true` is what turns a popup
                                                      into a slide-up panel on a narrow viewport,
                                                      which is exactly the transition the two
                                                      frames describe — so only the labels change
                                                      here and the rest is styling.

                                                      Only the leaves that differ are named. Layout
                                                      merging is a deep array merge, so `element`,
                                                      `type`, `responsive`, `innerScroll` and
                                                      `trigger` all survive from core untouched.

                                                      `title` is emptied because Figma's dialog
                                                      draws its own heading inside the body, beside
                                                      the close control; leaving core's would print
                                                      the heading twice.
                                                    -->
                                                    <item name="config" xsi:type="array">
                                                        <item name="popUpForm" xsi:type="array">
                                                            <item name="options" xsi:type="array">
                                                                <item name="title" xsi:type="string" translate="true">Add a new shipping address</item>
                                                                <item name="modalClass" xsi:type="string">new-shipping-address-modal spartrak-address-modal</item>
                                                                <item name="buttons" xsi:type="array">
                                                                    <item name="save" xsi:type="array">
                                                                        <item name="text" xsi:type="string" translate="true">Add a new address</item>
                                                                        <item name="class" xsi:type="string">action primary action-save-address spartrak-address-modal__save</item>
                                                                    </item>
                                                                    <item name="cancel" xsi:type="array">
                                                                        <item name="text" xsi:type="string" translate="true">Discard</item>
                                                                        <item name="class" xsi:type="string">action secondary action-hide-popup spartrak-address-modal__cancel</item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                    <item name="children" xsi:type="array">
                                                        <item name="spartrak-delivery-mode" xsi:type="array">
                                                            <item name="component" xsi:type="string">Spartrak_Checkout/js/view/delivery-mode</item>
                                                            <item name="displayArea" xsi:type="string">spartrak-delivery-mode</item>
                                                            <item name="sortOrder" xsi:type="string">0</item>
                                                        </item>
                                                        <item name="spartrak-pickup-locations" xsi:type="array">
                                                            <item name="component" xsi:type="string">Spartrak_Checkout/js/view/pickup-locations</item>
                                                            <item name="displayArea" xsi:type="string">spartrak-pickup-locations</item>
                                                            <item name="sortOrder" xsi:type="string">10</item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>

                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <!--
                                                          ===========================================
                                                          THE ORDER NOTE
                                                          ===========================================
                                                          Figma puts the note field below the payment
                                                          rows (552:11505), inside the payment step, so
                                                          it is a child of `payment` reached through a
                                                          displayArea the theme's payment.html asks for
                                                          by name.

                                                          It writes to quote.customer_note, a column
                                                          Magento already carries through to the order -
                                                          see Spartrak\Checkout\Controller\Note\Save.
                                                        -->
                                                        <item name="spartrak-order-note" xsi:type="array">
                                                            <item name="component" xsi:type="string">Spartrak_Checkout/js/view/order-note</item>
                                                            <item name="displayArea" xsi:type="string">spartrak-order-note</item>
                                                            <item name="sortOrder" xsi:type="string">100</item>
                                                        </item>

                                                        <!--
                                                          ===========================================
                                                          THE PROMO PANEL MOVES OUT OF THIS STEP
                                                          ===========================================
                                                          Magento_SalesRule mounts its coupon form here,
                                                          under `afterMethods`. Figma has it in the
                                                          summary column (554:11806), beneath the totals
                                                          card.

                                                          jsLayout has no <move>, so the original is
                                                          switched off and an identical component is
                                                          declared under `sidebar` below.
                                                          `componentDisabled` is Magento's own supported
                                                          way to disable a jsLayout node; the component,
                                                          its coupon actions and its messages are
                                                          otherwise untouched.
                                                        -->
                                                        <item name="afterMethods" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="discount" xsi:type="array">
                                                                    <item name="componentDisabled" xsi:type="boolean">true</item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>

                                <!--
                                  ===================================================
                                  THE SUMMARY COLUMN
                                  ===================================================
                                  Two additions, both rendered through displayAreas the
                                  theme's sidebar.html and summary.html ask for by name:

                                    spartrak-place-order  the single CTA — this design
                                                          has one button for the whole
                                                          checkout, not one per payment
                                                          method
                                    spartrak-promo        the coupon panel, relocated
                                                          from the payment step above

                                  The promo node repeats Magento_SalesRule's own
                                  declaration in full — component, messages child and
                                  captcha child — because a disabled node cannot be
                                  re-parented, only replaced. It is deliberately
                                  identical to the original apart from where it sits.
                                -->
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <!--
                                          FIGMA DRAWS NO SHIP-TO REVIEW BLOCK ON THIS STEP
                                          ============================================
                                          Core renders `shipping-information` into the
                                          payment step: a panel repeating the chosen
                                          address and shipping method, each with an
                                          "edit" button. Read off 554:10780, the payment
                                          frame's left column holds exactly two things —
                                          Order summary container (528x680) and Promo
                                          code container (528x178). There is no third
                                          panel, on this frame or on the 440 one.

                                          DISABLED, NOT HIDDEN IN CSS. The node carries
                                          four child components of its own; display:none
                                          would still build and bind every one of them,
                                          and would leave their markup in the DOM for
                                          screen readers to read out. componentDisabled
                                          stops the renderer before it instantiates the
                                          subtree (Magento_Ui .../renderer/layout.js:291).

                                          Going back is not lost with it. Those "edit"
                                          buttons are core's only route back, but this
                                          checkout has its own: the progress bar's
                                          markers jump to any completed step
                                          (Spartrak_Checkout/js/view/progress-bar.js),
                                          which is the affordance 554:10848 draws.
                                        -->
                                        <item name="shipping-information" xsi:type="array">
                                            <item name="componentDisabled" xsi:type="boolean">true</item>
                                        </item>
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <!--
                                                  ===================================================
                                                  THE CARD'S ORDER IS DECLARED, NOT INHERITED
                                                  ===================================================
                                                  Figma 551:11106 stacks the card as
                                                  title -> line items -> totals -> CTA.

                                                  Magento_Checkout declares `totals` BEFORE
                                                  `cart_items` and gives neither a sortOrder, so
                                                  `elems()` handed the summary template the totals
                                                  first and the products second - which is what the
                                                  page rendered.

                                                  Every child of this card now names its own
                                                  sortOrder. Leaving some unsorted would put them
                                                  back at the mercy of registration order, which is
                                                  the bug that was here.
                                                -->
                                                <item name="itemsBefore" xsi:type="array">
                                                    <item name="sortOrder" xsi:type="string">5</item>
                                                </item>
                                                <item name="cart_items" xsi:type="array">
                                                    <item name="sortOrder" xsi:type="string">10</item>
                                                </item>
                                                <item name="itemsAfter" xsi:type="array">
                                                    <item name="sortOrder" xsi:type="string">20</item>
                                                </item>

                                                <!--
                                                  ===================================================
                                                  MAGENTO_TAX OWNS THESE THREE TEMPLATES, NOT
                                                  MAGENTO_CHECKOUT - WHICH IS WHY THE THEME'S
                                                  OVERRIDES NEVER RENDERED
                                                  ===================================================
                                                  The theme ships
                                                  Magento_Checkout/web/template/summary/{subtotal,
                                                  shipping,grand-total}.html, and those are the
                                                  right files. They were simply never asked for:
                                                  Magento_Tax's own checkout_index_index.xml
                                                  REPLACES all three components with
                                                  `Magento_Tax/js/view/checkout/summary/*`, whose
                                                  defaults point at `Magento_Tax/checkout/summary/*`.

                                                  So the checkout rendered core's tax templates -
                                                  three `<tr>` roots inside the theme's
                                                  `<div class="spartrak-summary-totals">`. A `<tr>`
                                                  in a flex container blockifies, its `<th>`/`<td>`
                                                  generate an anonymous inline table, and the row
                                                  shrink-wraps: label and value sat next to each
                                                  other at the reading edge instead of spanning the
                                                  card, the dividers never appeared, the grand total
                                                  never turned blue, and the shipping row printed
                                                  `getShippingMethodTitle()` on a second line.
                                                  Meanwhile Magento_SalesRule's savings row - the
                                                  one override that IS reached - spread the full
                                                  width, which is the mismatch visible on the page.

                                                  The COMPONENT stays Magento_Tax's. It is the
                                                  tax-aware one and nothing here wants to lose that;
                                                  only the template is named back. `title` is set
                                                  alongside it for the two rows whose wording Figma
                                                  states (551:11185 / 551:11189) - as NEW source
                                                  strings rather than by retranslating "Shipping"
                                                  and "Order Total", which the progress bar and the
                                                  cart also use.
                                                -->
                                                <item name="totals" xsi:type="array">
                                                    <item name="sortOrder" xsi:type="string">100</item>
                                                    <item name="children" xsi:type="array">
                                                        <item name="subtotal" xsi:type="array">
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">Magento_Checkout/summary/subtotal</item>
                                                            </item>
                                                        </item>
                                                        <item name="shipping" xsi:type="array">
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">Magento_Checkout/summary/shipping</item>
                                                                <item name="title" xsi:type="string" translate="true">Shipping charges</item>
                                                            </item>
                                                        </item>
                                                        <item name="grand-total" xsi:type="array">
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">Magento_Checkout/summary/grand-total</item>
                                                                <item name="title" xsi:type="string" translate="true">Order grand total</item>
                                                            </item>
                                                        </item>

                                                        <!--
                                                          Figma draws no tax row and no fixed-fee
                                                          row, and this store collects neither
                                                          today. They are pointed at the generic
                                                          Spartrak row anyway: both components stay
                                                          registered, both decide for themselves
                                                          whether to display, and the day a merchant
                                                          switches one on it joins the stack as a
                                                          styled row instead of a stray `<tr>`.
                                                        -->
                                                        <item name="tax" xsi:type="array">
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">Magento_Checkout/summary/total-row</item>
                                                            </item>
                                                        </item>
                                                        <item name="weee" xsi:type="array">
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">Magento_Checkout/summary/total-row</item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>

                                                <!--
                                                  The CTA is the LAST thing in the
                                                  summary card, under the totals
                                                  (Figma 551:11152).

                                                  Its position comes from sortOrder
                                                  and not from a second render in
                                                  the template: the summary renders
                                                  elems(), which already contains
                                                  every child, so asking for it
                                                  again by displayArea drew the
                                                  button twice.

                                                  200 leaves room for a total a
                                                  merchant or a module inserts after
                                                  the grand total, which must still
                                                  land above the button.
                                                -->
                                                <item name="spartrak-place-order" xsi:type="array">
                                                    <item name="component" xsi:type="string">Spartrak_Checkout/js/view/place-order</item>
                                                    <item name="displayArea" xsi:type="string">spartrak-place-order</item>
                                                    <item name="sortOrder" xsi:type="string">200</item>
                                                </item>
                                            </item>
                                        </item>
                                        <item name="spartrak-promo" xsi:type="array">
                                            <item name="component" xsi:type="string">Magento_SalesRule/js/view/payment/discount</item>
                                            <item name="displayArea" xsi:type="string">spartrak-promo</item>
                                            <item name="children" xsi:type="array">
                                                <item name="errors" xsi:type="array">
                                                    <item name="sortOrder" xsi:type="string">0</item>
                                                    <item name="component" xsi:type="string">Magento_SalesRule/js/view/payment/discount-messages</item>
                                                    <item name="displayArea" xsi:type="string">messages</item>
                                                </item>
                                                <item name="captcha" xsi:type="array">
                                                    <item name="component" xsi:type="string">Magento_SalesRule/js/view/payment/captcha</item>
                                                    <item name="displayArea" xsi:type="string">captcha</item>
                                                    <item name="formId" xsi:type="string">sales_rule_coupon_request</item>
                                                    <item name="configSource" xsi:type="string">checkoutConfig</item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
