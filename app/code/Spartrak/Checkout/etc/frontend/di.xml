<?xml version="1.0"?>
<!--
/**
 * Frontend-only: the controller this plugs is a storefront action, and the
 * customer session it reasons about has no meaning in the admin area.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Checkout\Controller\Index\Index">
        <plugin name="spartrak_prompt_login_for_guest" type="Spartrak\Checkout\Plugin\PromptLoginForGuest"/>
    </type>

    <!--
      ===================================================================
      THE ADDRESS FORM'S SHAPE
      ===================================================================
      Frontend-only on purpose. LayoutProcessor builds the STOREFRONT
      checkout's jsLayout and has no counterpart in the admin, whose order
      -create form is a different block entirely and must keep every field
      this hides — an agent taking an order by phone may well need to type a
      company name or a postcode.
    -->
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="spartrak_address_form_layout"
                type="Spartrak\Checkout\Plugin\Checkout\AddressFormLayout"
                sortOrder="100"/>
    </type>

    <!--
      ===================================================================
      THE CART LINE'S QUANTITY OPTIONS, HANDED TO EVERY ITEM RENDERER
      ===================================================================
      Declared on the BASE renderer rather than on each block in layout XML.

      Magento resolves a cart item renderer per product type - default, simple,
      virtual, configurable, grouped, bundle, downloadable - and every one of
      them extends this class. A layout <referenceBlock> would have to name all
      of them, and would silently miss any product type a merchant installs
      later; that product's cart line would then render a quantity control with
      no options at all.

      Magento's DI configuration is inherited down the class hierarchy, so one
      declaration here reaches every renderer, present and future.

      It goes into the `data` array because that is the argument a Block accepts
      for view models - the template reads it back with
      getData('qty_options_view_model'), exactly as it would an argument set in
      layout.
    -->
    <!--
      ===================================================================
      "REMOVE THIS PRODUCT?" ON EVERY CART LINE
      ===================================================================
      Frontend-only: the admin's order-create screen removes items through a
      different path entirely, and an agent on the phone does not want a
      confirmation dialog between them and a customer.

      One plugin covers every product type, because every cart item renderer
      builds its bin's `data-post` from this one helper method. See the class
      for why the dialog needs no JavaScript of its own.
    -->
    <type name="Magento\Checkout\Helper\Cart">
        <plugin name="spartrak_confirm_cart_item_removal"
                type="Spartrak\Checkout\Plugin\Checkout\ConfirmCartItemRemoval"/>
    </type>

    <!--
      ===================================================================
      HOW MANY QUANTITIES THE CART LINE'S DROPDOWN OFFERS
      ===================================================================
      The same 10 the cart DRAWER offers - see the theme's
      Magento_Checkout/layout/default.xml, which sets `maxQtyOptions: 10` on
      the minicart item renderer. Stated here rather than inside the view
      model so the two surfaces' lengths sit in configuration and a merchant
      changing one can see the other.

      Stock is deliberately NOT a factor in this number; the view model's
      header explains why, and why it used to be.
    -->
    <type name="Spartrak\Checkout\ViewModel\CartQtyOptions">
        <arguments>
            <argument name="maxOptions" xsi:type="number">10</argument>
        </arguments>
    </type>

    <!--
      ===================================================================
      THE CART LINE'S VIEW MODELS
      ===================================================================
      A PLUGIN, not `<argument name="data">`. This block used to read

          <type name="Magento\Checkout\Block\Cart\Item\Renderer">
              <arguments><argument name="data" xsi:type="array"> ... </argument></arguments>
          </type>

      and it was discarded at construction on every request: layout creates
      blocks with an explicit `data` argument, and ObjectManager merges di.xml
      arguments with array_replace(), which is shallow. The runtime `data`
      replaced the configured one wholesale, all three view models arrived as
      null, and the cart line rendered its quantity as dead text.

      See the plugin class for the full trace and for why one plugin on the
      base renderer is the right shape where seven <referenceBlock> entries
      are not.

      Injected rather than fetched with $this->helper() inside the template:
      core's own cart item template does the latter and suppresses the
      Magento2.Templates.ThisInTemplate sniff to do it; passing them in keeps
      the override free of both the service locator and the suppression.
    -->
    <type name="Magento\Checkout\Block\Cart\Item\Renderer">
        <plugin name="spartrak_cart_item_view_models"
                type="Spartrak\Checkout\Plugin\Checkout\CartItemViewModels"/>
    </type>

</config>
