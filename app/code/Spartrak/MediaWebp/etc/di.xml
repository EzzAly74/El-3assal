<?xml version="1.0"?>
<!--
  Copyright © ElAssal for Trading & Supply. All rights reserved.

  WebP enablement, part 1 of 2 - everything that is area-agnostic.

  Each <argument> below ADDS a webp item to a list Magento already declares;
  DI merges arrays by item name, so the core jpg/jpeg/gif/png entries stay
  exactly as they are and nothing is redeclared.

  The preference at the top is the load-bearing one: without a GD2 adapter that
  can decode WebP, every allow-list widened here would still fail at validation
  (upload) and at thumbnail/cache generation. See Image/Adapter/Gd2.php.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Framework\Image\Adapter\Gd2" type="Spartrak\MediaWebp\Image\Adapter\Gd2"/>

    <!--
      Upload-time "is this really a decodable image?" check. Core's validator
      only opens formats listed in a private map, so WebP would otherwise be the
      one allowed format that reaches pub/media unopened. See the plugin.
    -->
    <type name="Magento\MediaStorage\Model\File\Validator\Image">
        <plugin name="spartrak_validate_webp_is_decodable"
                type="Spartrak\MediaWebp\Plugin\MediaStorage\ValidateWebpIsDecodable"/>
    </type>

    <!--
      The media browser behind the product/category/CMS description editors.
      `allowed` gates the upload itself and the file listing; `image_allowed`
      gates which of those the browser is willing to render a thumbnail for.
      Both are extension => MIME maps and both are checked, so both need webp.
    -->
    <type name="Magento\Cms\Model\Wysiwyg\Images\Storage">
        <arguments>
            <argument name="extensions" xsi:type="array">
                <item name="allowed" xsi:type="array">
                    <item name="webp" xsi:type="string">image/webp</item>
                </item>
                <item name="image_allowed" xsi:type="array">
                    <item name="webp" xsi:type="string">image/webp</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!--
      Category image upload. Shares the product gallery's Figma-sourced assets,
      so leaving it on jpg/png would mean WebP works in three of the four admin
      image fields - an inconsistency, not a smaller change.
    -->
    <virtualType name="Magento\Catalog\CategoryImageUpload" type="Magento\Catalog\Model\ImageUploader">
        <arguments>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="webp" xsi:type="string">webp</item>
            </argument>
            <argument name="allowedMimeTypes" xsi:type="array">
                <item name="webp" xsi:type="string">image/webp</item>
            </argument>
        </arguments>
    </virtualType>

    <!--
      Indexes a freshly uploaded file into media_gallery_asset. Without webp
      here the file lands on disk but never appears in the Media Gallery grid.
    -->
    <type name="Magento\MediaGalleryIntegration\Plugin\SaveImageInformation">
        <arguments>
            <argument name="imageExtensions" xsi:type="array">
                <item name="webp" xsi:type="string">webp</item>
            </argument>
        </arguments>
    </type>

    <!--
      The same, for files that arrive outside the admin (deploy, rsync, import)
      and are picked up by `bin/magento media-gallery:sync` / its cron.
    -->
    <type name="Magento\MediaGallerySynchronization\Model\FetchMediaStorageFileBatches">
        <arguments>
            <argument name="fileExtensions" xsi:type="array">
                <item name="webp" xsi:type="string">webp</item>
            </argument>
        </arguments>
    </type>

    <!--
      Renditions are the downscaled copies actually inserted into WYSIWYG
      content when "Media Gallery Image Optimization" is on. Omitting webp here
      would silently fall back to inserting the full-size original - a direct
      LCP regression on any page using a WebP inline image.
    -->
    <type name="Magento\MediaGalleryRenditions\Model\Queue\FetchRenditionPathsBatches">
        <arguments>
            <argument name="fileExtensions" xsi:type="array">
                <item name="webp" xsi:type="string">webp</item>
            </argument>
        </arguments>
    </type>
</config>
