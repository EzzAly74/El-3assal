<?xml version="1.0"?>
<!--
  ===========================================================================
  WHY THE CACHE PLUGIN IS GLOBAL AND THE FORM PLUGIN IS NOT
  ===========================================================================
  A review's aggregates change from BOTH areas: a shopper posts one on the
  storefront, and a moderator approves, edits or deletes one in the admin. The
  page that has to stop being stale is the same storefront PDP either way, so
  the invalidation plugin cannot be area-scoped — an `adminhtml` approval is in
  fact the more important of the two, because that is the moment a review
  becomes publicly visible.

  Spartrak\Review\Plugin\Review\SupplyFieldsFigmaDoesNotCollect, by contrast,
  plugs a FRONTEND controller and only ever runs there. It is declared in
  etc/frontend/di.xml, so the admin's own review form — which does collect a
  nickname and a summary, because Magento's admin form has both fields — is
  left completely alone.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
      ===========================================================================
      THE RESOURCE MODEL, NOT THE MODEL, AND NOT AN EVENT
      ===========================================================================
      `Magento\Review\Model\ResourceModel\Review::aggregate()` is the one method
      that recomputes `review_entity_summary` for a product, and every path that
      changes what a shopper sees goes through it:

          storefront post   Controller\Product\Post   -> $review->aggregate()
          admin save        Controller\Adminhtml\Product\Save
                                                      -> $review->aggregate()
          admin delete      ResourceModel\Review::_afterDelete
                                                      -> $this->aggregate()

      The MODEL's aggregate() would miss the delete path, which calls the
      resource directly. An observer was considered and there is no event to
      hang it on: Magento\Review\Model\Review declares no `_eventPrefix`, so it
      dispatches `core_abstract_*` events shared with every other model in the
      platform, and filtering those by instance in an observer is exactly the
      kind of shotgun listener CLAUDE.md section 9 asks us not to write.
    -->
    <type name="Magento\Review\Model\ResourceModel\Review">
        <plugin name="spartrak_review_invalidate_product_page_cache"
                type="Spartrak\Review\Plugin\Review\InvalidateProductPageCache"
                sortOrder="10"/>
    </type>

</config>
