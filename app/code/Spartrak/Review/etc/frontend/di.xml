<?xml version="1.0"?>
<!--
  The storefront review POST, completed before core validates it.

  `before` and not `around`: see the plugin's own header for why the request —
  not the review model — is what it writes to, and why that has to happen
  before Post::execute() reads the post value.

  ===========================================================================
  AND WHY THE STORE-VIEW PLUGIN IS HERE TOO, NOT IN etc/di.xml
  ===========================================================================
  A review written on the Arabic store view was published to that store view
  alone, so it did not exist on the English one — same catalogue, same product,
  two different review counts. PublishReviewToEveryStoreView widens it.

  It is scoped to `frontend` deliberately, and the scoping IS the rule: the
  admin's own review form has a "Visible In" multiselect, and a moderator who
  restricts a review to one store view has made a decision no plugin should
  silently reverse. In `adminhtml` this plugin does not exist.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Review\Controller\Product\Post">
        <plugin name="spartrak_review_supply_missing_fields"
                type="Spartrak\Review\Plugin\Review\SupplyFieldsFigmaDoesNotCollect"
                sortOrder="10"/>
    </type>
    <type name="Magento\Review\Model\ResourceModel\Review">
        <plugin name="spartrak_review_publish_to_every_store_view"
                type="Spartrak\Review\Plugin\Review\PublishReviewToEveryStoreView"
                sortOrder="10"/>
    </type>

    <!--
      ===========================================================================
      THE DIALOG NEVER RENDERS WITHOUT STARS
      ===========================================================================
      Magento seeds product ratings and NO `rating_store` rows, and
      `Block\Form::getRatings()` inner-joins that table (except in single-store
      mode, which this two-store-view storefront is not). So the dialog rendered
      with no stars, every review through it carried no rating, and the panel
      read `0 تقييمات · 3 مراجعات` with nothing anywhere saying why.

      Setup\Patch\Data\PublishProductRatingToStoreViews fixes the data — and only
      when somebody runs `setup:upgrade`. A deploy that compiles, deploys static
      content and flushes the cache but skips that command ships the new dialog
      against the old data, silently. Three reviews were lost to exactly that.

      So the guarantee is moved to the one point that cannot be skipped: the
      moment the form asks for its ratings. It writes at most once per store
      view and is a pass-through for ever after. See the plugin for why a write
      during a page render is the right trade here.
    -->
    <type name="Magento\Review\Block\Form">
        <plugin name="spartrak_review_ensure_rating_is_available"
                type="Spartrak\Review\Plugin\Review\EnsureRatingIsAvailable"
                sortOrder="10"/>
    </type>
</config>
