<?xml version="1.0"?>
<!--
  Spartrak_Payment dresses payment methods for the Spartrak checkout row. It
  never decides WHICH methods exist, so it declares no dependency on any
  specific payment module - not Paymob, not offline-payments. It sequences
  after Magento_Payment (whose helper enumerates the installed methods) and
  Magento_Checkout (whose ConfigProviderInterface it implements), and after
  Spartrak_Checkout so the theme's row template is registered before the mixin
  that assigns it.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Spartrak_Payment">
        <sequence>
            <module name="Magento_Payment"/>
            <module name="Magento_Checkout"/>
            <module name="Magento_Config"/>
            <module name="Spartrak_Checkout"/>
        </sequence>
    </module>
</config>
