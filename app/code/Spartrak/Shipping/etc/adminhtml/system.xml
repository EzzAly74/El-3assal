<?xml version="1.0"?>
<!--
/**
 * Stores > Configuration > Sales > Delivery Methods > SpareTrak Delivery.
 *
 * Grouped as one carrier with two tiers rather than two carriers, because that
 * is how a merchant reasons about it: "our delivery options", not two unrelated
 * modules that happen to render beside each other.
 *
 * `showInStore="1"` on every content field is the point of this file — the
 * titles and the delivery windows are the Arabic storefront's copy, and the
 * English store view needs its own. Prices are store-scoped too, since a
 * campaign may waive express on one view and not another.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="spartrak" translate="label" type="text" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>SpareTrak Delivery</label>

                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Carrier Title</label>
                </field>

                <!-- ================= شحن عادي ================= -->
                <field id="standard_enabled" translate="label" type="select" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Standard — Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="standard_title" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Standard — Method Name</label>
                    <comment>Shown to the shopper on the shipping step.</comment>
                </field>
                <field id="standard_price" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Standard — Price</label>
                    <validate>validate-zero-or-greater</validate>
                    <comment>Set 0 for free delivery.</comment>
                </field>
                <field id="standard_days_min" translate="label" type="text" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Standard — Delivery Days (from)</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="standard_days_max" translate="label" type="text" sortOrder="140" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Standard — Delivery Days (to)</label>
                    <validate>validate-digits</validate>
                    <comment>Leave either field empty to hide the delivery window for this method.</comment>
                </field>

                <!-- ================ شحن اكسبريس ================ -->
                <field id="express_enabled" translate="label" type="select" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Express — Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="express_title" translate="label" type="text" sortOrder="210" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Express — Method Name</label>
                </field>
                <field id="express_price" translate="label" type="text" sortOrder="220" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Express — Price</label>
                    <validate>validate-zero-or-greater</validate>
                </field>
                <field id="express_days_min" translate="label" type="text" sortOrder="230" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Express — Delivery Days (from)</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="express_days_max" translate="label" type="text" sortOrder="240" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Express — Delivery Days (to)</label>
                    <validate>validate-digits</validate>
                </field>

                <!-- ============== standard carrier plumbing ============== -->
                <field id="sallowspecific" translate="label" type="select" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Ship to Applicable Countries</label>
                    <frontend_class>shipping-applicable-country</frontend_class>
                    <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="910" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ship to Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="showmethod" translate="label" type="select" sortOrder="920" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Show Method if Not Applicable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="specificerrmsg" translate="label" type="textarea" sortOrder="930" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Displayed Error Message</label>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="940" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Sort Order</label>
                </field>
            </group>
        </section>
    </system>
</config>
