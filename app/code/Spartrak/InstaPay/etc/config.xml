<?xml version="1.0"?>
<!--
  Defaults for the InstaPay method. Every one of these is editable in
  Stores > Configuration > Sales > Payment Methods > InstaPay; nothing about the
  merchant's account is hardcoded, which is the whole point of putting it here
  rather than in a template.

  ===========================================================================
  OFF BY DEFAULT
  ===========================================================================
  `active` is 0. A payment method that takes real money must never switch itself
  on at install: until a merchant has entered THEIR transfer number, an enabled
  InstaPay would show shoppers a blank number and collect receipts for a
  transfer nobody received.

  ===========================================================================
  ORDER STATE
  ===========================================================================
  `order_status` is `pending_payment`, and it is now a state the order passes
  THROUGH rather than one it sits in.

  The order used to be created when the shopper left the checkout, and waited in
  pending_payment while they were in their banking app. That is reversed: the
  order is created by Controller\Transfer\Save at the moment the receipt is
  uploaded, and that same request moves it to `new` — received, awaiting review.
  Opening the transfer page and leaving it now creates nothing at all, which is
  why the sales grid stopped filling with orders nobody placed and cancellations
  nobody asked for.

  The value is kept rather than changed to `new` outright, because it is still
  the correct status for the gap between "order created" and "receipt attached",
  and it is the status any order left behind by a failure between those two
  steps will carry — which is exactly the state a merchant wants to be able to
  find and chase.

  It is invoiced when a human approves the receipt.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <spartrak_instapay>
                <active>0</active>
                <model>SpartrakInstaPayFacade</model>
                <title>InstaPay</title>
                <order_status>pending_payment</order_status>
                <payment_action>order</payment_action>
                <allowspecific>0</allowspecific>
                <sort_order>30</sort_order>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <is_gateway>0</is_gateway>
                <is_offline>1</is_offline>

                <!--
                  Empty on purpose. These are the merchant's own banking
                  details; a placeholder here would be a number some shopper
                  eventually transfers money to.
                -->
                <merchant_number/>
                <merchant_name/>
            </spartrak_instapay>
        </payment>
    </default>
</config>
