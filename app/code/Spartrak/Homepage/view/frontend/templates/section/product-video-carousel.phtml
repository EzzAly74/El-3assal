<?php
/**
 * Spartrak Homepage — "شاهد المنتج، وأحكم بنفسك" (Figma 595:14821).
 *
 * Same block, same provider, same dashboard fields and the same shared
 * Card - Product as the plain rails — this file differs only in layout. Each
 * item is a tall media frame (Figma 595:14831: gradient-to-black footer,
 * backdrop-blurred 48px control buttons, timecode and handle) with the
 * product's own compact card underneath (595:14852).
 *
 * ===========================================================================
 * THE VIDEO IS A FACADE, AND THAT IS DELIBERATE
 * ===========================================================================
 * Magento stores product video as an `external-video` media-gallery entry —
 * a YouTube/Vimeo URL. Embedding three third-party iframes on the homepage
 * would put ~1MB of third-party JS in front of the page's own LCP, which
 * CLAUDE.md section 4 forbids outright ("third-party scripts/tags loading
 * before it").
 *
 * So the card paints the product's real image and the real play control, and
 * the iframe is created on the FIRST CLICK. Nothing third-party is requested
 * until a shopper actually asks for a video. This is the standard facade
 * pattern, not a mock: the control is wired to a real video URL from real
 * Magento data, or it is not rendered at all.
 *
 * ===========================================================================
 * TWO HONEST GAPS, NOT PAPERED OVER
 * ===========================================================================
 *  1. TIMECODE. Figma shows "00:00 / 05.40". NOT RENDERED, and it cannot
 *     honestly be: Magento's media gallery stores no duration for an external
 *     video, and neither the total nor the elapsed time is readable from a
 *     cross-origin iframe without loading that provider's player API — the
 *     third-party weight this whole section is built to keep off the homepage.
 *     An earlier version emitted an empty `<p data-video-time>` and claimed
 *     the player would fill it; nothing ever did, so it was dead DOM on every
 *     card. Printing a fabricated runtime instead was never an option, so the
 *     slot is gone rather than empty.
 *  2. HANDLE. Figma shows "@العسال لقطع غيار الجرارات والمحركات". That is the
 *     video's own title in Magento's gallery (`video_title`) when the admin
 *     set one; there is no separate channel-handle field to invent, and no
 *     hardcoded fallback string is emitted.
 *
 * @var \Spartrak\Homepage\Block\Section\ProductCarousel $block
 */

$products = $block->getProducts();
$isCarousel = $block->isCarousel();
$hasTitle = $block->getTitle() !== '';

/*
 * Widget wiring is built rather than hardcoded so each widget is requested
 * ONLY when this section actually needs it:
 *   - the carousel widget only when there is more than one item to page
 *     between (a one-item showcase downloads no carousel code at all);
 *   - the video widget only when at least one product really has a video in
 *     its Magento media gallery. A rail of products with no video ships no
 *     video JS.
 */
$mageInit = [];

if ($isCarousel) {
    $mageInit['spartrakHomeCarousel'] = ['mode' => 'rail'];
}

$hasAnyVideo = false;
foreach ($products as $product) {
    if ($block->getVideo($product) !== null) {
        $hasAnyVideo = true;
        break;
    }
}

if ($hasAnyVideo) {
    $mageInit['spartrakHomeVideo'] = new stdClass();
}
?>
<section class="spartrak-home-section spartrak-home-showcase"
    <?php if ($hasTitle) : ?>aria-labelledby="<?= $block->escapeHtmlAttr($block->getHeadingId()) ?>"<?php endif; ?>
    <?php if ($mageInit) : ?>data-mage-init='<?= /* @noEscape */ json_encode($mageInit, JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES) ?>'<?php endif; ?>>

    <?= /* @noEscape */ $block->getHeadHtml() ?>

    <ul class="spartrak-home-showcase__track" data-carousel-track>
        <?php foreach ($products as $index => $product) : ?>
            <?php
            $media = $block->getMediaImage($product);
            $video = $block->getVideo($product);
            ?>
            <li class="spartrak-home-showcase__item" data-carousel-slide>
                <?php /*
                  THE URL AS MAGENTO STORED IT, and nothing derived from it.

                  A product video is an `external-video` media-gallery entry, so
                  `video_url` is the whole of what Magento knows. Which provider
                  it belongs to, and what its id is, is answered by
                  js/spartrak-video-source - the ONE place on the storefront
                  that turns a URL into a provider id, shared with the PDP
                  gallery mixin so the two surfaces cannot disagree. Resolving
                  it here as well would be the same logic in two layers.

                  The security boundary is in that module: the id is matched
                  against a strict character class and the embed address is
                  composed from a hardcoded prefix, so no merchant-supplied
                  string reaches an iframe `src`. A URL it does not recognise
                  gets no play button rather than a broken one.
                */ ?>
                <div class="spartrak-home-showcase__media"
                    <?php if ($video) : ?>
                        data-video-url="<?= $block->escapeUrl($video['url']) ?>"
                        data-video-title="<?= $block->escapeHtmlAttr($video['title']) ?>"
                    <?php endif; ?>>

                    <?php /*
                      THE VIDEO'S POSTER, not the product photograph - this
                      frame IS the video (it carries the play, mute and caption
                      controls), and the product's own image is on the card
                      below. See Block\Section\ProductCarousel::getMediaImage().

                      The alt follows the subject: the video's admin title when
                      it has one, because that is what this image now depicts.
                      A product with no video falls back to its own image and
                      its own name, which is what the frame is showing then.

                      NO width / height. This <img> is `position: absolute;
                      inset: 0; width: 100%; height: 100%`, so intrinsic
                      attributes on it are inert - the space is reserved by
                      .spartrak-home-showcase__media's `aspect-ratio: 533/692`,
                      which is exact and is what actually prevents the layout
                      shift. They used to be emitted as the image PRESET's
                      650x650, which for an unpadded 16:9 poster is not the
                      file's size at all.
                    */ ?>
                    <?php if ($media) : ?>
                        <img class="spartrak-home-showcase__poster"
                             src="<?= $block->escapeUrl($media['url']) ?>"
                             <?php /*
                               The frame is 533px on desktop and ~204px on a
                               phone, so `sizes` says exactly that and lets the
                               browser pick from the WebP set the resizer
                               derived (Block\Section\ProductCarousel::
                               getMediaImage, which records why the preset's PNG
                               could not ship as-is). `w` descriptors and not
                               1x/2x: the box changes SIZE between breakpoints,
                               not just density, so DPR alone cannot choose.

                               Emitted only when there IS a set - a resizer that
                               could not write its cache returns '' and the
                               preset's own URL stays in `src`, which still
                               renders.
                             */ ?>
                             <?php if ($media['srcset'] !== '') : ?>
                             srcset="<?= $block->escapeHtmlAttr($media['srcset']) ?>"
                             sizes="(max-width: 767px) 204px, 533px"
                             <?php endif; ?>
                             alt="<?= $block->escapeHtmlAttr(
                                 $video && $video['title'] !== ''
                                     ? $video['title']
                                     : $product->getName()
                             ) ?>"
                             loading="lazy"
                             decoding="async">
                    <?php endif; ?>

                    <?php /*
                      The overlay is a dark gradient carrying the controls, the
                      timecode and the handle. With no video there is none of
                      that, and it rendered as an empty black band across every
                      card — reported as corruption, correctly. It is now only
                      emitted when it has something to hold.
                    */ ?>
                    <?php if ($video) : ?>
                    <div class="spartrak-home-showcase__overlay">
                        <div class="spartrak-home-showcase__controls">
                            <button type="button"
                                    class="spartrak-home-showcase__control spartrak-home-showcase__control--play"
                                    data-video-play
                                    aria-label="<?= $block->escapeHtmlAttr(__('Play video')) ?>"></button>
                            <button type="button"
                                    class="spartrak-home-showcase__control spartrak-home-showcase__control--mute"
                                    data-video-mute
                                    aria-pressed="true"
                                    aria-label="<?= $block->escapeHtmlAttr(__('Unmute')) ?>"></button>
                            <button type="button"
                                    class="spartrak-home-showcase__control spartrak-home-showcase__control--captions"
                                    data-video-captions
                                    aria-pressed="false"
                                    aria-label="<?= $block->escapeHtmlAttr(__('Captions')) ?>"></button>
                        </div>

                        <div class="spartrak-home-showcase__meta">
                            <?php if ($video['title'] !== '') : ?>
                                <p class="spartrak-home-showcase__handle">
                                    <?= $block->escapeHtml($video['title']) ?>
                                </p>
                            <?php endif; ?>
                        </div>
                    </div>
                    <?php endif; ?>
                </div>

                <div class="spartrak-home-showcase__product">
                    <?= /* @noEscape */ $block->renderCard($product, $block->getCardIndex((int) $index), 'horizontal') ?>
                </div>
            </li>
        <?php endforeach; ?>
    </ul>

    <?php /*
          Scroll indicator. ONE shared component across every carousel on this
          page - same markup, same [data-carousel-progress] hook the widget
          binds to, same styling. Rendered only when there is more than one
          item, so it is never a bar stuck at 100%.
        */ ?>
        <?php if ($isCarousel) : ?>
        <div class="spartrak-home-progress" aria-hidden="true">
                <span class="spartrak-home-progress__bar" data-carousel-progress></span>
            </div>
    <?php endif; ?>
</section>
