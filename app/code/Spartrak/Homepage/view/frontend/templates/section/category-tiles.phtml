<?php
/**
 * Spartrak Homepage — "الفئات الأكثر بحثا" (Figma 595:15067).
 *
 * A navy stage carrying a blueprint backdrop, a large per-category visual and
 * the category's name at 70px, with a rail of category cards scrolling across
 * the front. Scrolling the rail — or focusing a card — reveals that
 * category's visual.
 *
 * ===========================================================================
 * WHAT COMES FROM WHERE (the brief's rule for THIS section, exactly)
 * ===========================================================================
 *   dashboard -> which categories, their order, the section title
 *   Magento   -> each category's name, URL, blurb AND artwork. Both the tile
 *                photo and the big reveal visual come from the category's own
 *                image (Catalog > Categories > Content), so picking the
 *                category is the single act that chooses the destination and
 *                the picture. There is deliberately no image field on the
 *                dashboard row. See ViewModel\CategoryTiles for the history.
 *   theme     -> the boxes those images are drawn into, and nothing else.
 *
 * ===========================================================================
 * WHY EVERY <img> HERE CARRIES srcset, sizes AND DIMENSIONS
 * ===========================================================================
 * Magento does not resize category images — `Category::getImageUrl()` returns
 * the raw upload — so this section was serving three 1249x848, 782 KB PNGs
 * into boxes of 788x535 and 308x206, six times over: 2.3 MB, half the
 * homepage's entire weight, and 2,532 KiB of Lighthouse's image-delivery
 * saving. Model\Image\Resizer now derives the sizes actually drawn; the
 * 788x535 WebP measures 31,766 bytes against the source's 781,589. The
 * width/height attributes are the same fix seen from the CLS side.
 *
 * ===========================================================================
 * THE REVEAL: WHY IT CANNOT SHIFT LAYOUT OR JANK
 * ===========================================================================
 * Every visual is rendered ONCE, up front, absolutely positioned in the same
 * stage box and stacked. Switching category changes ONE attribute on the
 * stage; CSS crossfades via `opacity` and a small `translate`, both of which
 * the compositor animates off the main thread. Consequences:
 *
 *   - no element enters or leaves the flow, so CLS is structurally zero
 *     rather than merely small;
 *   - no DOM node is created, moved or destroyed while scrolling, so there is
 *     nothing to trigger layout or paint;
 *   - the JS does not animate anything — it only reports which card is
 *     centred, throttled through IntersectionObserver rather than a scroll
 *     handler, so no work happens per scroll event.
 *
 * The first visual is already correct in the server-rendered HTML, so the
 * section is right before any JS runs, and `prefers-reduced-motion` turns the
 * crossfade into a plain swap in CSS.
 *
 * @var \Spartrak\Homepage\Block\Section\CategoryTiles $block
 */

$tiles = $block->getTiles();
$initial = $block->getInitialTile();
$hasVisuals = $block->hasVisuals();
$hasTitle = $block->getTitle() !== '';
?>
<section class="spartrak-home-section spartrak-home-tiles"
    <?php if ($hasTitle) : ?>aria-labelledby="<?= $block->escapeHtmlAttr($block->getHeadingId()) ?>"<?php endif; ?>>

    <?= /* @noEscape */ $block->getHeadHtml() ?>

    <div class="spartrak-home-tiles__stage"
         data-active-index="0"
         <?php if (count($tiles) > 1) : ?>
             <?php /*
               TWO widgets on one element, and both are needed:
                 spartrakHomeCarousel drives the prev/next buttons below (they
                 use the same data-carousel-* contract as every other rail on
                 the page, so they get the same implementation);
                 spartrakHomeTiles watches which card is centred and reveals
                 the matching visual.
               Neither is requested at all when there is only one tile —
               there is then nothing to page between and nothing to reveal.
             */ ?>
             data-mage-init='{"spartrakHomeCarousel":{"mode":"rail"},"spartrakHomeTiles":{}}'
         <?php endif; ?>>

        <?php /*
          The stage's BACKDROP is full-bleed (Figma 595:15074 reaches both
          frame edges) but its CONTENT is not — the rail, the name and the
          artwork all sit inside the page's content measure. This wrapper is
          what separates the two: the stage stays edge-to-edge, everything
          positioned against this stays on the measure however wide the
          viewport gets.
        */ ?>
        <div class="spartrak-home-tiles__inner">

        <?php /* Figma 595:15076 — the small dark eyebrow chip over the stage. */ ?>
        <span class="spartrak-home-tiles__eyebrow"><?= $block->escapeHtml(__('ElAssal categories')) ?></span>

        <?php if ($hasVisuals) : ?>
            <div class="spartrak-home-tiles__visuals" aria-hidden="true">
                <?php foreach ($tiles as $index => $tile) : ?>
                    <?php $visual = $tile['visual']; ?>
                    <?php if ($visual['url'] === '') : ?>
                        <?php continue; ?>
                    <?php endif; ?>
                    <img class="spartrak-home-tiles__visual"
                         data-visual-index="<?= (int) $index ?>"
                         <?php /*
                           THE FIRST VISUAL SHIPS ACTIVE — NEW2B-5634.

                           Without this the stage loaded with NO artwork at all.
                           The comment above says the stage is "server-rendered
                           with the FIRST category's name so the stage is
                           correct before JS", and the NAME was; the artwork
                           was not, because `data-active` is what
                           _homepage-sections.less reveals a visual with and
                           nothing emitted it.

                           JS could not recover it either: js/spartrak-home-
                           tiles.js opens with activeIndex = 0 and _activate()
                           returns early when the index it is given equals the
                           one it already holds, so the very first card is the
                           one index the widget can never activate. Measured on
                           the live homepage before this change — five cards,
                           three visuals, and `[data-visual-index][data-active]`
                           matched nothing until the rail was scrolled.

                           `$index === 0` and not "the first one rendered": the
                           attribute means "this is the visual for the active
                           card", the stage declares `data-active-index="0"`
                           just above, and the loop SKIPS categories with no
                           image. So when the first category is one of those,
                           nothing is marked and the stage correctly shows no
                           artwork rather than another category's.
                         */ ?>
                         <?php if ($index === 0) : ?>data-active<?php endif; ?>
                         src="<?= $block->escapeUrl($visual['url']) ?>"
                         <?php /*
                           `w` descriptors, not 1x/2x: this box is 788x535 on
                           desktop and 100vw x 220 on a phone, so the device
                           pixel ratio alone cannot pick the right file. With
                           `sizes` below, a 2.6-DPR phone laying the stage out
                           at ~400 CSS px asks for ~1040 device px and gets the
                           1200 candidate, while the same phone in a desktop
                           layout would ask for the 788.
                         */ ?>
                         <?php if ($visual['srcset'] !== '') : ?>
                         srcset="<?= $block->escapeHtmlAttr($visual['srcset']) ?>"
                         sizes="(max-width: 767px) 100vw, 788px"
                         <?php endif; ?>
                         <?php if ($visual['width'] !== null) : ?>
                         width="<?= (int) $visual['width'] ?>"
                         height="<?= (int) $visual['height'] ?>"
                         <?php endif; ?>
                         alt=""
                         <?php /*
                           EVERY visual is lazy, including the first — and the
                           reason is the phone, not the desktop.

                           Figma's mobile frame (647:57295) has no product
                           artwork on the stage at all, so
                           components/_homepage-sections.less hides
                           `.spartrak-home-tiles__visuals` below 768px. A
                           `display: none` <img> with a `src` is STILL FETCHED
                           — so `eager` here meant every phone downloading a
                           788x535 photograph it will never see, on the page
                           whose weight matters most (CLAUDE.md sections 4 and
                           11). `lazy` is what closes that: a lazy image inside
                           a `display: none` subtree can never approach the
                           viewport, so the browser never requests it.

                           It costs the desktop nothing measurable. This
                           section sits below the hero, and the hero banner is
                           the page's LCP element (see section/banner.phtml) —
                           so the first visual was never the image the metric
                           was waiting on. A lazy image that IS near the
                           viewport is still fetched at normal priority; the
                           only difference is that it is discovered at layout
                           rather than by the preload scanner, which is the
                           correct trade for something below the fold.

                           The rest were already lazy and are also
                           off-screen-by-opacity, so nothing changes for them.
                         */ ?>
                         loading="lazy"
                         decoding="async">
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <?php /*
          The 70px category name (Figma 595:15088). Server-rendered with the
          FIRST category's name so the stage is correct before JS; the widget
          swaps only this node's text when the active card changes.
        */ ?>
        <p class="spartrak-home-tiles__name" data-tiles-name aria-live="off">
            <?= $block->escapeHtml($initial['name'] ?? '') ?>
        </p>

        <div class="spartrak-home-tiles__rail-wrap">
            <ul class="spartrak-home-tiles__rail" data-carousel-track>
                <?php foreach ($tiles as $index => $tile) : ?>
                    <li class="spartrak-home-tiles__item" data-carousel-slide data-index="<?= (int) $index ?>">
                        <a class="spartrak-home-tiles__card" href="<?= $block->escapeUrl($tile['url']) ?>">
                            <span class="spartrak-home-tiles__card-media">
                                <?php if ($tile['tile']['url'] !== '') : ?>
                                    <?php /*
                                      The card's image box is a fixed 308x206
                                      at every breakpoint, so `sizes` is a
                                      constant and the only choice left to the
                                      browser is the device pixel ratio.
                                    */ ?>
                                    <img class="spartrak-home-tiles__card-image"
                                         src="<?= $block->escapeUrl($tile['tile']['url']) ?>"
                                         <?php if ($tile['tile']['srcset'] !== '') : ?>
                                         srcset="<?= $block->escapeHtmlAttr($tile['tile']['srcset']) ?>"
                                         sizes="308px"
                                         <?php endif; ?>
                                         <?php if ($tile['tile']['width'] !== null) : ?>
                                         width="<?= (int) $tile['tile']['width'] ?>"
                                         height="<?= (int) $tile['tile']['height'] ?>"
                                         <?php endif; ?>
                                         alt=""
                                         loading="lazy"
                                         decoding="async">
                                <?php endif; ?>
                            </span>
                            <span class="spartrak-home-tiles__card-body">
                                <span class="spartrak-home-tiles__card-name">
                                    <?= $block->escapeHtml($tile['name']) ?>
                                </span>
                                <?php if ($tile['description'] !== '') : ?>
                                    <span class="spartrak-home-tiles__card-desc">
                                        <?= $block->escapeHtml($tile['description']) ?>
                                    </span>
                                <?php endif; ?>
                                <span class="spartrak-home-tiles__card-cta">
                                    <?= $block->escapeHtml(__('Browse all')) ?>
                                </span>
                            </span>
                        </a>
                    </li>
                <?php endforeach; ?>
            </ul>

            <?php if (count($tiles) > 1) : ?>
                <div class="spartrak-home-tiles__nav">
                    <button type="button"
                            class="spartrak-home-tiles__nav-button spartrak-home-tiles__nav-button--prev"
                            data-carousel-prev
                            aria-label="<?= $block->escapeHtmlAttr(__('Previous')) ?>"></button>
                    <button type="button"
                            class="spartrak-home-tiles__nav-button spartrak-home-tiles__nav-button--next"
                            data-carousel-next
                            aria-label="<?= $block->escapeHtmlAttr(__('Next')) ?>"></button>
                </div>
            <?php endif; ?>
        </div>

        <?php /*
          NO SCROLL INDICATOR HERE. Every other carousel on this page carries
          the shared .spartrak-home-progress bar; this one does not, because
          Figma does not draw one for it. The tiles rail sits inside the
          reveal stage (704:27343), which already signals its own scroll
          position through the backdrop image and the category name changing
          as the rail moves - a progress bar underneath it was an addition,
          not an implementation.
        */ ?>
        </div>
    </div>
</section>
