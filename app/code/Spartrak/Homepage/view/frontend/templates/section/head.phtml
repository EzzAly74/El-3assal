<?php
/**
 * Spartrak Homepage — the shared section header.
 *
 * Figma nodes 595:15068 / 595:15117 / 595:14587 / 595:14822 are the same
 * component: a 32px bold title on the inline-END side and, on the inline-
 * START side, either a "مشاهدة الكل" link (title 18px, --color-action-primary,
 * with a 24px circular arrow chip) or the carousel's own prev/next buttons.
 *
 * ===========================================================================
 * WHY THERE ARE NO left/right RULES ANYWHERE IN THIS COMPONENT
 * ===========================================================================
 * The markup order is [view-all] then [title], and the flexbox does the rest
 * with `justify-content: space-between`. Under `dir="rtl"` — the primary
 * storefront — the title lands on the right and the link on the left, exactly
 * as Figma composes it; under an English store view the whole row mirrors
 * itself with no second stylesheet and no RTL override. The arrow glyph is
 * flipped by a logical `scaleX` bound to the writing direction, not by a
 * separate asset.
 *
 * Rendered through AbstractSection::getHeadHtml(), so `$block` is the SECTION
 * block itself, not a wrapper — see that method for why.
 *
 * @var \Spartrak\Homepage\Block\Section\AbstractSection $block
 */

$title = $block->getTitle();
$viewAllUrl = $block->getViewAllUrl();
$showsNav = $block->showsCarouselNav();
?>
<div class="spartrak-home-section__head">
    <?php /*
      DOM ORDER IS THE LAYOUT. The row is `justify-content: space-between`, so
      the FIRST child lands on the inline-start edge — the RIGHT in Arabic.
      Figma puts the section title on the right and the "view all" link and
      carousel arrows on the left (headers 595:14822, 595:15117, 595:14587,
      695:46255 all place the title at the far x and the controls at x=0), so
      the TITLE MUST COME FIRST here.

      Having these the other way round mirrored every section header on the
      site. There is no CSS fix for it — swapping sides with `order` or
      physical properties would break the LTR store instead, because the whole
      point of this order is that it mirrors correctly on its own.
    */ ?>
    <?php if ($title !== '') : ?>
        <h2 class="spartrak-home-section__title" id="<?= $block->escapeHtmlAttr($block->getHeadingId()) ?>">
            <?= $block->escapeHtml($title) ?>
        </h2>
    <?php else : ?>
        <?php /* Keeps the controls on their Figma side when there is no title. */ ?>
        <span class="spartrak-home-section__head-spacer" aria-hidden="true"></span>
    <?php endif; ?>

    <?php if ($showsNav || $viewAllUrl !== '') : ?>
        <div class="spartrak-home-section__head-lead">
            <?php if ($showsNav) : ?>
                <div class="spartrak-home-section__nav">
                    <button type="button"
                            class="spartrak-home-section__nav-button spartrak-home-section__nav-button--prev"
                            data-carousel-prev
                            aria-label="<?= $block->escapeHtmlAttr(__('Previous')) ?>"></button>
                    <button type="button"
                            class="spartrak-home-section__nav-button spartrak-home-section__nav-button--next"
                            data-carousel-next
                            aria-label="<?= $block->escapeHtmlAttr(__('Next')) ?>"></button>
                </div>
            <?php endif; ?>

            <?php if ($viewAllUrl !== '') : ?>
                <?php /*
                  TWO LABELS, ONE LINK. Figma writes this control out twice:
                  "مشاهدة الكل" on desktop (595:15072, 18px) and just "الكل" on
                  mobile (647:57916 / 647:57342 / 647:57309, 14px). Both are
                  emitted and CSS picks one per viewport.

                  WHY NOT ONE STRING TRIMMED IN CSS, OR SWAPPED IN JS. This
                  block is full-page cached and cannot branch on device (the
                  same constraint the utility strip records), so the choice has
                  to be a stylesheet's. Two <span>s cost ~30 bytes of HTML and
                  no request, no script and no second cache entry; a JS swap
                  would cost a script on the critical path to change four words
                  (CLAUDE.md section 13).

                  THE ACCESSIBLE NAME STAYS THE LONG ONE, in both viewports, so
                  a screen-reader user is never handed a link called only "All"
                  with no idea all of WHAT. WCAG 2.5.3 (Label in Name) is
                  satisfied because the visible mobile label is a substring of
                  it — "الكل" is inside "مشاهدة الكل", and "All" inside
                  "View all".
                */ ?>
                <a class="spartrak-home-section__view-all"
                   href="<?= $block->escapeUrl($viewAllUrl) ?>"
                   aria-label="<?= $block->escapeHtmlAttr(__('View all')) ?>">
                    <span class="spartrak-home-section__view-all-arrow" aria-hidden="true"></span>
                    <span class="spartrak-home-section__view-all-text"><?= $block->escapeHtml(__('View all')) ?></span>
                    <span class="spartrak-home-section__view-all-text spartrak-home-section__view-all-text--short"><?= $block->escapeHtml(__('All')) ?></span>
                </a>
            <?php endif; ?>
        </div>
    <?php endif; ?>
</div>
