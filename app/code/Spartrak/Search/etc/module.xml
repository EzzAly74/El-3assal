<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Spartrak_Search" setup_version="1.0.0">
        <sequence>
            <!--
              Magento_CatalogSearch owns the fulltext product collection this
              module's SuggestionProvider builds on, and Magento_Search owns
              AutocompleteInterface and the query-length limits. Both must be
              loaded first.
            -->
            <module name="Magento_Search"/>
            <module name="Magento_CatalogSearch"/>
            <module name="Magento_Catalog"/>
            <!--
              Magento_Theme owns Html\Block\Breadcrumbs, which this module
              plugs into to drop the "Search results for" crumb — see
              Plugin/Block/Html/RemoveSearchCrumb.php.
            -->
            <module name="Magento_Theme"/>
        </sequence>
    </module>
</config>
