<?xml version="1.0"?>
<!--
  Registered in etc/frontend/ rather than etc/, deliberately.

  Magento\Theme\Block\Html\Breadcrumbs is a storefront block, and the crumb
  being suppressed only ever exists on the storefront's search results page.
  Scoping the interceptor to the frontend area keeps it out of the admin and
  the REST/GraphQL areas entirely, so nothing else pays to have it generated
  or evaluated.

  See the plugin class for why this is an interceptor at all rather than
  layout XML, and why it must be `around`.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Theme\Block\Html\Breadcrumbs">
        <plugin name="spartrak_search_remove_search_crumb"
                type="Spartrak\Search\Plugin\Block\Html\RemoveSearchCrumb"
                sortOrder="10"/>
    </type>

    <!--
      THE SEARCH RESULTS CONTROLLER — REGISTERED TWICE, ON PURPOSE.

      `catalogsearch/result/index` is not served by core's controller on this
      install. Mageplaza_AjaxLayer/etc/frontend/di.xml holds the preference:

          <preference for="Magento\CatalogSearch\Controller\Result\Index"
                      type="Mageplaza\AjaxLayer\Controller\Search\Result\Index"/>

      and that class extends Magento\Framework\App\Action\Action, NOT the core
      controller. Magento inherits plugins down a class hierarchy, but there is
      no hierarchy between those two, so a plugin registered on the core type
      alone is attached to a class the storefront never instantiates. It does
      not fail, it does not warn, and no amount of setup:di:compile brings it
      to life — it is simply on the wrong class. That cost this project two
      deploys; the symptom was the results page still bouncing an empty query
      back onto the previous term while every other plugin in this file worked.

      (Smartwave/porto declares the same preference in its GLOBAL etc/di.xml.
      Mageplaza's is area-specific and an area preference wins on the frontend,
      so Mageplaza's is the class actually in force today.)

      BOTH are registered so this is the storefront's behaviour rather than one
      extension's: whichever of the two is in force, the plugin is on it. A
      DISABLED Mageplaza_AjaxLayer needs no change here — its class still
      exists on disk, so the registration compiles, and core's controller takes
      over. Only physically REMOVING that module would require dropping the
      second block, since setup:di:compile reflects every type it is given. The
      plugin hints ActionInterface — the one type both controllers share — so
      that either one can be the subject.

      Frontend-only, like the crumb above: the results controller exists on the
      storefront alone, so neither the admin nor the API areas pay to have this
      interceptor generated.

      See the plugin class for why an empty query bounced back onto the previous
      search term, why the AJAX layer turned that bounce into
      ERR_TOO_MANY_REDIRECTS, and why an XHR is answered with JSON.
    -->
    <type name="Magento\CatalogSearch\Controller\Result\Index">
        <plugin name="spartrak_search_reset_empty_search"
                type="Spartrak\Search\Plugin\Controller\Result\ResetEmptySearch"
                sortOrder="10"/>
    </type>

    <type name="Mageplaza\AjaxLayer\Controller\Search\Result\Index">
        <plugin name="spartrak_search_reset_empty_search_ajaxlayer"
                type="Spartrak\Search\Plugin\Controller\Result\ResetEmptySearch"
                sortOrder="10"/>
    </type>
</config>
