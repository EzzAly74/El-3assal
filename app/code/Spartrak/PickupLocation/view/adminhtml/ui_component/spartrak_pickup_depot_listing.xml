<?xml version="1.0"?>
<!--
  The depot grid.

  Carries an OPERATOR column that the branch grid has no equivalent of - the
  one field that most distinguishes the two entities, and the reason they are
  separate tables rather than one with a discriminator (see db_schema.xml).
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">spartrak_pickup_depot_listing.spartrak_pickup_depot_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>spartrak_pickup_depot_columns</spinner>
        <deps>
            <dep>spartrak_pickup_depot_listing.spartrak_pickup_depot_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Depot</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="spartrak_pickup_depot_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">depot_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Spartrak_PickupLocation::depot</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="spartrak_pickup_depot_listing_data_source">
            <settings>
                <requestFieldName>depot_id</requestFieldName>
                <primaryFieldName>depot_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="spartrak_pickup_depot_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">spartrak_pickup_depot_listing.spartrak_pickup_depot_listing.spartrak_pickup_depot_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>

        <column name="depot_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="sort_order" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Position</label>
            </settings>
        </column>

        <column name="name_ar" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Name (Arabic)</label>
            </settings>
        </column>

        <column name="name_en" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Name (English)</label>
            </settings>
        </column>

        <column name="address_ar" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Address (Arabic)</label>
            </settings>
        </column>

        <column name="region_id" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Spartrak\PickupLocation\Model\Source\GovernorateOptions"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Governorate</label>
            </settings>
        </column>

        <column name="operator_id" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="Spartrak\PickupLocation\Model\Source\OperatorOptions"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Operator</label>
            </settings>
        </column>

        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Enabledisable"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <actionsColumn name="actions" class="Spartrak\PickupLocation\Ui\Component\Listing\Column\DepotActions" sortOrder="90">
            <settings>
                <indexField>depot_id</indexField>
                <resizeEnabled>false</resizeEnabled>
            </settings>
        </actionsColumn>
    </columns>
</listing>
