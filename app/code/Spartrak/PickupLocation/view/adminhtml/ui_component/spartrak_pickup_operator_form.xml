<?xml version="1.0"?>
<!--
  The transport-operator form.

  `code` is a stable identifier rather than a label - unique by schema, and the
  value the storefront filter round-trips. The Save controller restricts it to
  lowercase letters, numbers and underscores so it stays safe in a URL and in a
  CSS hook, and so a database integrity error becomes a sentence an admin can
  act on.
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">spartrak_pickup_operator_form.spartrak_pickup_operator_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Transport Operator</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="Magento\Backend\Block\Widget\Button\GenericButton">
                <label translate="true">Back</label>
            </button>
            <button name="save" class="Magento\Backend\Block\Widget\Button\GenericButton">
                <label translate="true">Save Operator</label>
            </button>
        </buttons>
        <namespace>spartrak_pickup_operator_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>spartrak_pickup_operator_form.spartrak_pickup_operator_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="spartrak_pickup_operator_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="spartrak_pickup/operator/save"/>
        </settings>
        <dataProvider class="Spartrak\PickupLocation\Model\Operator\DataProvider" name="spartrak_pickup_operator_form_data_source">
            <settings>
                <requestFieldName>operator_id</requestFieldName>
                <primaryFieldName>operator_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Operator Details</label>
        </settings>

        <field name="operator_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>

        <field name="code" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Code</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <notice translate="true">Lowercase letters, numbers and underscores only. Used by the storefront filter, not shown to shoppers.</notice>
            </settings>
        </field>

        <field name="name_ar" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name (Arabic)</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="name_en" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name (English)</label>
                <notice translate="true">Optional. Arabic is used on English store views when this is empty.</notice>
            </settings>
        </field>

        <field name="sort_order" formElement="input" sortOrder="40">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Chip Order</label>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="is_active" formElement="checkbox" sortOrder="50">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
                <notice translate="true">Disabling hides the chip at checkout. Depots assigned to this operator stay available.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
