<?xml version="1.0"?>
<!--
  The branch form.

  Arabic fields are required, English ones optional - see
  Controller\Adminhtml\Branch\Save for why that asymmetry is deliberate rather
  than an oversight: Spartrak\Locale\Model\StoreLanguage falls back to the
  Arabic value when an English one is missing, but has nothing to fall back to
  in the other direction.
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">spartrak_pickup_branch_form.spartrak_pickup_branch_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Branch</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="Magento\Backend\Block\Widget\Button\GenericButton">
                <label translate="true">Back</label>
            </button>
            <button name="save" class="Magento\Backend\Block\Widget\Button\GenericButton">
                <label translate="true">Save Branch</label>
            </button>
        </buttons>
        <namespace>spartrak_pickup_branch_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>spartrak_pickup_branch_form.spartrak_pickup_branch_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="spartrak_pickup_branch_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="spartrak_pickup/branch/save"/>
        </settings>
        <dataProvider class="Spartrak\PickupLocation\Model\Branch\DataProvider" name="spartrak_pickup_branch_form_data_source">
            <settings>
                <requestFieldName>branch_id</requestFieldName>
                <primaryFieldName>branch_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Branch Details</label>
        </settings>

        <field name="branch_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>

        <field name="name_ar" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name (Arabic)</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="name_en" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name (English)</label>
                <notice translate="true">Optional. Arabic is used on English store views when this is empty.</notice>
            </settings>
        </field>

        <field name="address_ar" formElement="textarea" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Address (Arabic)</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="address_en" formElement="textarea" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Address (English)</label>
            </settings>
        </field>

        <field name="region_id" formElement="select" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Spartrak\PickupLocation\Model\Source\GovernorateOptions</item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Governorate</label>
                <notice translate="true">Used as the city on the order address when a shopper collects from here.</notice>
            </settings>
        </field>

        <field name="phone" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Phone</label>
            </settings>
        </field>

        <field name="sort_order" formElement="input" sortOrder="70">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Position</label>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
                <notice translate="true">Lower numbers appear first in the checkout list.</notice>
            </settings>
        </field>

        <field name="is_active" formElement="checkbox" sortOrder="80">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
