<?php
/**
 * Copyright © ElAssal for Trading & Supply. All rights reserved.
 *
 * "Station consignment" — where the dispatcher records the driver and vehicle
 * that BUSINESS.md section 12, §4 requires before an order may be marked
 * `شحنتك في الطريق اليك`.
 *
 * The section renders nothing for a home delivery or a branch collection, so
 * the layout attaches it unconditionally.
 *
 * A plain multipart form using Magento's own admin form classes rather than a
 * UI component: it is seven controls on an existing page with one submit, and a
 * ui_component would mean a form declaration, a data provider and a modal for
 * the same result. See Controller\Adminhtml\Consignment\Save for why it is a
 * form of its own and not part of the status dropdown.
 *
 * Six of the seven are the driver, the vehicle and the journey. The seventh is
 * `الي الموقف`, which is the customer's own choice and used to be display-only
 * — see the note above that field for why it had to become settable, and
 * Model\OrderDestination for how it stays an override rather than a rewrite.
 *
 * @var \Spartrak\PickupLocation\Block\Adminhtml\Order\View\Consignment $block
 * @var \Magento\Framework\Escaper $escaper
 */

if (!$block->isApplicable()) {
    return;
}

$consignment = $block->getConsignment();
$photoUrl = $block->getVehiclePhotoUrl();
$destination = $block->getDestination();
$missing = $block->getMissingFields();
$isReady = $block->isReady();
$isDispatched = $block->isDispatched();
$isPaymentApproved = $block->isPaymentApproved();
$customerChoice = $block->getCustomerChoice();
$isRedirected = $block->isDestinationRedirected();
$destinationReason = $block->getDestinationReason();
$selectedDestinationId = $block->getSelectedDestinationId();
?>
<section class="admin__page-section spartrak-order-consignment">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('Station consignment')) ?></span>
    </div>

    <div class="admin__page-section-content">
        <div class="admin__page-section-item">
            <?php /*
              ===================================================================
              STATE FIRST, FORM SECOND
              ===================================================================
              A dispatcher working a queue of orders needs one question answered
              before anything else: can this one go out? So the panel opens with
              the answer, and when the answer is no it NAMES THE FIELDS.

              What was here was a single fixed sentence — "save the driver and
              vehicle before setting this order to Out for delivery" — shown
              identically whether nothing had been entered or four of the five
              fields were already filled. The dispatcher then discovered which
              one was missing by pressing save on the status dropdown and
              reading an exception. The list below and the gate's own refusal
              read the same Model\ConsignmentRequirements, so they cannot
              disagree.
            */ ?>
            <?php /*
              PAYMENT FIRST, AND IT IS A DIFFERENT KIND OF "NOT YET".
              -----------------------------------------------------------------
              §2 puts the consignment one station AFTER payment acceptance, and
              the form used to be available from the moment the order existed —
              so a dispatcher could name a driver, and publish his phone number
              on the customer's order page, for an order nobody had been paid
              for.

              This is reported before the missing-field checklist because it
              outranks it: there is no point telling somebody which five fields
              to fill in on an order that is not going anywhere yet. The
              fieldset below is `disabled` in this state — native HTML, so the
              values stay readable, nothing can be typed, and the browser does
              not submit a disabled fieldset at all. The server refuses it too;
              see Controller\Adminhtml\Consignment\Save.
            */ ?>
            <?php if (!$isPaymentApproved): ?>
                <div class="message message-warning">
                    <strong><?= $escaper->escapeHtml(
                        __('Waiting for payment approval.')
                    ) ?></strong>
                    <?= $escaper->escapeHtml(
                        __(
                            'Invoice this order first — approve the InstaPay transfer, or invoice it if it is '
                            . 'cash on delivery. The driver and vehicle can be recorded as soon as the payment '
                            . 'is accepted, and not before: these details go straight onto the customer\'s '
                            . 'order page.'
                        )
                    ) ?>
                </div>
            <?php elseif ($isDispatched): ?>
                <div class="message message-success">
                    <?= $escaper->escapeHtml(
                        __('This order is out for delivery. The customer can see these details on their order page.')
                    ) ?>
                </div>
            <?php elseif ($isReady): ?>
                <div class="message message-success">
                    <?= $escaper->escapeHtml(
                        __('Ready to dispatch. You can now set this order to "Out for delivery".')
                    ) ?>
                </div>
            <?php else: ?>
                <div class="message message-warning">
                    <strong><?= $escaper->escapeHtml(
                        __('This order cannot be marked out for delivery yet.')
                    ) ?></strong>
                    <?php if ($missing !== []): ?>
                        <?= $escaper->escapeHtml(__('Still needed:')) ?>
                        <ul>
                            <?php foreach ($missing as $field): ?>
                                <li><?= $escaper->escapeHtml($field) ?></li>
                            <?php endforeach; ?>
                        </ul>
                    <?php endif; ?>
                    <?= $escaper->escapeHtml(
                        __('The customer has no other way to find the vehicle at the station.')
                    ) ?>
                </div>
            <?php endif; ?>

            <?php /*
              THE DESTINATION IS A DATA FAULT WHEN IT IS ABSENT — AND IT NOW
              HAS SOMEWHERE TO BE FIXED.

              `الي الموقف` is normally the shopper's checkout choice. When it is
              missing, this message used to be the end of the story: it told the
              dispatcher to phone the customer and then offered nothing to do
              with the answer, so the same red box stood on the order for ever
              and the customer's order page could never show a destination.
              §9 question 5 settles that — the "To station" field below records
              it, and this message now points at it.

              Dispatch is still deliberately NOT blocked: the parcel has to
              travel and the driver's number is the customer's real lifeline, so
              withholding a whole dispatch over a column this module failed to
              write would punish the customer for our fault. The reasoning is
              recorded in Model\ConsignmentRequirements.
            */ ?>
            <?php if (!$block->hasDestination()): ?>
                <div class="message message-error">
                    <strong><?= $escaper->escapeHtml(__('The destination station is missing from this order.')) ?></strong>
                    <?= $escaper->escapeHtml(
                        __(
                            'This order was placed against the station-pickup carrier, but the station the '
                            . 'customer chose was never saved onto it. Phone the customer, confirm where they '
                            . 'expect to collect, and record it in "To station" below — their order page cannot '
                            . 'show a destination until it is on the order. You can still dispatch without it.'
                        )
                    ) ?>
                </div>
            <?php endif; ?>

            <form action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>"
                  method="post"
                  enctype="multipart/form-data">
                <?= $block->getBlockHtml('formkey') ?>

                <?php /*
                  `disabled` on the FIELDSET, not on each control: one
                  attribute makes every field inside read-only and stops
                  the browser submitting any of them, so the dispatcher can
                  still SEE the destination and whatever has been entered
                  while payment is pending, and cannot change it.
                */ ?>
                <fieldset class="admin__fieldset"<?= $isPaymentApproved ? '' : ' disabled' ?>>
                    <div class="admin__field _required">
                        <label class="admin__field-label" for="spartrak-driver-name">
                            <span><?= $escaper->escapeHtml(__('Driver name')) ?></span>
                        </label>
                        <div class="admin__field-control">
                            <input type="text"
                                   id="spartrak-driver-name"
                                   name="driver_name"
                                   class="admin__control-text"
                                   required
                                   value="<?= $escaper->escapeHtmlAttr($consignment?->getDriverName() ?? '') ?>">
                        </div>
                    </div>

                    <div class="admin__field _required">
                        <label class="admin__field-label" for="spartrak-driver-phone">
                            <span><?= $escaper->escapeHtml(__('Driver phone')) ?></span>
                        </label>
                        <div class="admin__field-control">
                            <input type="text"
                                   id="spartrak-driver-phone"
                                   name="driver_phone"
                                   class="admin__control-text"
                                   required
                                   value="<?= $escaper->escapeHtmlAttr($consignment?->getDriverPhone() ?? '') ?>">
                            <p class="admin__field-note">
                                <?= $escaper->escapeHtml(
                                    __('The customer calls this number to arrange the handover.')
                                ) ?>
                            </p>
                        </div>
                    </div>

                    <div class="admin__field _required">
                        <label class="admin__field-label" for="spartrak-plate-number">
                            <span><?= $escaper->escapeHtml(__('Vehicle plate number')) ?></span>
                        </label>
                        <div class="admin__field-control">
                            <input type="text"
                                   id="spartrak-plate-number"
                                   name="plate_number"
                                   class="admin__control-text"
                                   required
                                   value="<?= $escaper->escapeHtmlAttr($consignment?->getPlateNumber() ?? '') ?>">
                            <p class="admin__field-note">
                                <?= $escaper->escapeHtml(__('As written on the plate, for example م ص ر ١٢٣٤.')) ?>
                            </p>
                        </div>
                    </div>

                    <div class="admin__field _required">
                        <label class="admin__field-label" for="spartrak-origin-station">
                            <span><?= $escaper->escapeHtml(__('From station')) ?></span>
                        </label>
                        <div class="admin__field-control">
                            <input type="text"
                                   id="spartrak-origin-station"
                                   name="origin_station"
                                   class="admin__control-text"
                                   required
                                   value="<?= $escaper->escapeHtmlAttr($consignment?->getOriginStation() ?? '') ?>">
                            <p class="admin__field-note">
                                <?= $escaper->escapeHtml(
                                    __('Where this vehicle is departing from. It depends on the vehicle, so it is entered per order.')
                                ) ?>
                            </p>
                        </div>
                    </div>

                    <?php /*
                      ===============================================================
                      `الي الموقف` — THE WHOLE STATION, AND NOW SETTABLE
                      ===============================================================
                      It was DISPLAY-ONLY, on the rule that "it is already on
                      the order and retyping it is how the two drift apart".
                      That rule was right about retyping and wrong about the
                      consequence: on an order whose checkout snapshot never
                      landed there was nothing to display and no way to supply
                      it, so the one fact the customer needs most — where to go
                      — was unrecoverable. §9 question 5 is the decision that
                      changes it.

                      IT IS A LIST, NOT A TEXT FIELD, and that is what answers
                      the drift objection: the value can only ever be one of the
                      stations the checkout itself offers, so the two sides
                      cannot invent different spellings of one place, and the
                      customer's card gets a real name, street, governorate and
                      operator rather than one typed string.

                      SELECTING NOTHING MEANS "use the customer's choice". The
                      override is only ever written when a station is picked, and
                      picking the customer's own clears it again — see
                      Controller\Adminhtml\Consignment\Save::applyDestination().

                      The station is still shown in FULL above the control:
                      "موقف السلام" alone does not tell a dispatcher which
                      station that is, since several governorates have
                      similarly-named yards and the operator decides which
                      vehicles run there.
                    */ ?>
                    <div class="admin__field">
                        <label class="admin__field-label" for="spartrak-destination">
                            <span><?= $escaper->escapeHtml(__('To station')) ?></span>
                        </label>
                        <div class="admin__field-control">
                            <?php if ($destination['name'] === null): ?>
                                <span class="admin__field-value">
                                    <strong><?= $escaper->escapeHtml(__('Not recorded on this order')) ?></strong>
                                </span>
                            <?php else: ?>
                                <span class="admin__field-value">
                                    <strong><?= $escaper->escapeHtml($destination['name']) ?></strong>
                                </span>
                                <?php if ($destination['address'] !== null): ?>
                                    <p class="admin__field-note">
                                        <?= $escaper->escapeHtml($destination['address']) ?>
                                    </p>
                                <?php endif; ?>
                                <?php if ($destination['region'] !== null): ?>
                                    <p class="admin__field-note">
                                        <?= $escaper->escapeHtml(
                                            __('Governorate: %1', $destination['region'])
                                        ) ?>
                                    </p>
                                <?php endif; ?>
                                <?php if ($destination['operator'] !== null): ?>
                                    <p class="admin__field-note">
                                        <?= $escaper->escapeHtml(
                                            __('Transport operator: %1', $destination['operator'])
                                        ) ?>
                                    </p>
                                <?php endif; ?>
                            <?php endif; ?>

                            <?php /*
                              WHERE THIS VALUE CAME FROM — three different facts,
                              said differently, because they mean different
                              things to whoever reads the order next.
                            */ ?>
                            <?php if ($isRedirected): ?>
                                <p class="admin__field-note">
                                    <strong><?= $escaper->escapeHtml(
                                        __('Redirected. The customer chose %1.', $customerChoice)
                                    ) ?></strong>
                                    <?php if ($destinationReason !== null): ?>
                                        <?= $escaper->escapeHtml(__('Reason: %1', $destinationReason)) ?>
                                    <?php endif; ?>
                                </p>
                            <?php elseif ($customerChoice !== null): ?>
                                <p class="admin__field-note">
                                    <?= $escaper->escapeHtml(__('Chosen by the customer at checkout.')) ?>
                                </p>
                            <?php elseif ($destination['name'] !== null): ?>
                                <p class="admin__field-note">
                                    <?= $escaper->escapeHtml(
                                        __('Recorded here, because the checkout did not save it onto this order.')
                                    ) ?>
                                    <?php if ($destinationReason !== null): ?>
                                        <?= $escaper->escapeHtml(__('Reason: %1', $destinationReason)) ?>
                                    <?php endif; ?>
                                </p>
                            <?php endif; ?>

                            <?php /*
                              A recorded station whose depot has since been
                              disabled or deleted cannot be shown as selected,
                              so without this the panel would look as though
                              nothing had been recorded while the customer's
                              card was printing a station.
                            */ ?>
                            <?php if ($block->isRecordedDestinationUnselectable()): ?>
                                <div class="message message-warning">
                                    <?= $escaper->escapeHtml(
                                        __(
                                            'The station recorded here is no longer in the active list, so it '
                                            . 'cannot be shown as selected below. It is kept on the order until '
                                            . 'you choose another one. Re-enable it under Pickup Locations if it '
                                            . 'is still in service.'
                                        )
                                    ) ?>
                                </div>
                            <?php endif; ?>

                            <select id="spartrak-destination"
                                    name="destination_id"
                                    class="admin__control-select">
                                <option value=""><?= $escaper->escapeHtml(
                                    $customerChoice !== null
                                        ? __('Keep the choice the customer made (%1)', $customerChoice)
                                        : __('Not recorded — choose the station the customer confirms')
                                ) ?></option>
                                <?php foreach ($block->getDestinationOptions() as $option): ?>
                                    <option value="<?= $escaper->escapeHtmlAttr((string) $option['id']) ?>"
                                        <?= $selectedDestinationId === $option['id'] ? 'selected' : '' ?>>
                                        <?= $escaper->escapeHtml($option['label']) ?>
                                    </option>
                                <?php endforeach; ?>
                            </select>
                            <p class="admin__field-note">
                                <?= $escaper->escapeHtml(
                                    __(
                                        'The customer chooses this at checkout. Change it only to record a '
                                        . 'station the checkout did not save, or to redirect a shipment whose '
                                        . 'station this vehicle cannot reach. The list is the active depot '
                                        . 'network — add a missing station under Pickup Locations, which fixes '
                                        . 'it for checkout too.'
                                    )
                                ) ?>
                            </p>
                        </div>
                    </div>

                    <?php /*
                      THE REASON IS REQUIRED ONLY WHEN THIS REPLACES A CHOICE
                      THE CUSTOMER MADE, and that condition is enforced on the
                      SERVER (see the controller), not with a `required`
                      attribute here. The rule depends on which station is
                      selected against what the order already carries, which is
                      a comparison the browser cannot make — and a field that is
                      required by JavaScript only is a field that is not
                      required.
                    */ ?>
                    <div class="admin__field">
                        <label class="admin__field-label" for="spartrak-destination-reason">
                            <span><?= $escaper->escapeHtml(__('Reason for the destination')) ?></span>
                        </label>
                        <div class="admin__field-control">
                            <input type="text"
                                   id="spartrak-destination-reason"
                                   name="destination_reason"
                                   class="admin__control-text"
                                   maxlength="255"
                                   value="<?= $escaper->escapeHtmlAttr($destinationReason ?? '') ?>">
                            <p class="admin__field-note">
                                <?= $escaper->escapeHtml(
                                    __(
                                        'Required when you send an order to a station other than the one the '
                                        . 'customer chose. It is written to the order history, which is the only '
                                        . 'record of the change the customer will ever have.'
                                    )
                                ) ?>
                            </p>
                        </div>
                    </div>

                    <div class="admin__field<?= $photoUrl === null ? ' _required' : '' ?>">
                        <label class="admin__field-label" for="spartrak-vehicle-photo">
                            <span><?= $escaper->escapeHtml(__('Vehicle photo')) ?></span>
                        </label>
                        <div class="admin__field-control">
                            <?php if ($photoUrl !== null): ?>
                                <p>
                                    <img src="<?= $escaper->escapeUrl($photoUrl) ?>"
                                         alt="<?= $escaper->escapeHtmlAttr(__('Vehicle carrying this order')) ?>"
                                         style="max-width:320px;height:auto">
                                </p>
                            <?php endif; ?>
                            <input type="file"
                                   id="spartrak-vehicle-photo"
                                   name="vehicle_photo"
                                   accept="<?= $escaper->escapeHtmlAttr($block->getAcceptAttribute()) ?>"
                                   <?= $photoUrl === null ? 'required' : '' ?>>
                            <p class="admin__field-note">
                                <?= $escaper->escapeHtml(
                                    __('A photo of the actual vehicle, so the customer can identify it at the station.')
                                ) ?>
                                <?php if ($photoUrl !== null): ?>
                                    <?= $escaper->escapeHtml(__('Leave empty to keep the current photo.')) ?>
                                <?php endif; ?>
                            </p>
                        </div>
                    </div>
                </fieldset>

                <div class="admin__field-complex">
                    <button type="submit"
                            class="action-default primary"
                            <?= $isPaymentApproved ? '' : 'disabled' ?>>
                        <span><?= $escaper->escapeHtml(__('Save driver and vehicle')) ?></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>
