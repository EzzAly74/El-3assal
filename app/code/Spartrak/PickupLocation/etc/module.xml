<?xml version="1.0"?>
<!--
  SEQUENCE, not <module> dependencies for their own sake.

  This module adds COLUMNS to quote_address and sales_order_address (see
  db_schema.xml) and copies values between them through Magento's own
  `sales_convert_quote_address` fieldset. Both operations require the core
  tables and the fieldset to exist before this module is processed, which is
  exactly what <sequence> guarantees.

  Magento_Directory is sequenced because Setup\Patch\Data\AddEgyptGovernorates
  writes into directory_country_region, and Magento_Checkout because the
  frontend layout extends the checkout's Knockout component tree.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Spartrak_PickupLocation">
        <sequence>
            <module name="Magento_Directory"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Checkout"/>
            <module name="Magento_Shipping"/>
            <!-- Model\StoreLanguage resolves which of the _ar/_en columns on a
                 branch or depot this store view should render. -->
            <module name="Spartrak_Locale"/>
        </sequence>
    </module>
</config>
