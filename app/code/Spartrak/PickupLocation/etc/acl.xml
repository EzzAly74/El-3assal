<?xml version="1.0"?>
<!--
  Under Stores, not Content.

  A branch or a depot is not marketing copy - it is a physical fulfilment point
  that changes where a shopper's parcel is sent, which puts it in the same
  family as shipping and store configuration. Magento already trains admins to
  look under Stores for anything that governs how an order is fulfilled.

  Three resources rather than one, for the same least-privilege reason
  Spartrak_Homepage splits sections from banners: an operator list is a rarely
  touched reference set, while depots turn over as routes change. A branch
  manager can be given the branch role without also being able to retire an
  operator that dozens of depots point at.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Spartrak_PickupLocation::pickup" title="Spartrak Pickup Locations" sortOrder="60">
                        <resource id="Spartrak_PickupLocation::branch" title="Branches" sortOrder="10"/>
                        <resource id="Spartrak_PickupLocation::depot" title="Depots" sortOrder="20"/>
                        <resource id="Spartrak_PickupLocation::operator" title="Transport Operators" sortOrder="30"/>
                    </resource>
                </resource>
                <!--
                  ===========================================================
                  THE CONSIGNMENT — under Sales, not Stores
                  ===========================================================
                  The three resources above configure WHERE orders can be
                  collected; this one records WHO is driving a particular
                  shipment. That is order operations, not fulfilment setup, and
                  it is done by the dispatcher working through the order queue —
                  so it sits where they already are.

                  The parent chain is re-stated exactly as Magento_Sales
                  declares it, and only the last resource is ours. Nesting an
                  existing id under a different parent puts the same id at two
                  positions and the ACL builder refuses to build AT ALL, taking
                  the whole admin down with it. Spartrak_InstaPay's acl.xml
                  records that failure in full — it has already happened once on
                  this project.
                -->
                <resource id="Magento_Sales::sales">
                    <resource id="Magento_Sales::sales_operation">
                        <resource id="Magento_Sales::sales_order">
                            <resource id="Magento_Sales::actions">
                                <resource id="Spartrak_PickupLocation::consignment"
                                          title="Record station driver and vehicle"
                                          translate="title" sortOrder="95"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
