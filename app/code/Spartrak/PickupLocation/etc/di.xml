<?xml version="1.0"?>
<!--
  GLOBAL, not frontend.

  ShippingInformationManagement::saveAddressInformation() is reached over the
  REST API - the checkout's Knockout layer POSTs to
  /rest/V1/carts/mine/shipping-information, which runs in the `webapi_rest`
  area, NOT `frontend`. A plugin declared in etc/frontend/di.xml would simply
  never fire on a real checkout, and would appear to work in any test that
  called the service directly. This is the single most common way a checkout
  plugin ends up silently doing nothing, so it is written down here.

  The config provider, by contrast, IS frontend-only and lives in
  etc/frontend/di.xml, because window.checkoutConfig is a rendered-page concern.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="spartrak_pickup_apply_location"
                type="Spartrak\PickupLocation\Plugin\Checkout\ApplyPickupLocation"
                sortOrder="10"/>
    </type>
</config>
