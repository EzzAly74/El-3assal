<?xml version="1.0"?>
<!--
  ADMIN ONLY. Neither of these exists on a storefront request: the form
  modifier runs while the product form is being built, and the uploader is
  reachable from one admin controller.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
      THE PRODUCT VIDEOS FIELDSET'S DATA.

      Only `modifyData()` does anything — the fieldset and its fields are
      declared in view/adminhtml/ui_component/product_form.xml, where they can
      be read, diffed and overridden. Building form structure in PHP is how a
      form becomes unreadable.

      sortOrder 200 puts it after Magento's own modifiers, which is what has
      already put the media gallery on the product by the time this reads it.
    -->
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="spartrak_product_videos" xsi:type="array">
                    <item name="class" xsi:type="string">Spartrak\ProductVideo\Ui\DataProvider\Product\Form\Modifier\Videos</item>
                    <item name="sortOrder" xsi:type="number">200</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <!--
      THE UPLOADER'S POLICY.

      Kept here rather than in PHP because it is policy a developer may want to
      change without touching code, and because the extension list, the MIME
      list and the size cap have to be kept in step with one another.

      TWO FORMATS, NOT A LONG LIST. MP4 (H.264) and WebM (VP9) are what every
      browser this storefront supports can play natively. MOV, AVI, MKV and
      friends would upload happily and then fail to play for most shoppers,
      which is a worse outcome than being told at upload time — and accepting
      them would imply a transcoding pipeline this module deliberately does not
      have.

      THE MIME LIST IS CHECKED AGAINST THE FILE'S REAL BYTES, not its name. An
      extension is a claim; `checkMimeType()` reads the magic.

      100 MB, and the same number is written into the fieldset's own
      maxFileSize so the browser refuses an oversized file before spending a
      minute uploading it. Above that a merchant should be putting the file on
      a CDN and pasting the URL — which this module supports — rather than
      serving tens of megabytes of video off the same origin that has to answer
      product pages. It is also a ceiling on what a compromised admin account
      can push onto the disk.
    -->
    <type name="Spartrak\ProductVideo\Model\Video\Uploader">
        <arguments>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="mp4" xsi:type="string">mp4</item>
                <item name="webm" xsi:type="string">webm</item>
            </argument>
            <argument name="allowedMimeTypes" xsi:type="array">
                <item name="mp4" xsi:type="string">video/mp4</item>
                <item name="webm" xsi:type="string">video/webm</item>
            </argument>
            <argument name="maxFileSizeBytes" xsi:type="number">104857600</argument>
        </arguments>
    </type>

</config>
