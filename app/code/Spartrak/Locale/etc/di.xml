<?xml version="1.0"?>
<!--
/**
 * Spartrak — Latin numerals, everywhere.
 *
 * Three seams, because Magento builds ICU formatters at three points and only
 * one of them goes through a factory. Each class carries the full reasoning for
 * its own seam; the README has the map.
 *
 * GLOBAL, NOT frontend-only, on purpose. The rule is that this business writes
 * numbers in Latin digits — it is not a storefront skin. An admin reading an
 * order total in ٠١٢٣ while the customer's confirmation email says 0123 is the
 * same defect seen from the other side, and reconciling the two by eye is
 * exactly the kind of thing that produces a mis-keyed refund.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Seam 1: every server-rendered price (via the generated NumberFormatterFactory). -->
    <preference for="Magento\Framework\NumberFormatter" type="Spartrak\Locale\Model\NumberFormatter"/>

    <!-- Seam 2: the toCurrency() fallback, fixed at construction. -->
    <preference for="Magento\Framework\Currency" type="Spartrak\Locale\Model\Currency"/>

    <!-- Seam 3: the decimal/group separators handed to the browser. -->
    <type name="Magento\Framework\Locale\Format">
        <plugin name="spartrak_latin_price_format" type="Spartrak\Locale\Plugin\LatinPriceFormat"/>
    </type>

    <!--
      Seam 6: PLAIN NUMBERS — page numbers, item counts, "showing X-Y of Z".
      Locale\LocaleFormatter builds its own ICU formatter with a bare
      numfmt_create(), which no preference or plugin on the other seams can
      reach; it is why pagination still rendered ٠١٢٣ after prices were fixed.
      A preference, because the formatter is cached in a private property. It
      also pins the locale handed to JavaScript. See the class.
    -->
    <preference for="Magento\Framework\Locale\LocaleFormatter"
                type="Spartrak\Locale\Model\LocaleFormatter"/>

    <!--
      Seam 4: DATES. A different ICU class (\IntlDateFormatter) reading the same
      locale, so the first three seams never touched it — every date in `ar_EG`
      rendered as ٣٠ يوليو ٢٠٢٦. This factory is the single point at which the
      platform builds every date formatter. See the plugin class.
    -->
    <type name="Magento\Framework\Stdlib\DateTime\Intl\DateFormatterFactory">
        <plugin name="spartrak_latin_date_formatter" type="Spartrak\Locale\Plugin\LatinDateFormatter"/>
    </type>

    <!--
      Seam 5: TRAILING ".00". Not a numbering-system question at all — a
      presentation rule about precision — but it belongs with the other price
      formatting so there is one module that owns how this store writes a
      number. See the plugin class.
    -->
    <type name="Magento\Directory\Model\Currency">
        <plugin name="spartrak_whole_price_precision" type="Spartrak\Locale\Plugin\WholePricePrecision"/>
    </type>

</config>
