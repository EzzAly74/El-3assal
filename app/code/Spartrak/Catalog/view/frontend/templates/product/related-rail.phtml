<?php
/**
 * Spartrak — PDP related-products rail.
 *
 * Figma 535:12047 (desktop, inside PDP 534:9322 / 526:21854) and 655:19767
 * (mobile, inside 650:32798): the heading "منتجات أخري من جون دير" on the
 * inline-end side, the controls on the inline-start side, and a scrolling row
 * of the shared Card - Product beneath.
 *
 * ===========================================================================
 * THIS IS THE HOMEPAGE RAIL. NOT A COPY OF IT.
 * ===========================================================================
 * Structurally identical to Spartrak_Homepage::section/product-carousel.phtml,
 * because it is the same component: it renders that module's own
 * section/head.phtml unmodified, uses the same class names, the same CSS in
 * _homepage-sections.less, the same card in _product-card.less and the same
 * carousel widget. The only thing the PDP supplies is a different source of
 * products.
 *
 * Nothing outside this module was edited to make that work — the header
 * partial, the card, the homepage blocks and the stylesheets are all untouched.
 *
 * Nothing in _pdp.less redefines how any of it LOOKS — that section only
 * places the component on this page and undoes the homepage's page gutter,
 * which .column.main already provides here.
 *
 * @var \Spartrak\Catalog\Block\Product\RelatedRail $block
 */

$products = $block->getRailProducts();

/*
 * A rail with nothing in it renders NOTHING — not a heading, not an empty
 * panel. Beyond being the honest outcome, an empty section that still
 * reserved its header height would push the footer down for no content
 * (CLAUDE.md §4, CLS).
 */
if ($products === []) {
    return;
}

$isCarousel = $block->isCarousel();
?>
<section class="spartrak-home-section spartrak-home-rail spartrak-pdp-related"
         aria-labelledby="<?= $block->escapeHtmlAttr($block->getHeadingId()) ?>"
    <?php if ($isCarousel) : ?>data-mage-init='{"spartrakHomeCarousel":{"mode":"rail"}}'<?php endif; ?>>

    <?= /* @noEscape */ $block->getHeadHtml() ?>

    <div class="spartrak-home-rail__panel">
        <ul class="spartrak-home-rail__track" data-carousel-track>
            <?php foreach ($products as $product) : ?>
                <li class="spartrak-home-rail__item" data-carousel-slide>
                    <?= /* @noEscape */ $block->renderCard($product) ?>
                </li>
            <?php endforeach; ?>
        </ul>

        <?php if ($isCarousel) : ?>
            <?php /*
              The shared scroll indicator (Figma 655:19975 on this page). Driven
              by the scroll position through a single CSS custom property the
              widget writes on rAF, so scrolling repaints one transform and
              touches no other DOM node.
            */ ?>
            <div class="spartrak-home-progress" aria-hidden="true">
                <span class="spartrak-home-progress__bar" data-carousel-progress></span>
            </div>
        <?php endif; ?>
    </div>
</section>
