    gap: 12px;
    padding: 0 4px 12px;
}

.spartrak-card__content {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 8px;
}

/* Figma 569:13717 is `items-end` in its LTR canvas, i.e. the rating row is
   pulled to the inline-start edge of an RTL layout. flex-start resolves to
   that automatically and mirrors for LTR. */
.spartrak-card__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
}

.spartrak-card__name-wrap {
    display: flex;
    align-items: center;
    width: 100%;
    padding-inline: 2px;
}

/* Figma 569:13719 — Heading/H4: arabic medium, 18px, line-height 1.3,
   text/primary, clamped to 2 lines (the design's own Name Container is 46px
   on two-line names and 23px on one-line ones, so it hugs rather than
   reserving a fixed two-line box). */
.spartrak-card__name {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-18);
