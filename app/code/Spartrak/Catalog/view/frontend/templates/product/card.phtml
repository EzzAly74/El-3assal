.spartrak-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    font-weight: 400;
}

/* Magento's final_price.phtml emits [.old-price, .special-price]. Figma
   renders the CURRENT price at the inline-start edge and the struck-through
   original beside it, so the two are reordered here rather than by forking
   the price template. */
.spartrak-card__price .special-price {
    order: 1;
}

.spartrak-card__price .old-price {
    order: 2;
    margin: 0;
}

/* Figma "Price/Medium" (569:13748 / 569:13703): arabic bold, size/xl 20px,
   line-height 1.3, text/primary. Applies to both the discounted final
   price and a plain single price. */
.spartrak-card__price .price-container .price,
.spartrak-card__price .special-price .price {
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-20);
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
}

/* Figma "Body/Base Medium" (569:13746) on `text/price-sale` (#d54033 — the
   same primitive this theme already exposes as feedback/danger), with the
   0.5px strike Figma draws as a vector. */
.spartrak-card__price .old-price .price {
    color: var(--color-feedback-danger);
    font-family: var(--font-arabic);
    font-size: var(--text-16);
    font-weight: 500;
    line-height: 1.5;
    text-decoration: line-through;
    text-decoration-thickness: .5px;
    white-space: nowrap;
}

/* Screen-reader-only price labels ("Regular Price", "Special Price"). */
.spartrak-card__price .price-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

/* DATA REQUIRED fallback (real price not yet available) — deliberately
   muted, never dressed up as a real price figure. */
.spartrak-price-unavailable__label {
    color: var(--color-text-muted);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    font-weight: 400;
    font-style: italic;
}

/* --- Round add-to-cart (Figma 718:25242 / 718:25614) ------------------
   36px action/primary circle, 1px border/default, white plus drawn at
   12.9167px — the exact size Figma's own export carries (the 20px Plus
   frame's glyph is inset 20.83% and expanded 5.36% for its 1.25px stroke).
   The <form> is the flex item; it must not add spacing of its own. */
.spartrak-card__form {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
}

.spartrak-card__add-to-cart {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-pill);
    background: var(--color-action-primary) url('<?= /* @noEscape */ $iconPlus ?>') no-repeat center / 12.9167px 12.9167px;
    cursor: pointer;
    transition: background-color .15s ease;
}

.spartrak-card__add-to-cart:hover {
    background-color: var(--color-action-primary-hover);
}

@media (prefers-reduced-motion: reduce) {
    .spartrak-card,
    .spartrak-card__add-to-cart {
        transition: none;
    }
}
</style>
<?php endif; ?>
