/* ===================================================================
   Spartrak — Card - Product. Figma 569:13667 / 569:13704.
   TEMPORARY inline home; final home is components/_product-card.less.
   =================================================================== */

:root {
    /* Figma semantic role `border/subtle` (#f3f3f4) — the card's own border
       colour. It resolves to the primitive this theme already ships as
       --primitive-field-bg, but the SEMANTIC alias does not exist yet.
       PROMOTE THIS LINE into foundations/_semantic.less when the CSS moves
       out of the template; do not leave it declared in a template. */
    --color-border-subtle: var(--primitive-field-bg);

    /* Figma "Shadow/Input" / "Input field" effect, shared by the card's
       wishlist button, the toolbar chips and every filter input:
       DROP_SHADOW #2C363506 offset(0,1) radius 1.5. Rendered as box-shadow
       rather than filter: drop-shadow() — identical on an opaque rectangle,
       and it does not force a compositing layer per element. */
    --shadow-input: 0 1px 1.5px rgba(44, 54, 53, 0.03);
}

/* --- Card shell ---------------------------------------------------------
   Figma: 1px border/subtle, NO corner radius, 12px gap between the image
   and the content block. height:100% plus the auto margin on the price row
   keeps every card in a grid row the same height with the price/CTA line
   pinned to the bottom — which is what the Figma row does too (card
   569:13749 has its Name-and-Rating block stretched by exactly the 29px
   needed to match its taller siblings). */
.spartrak-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0;
    background: var(--color-bg-surface);
    overflow: visible;
    transition: border-color .15s ease;
}

/* Hover is NOT in Figma (Card - Product has no hover variant). This keeps
   the affordance the theme already established rather than inventing a new
   one — same rule, same token, carried across the rebuild. */
.spartrak-card:hover {
    border-color: var(--color-action-primary);
}

/* --- Media (Figma 569:13705): square, bg/field, clipped ---------------- */
.spartrak-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--color-bg-field);
    overflow: hidden;
}

.spartrak-card__image-link {
    display: block;
    position: absolute;
    inset: 0;
}

/* Figma drops a 260x260 image into the 245x245 clipped frame (node
   569:13706 sits at -7,-7 with size 260) — the photo deliberately bleeds
   ~6% past the frame and is cropped by it, which is visible on the design's
   own render. 260/245 = 106.122%. Centring is symmetric, so physical
   left/top + transform is correct here and needs no RTL variant. */
.spartrak-card__image {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 106.122%;
    height: 106.122%;
    max-width: none;
    object-fit: contain;
}

/* --- Overlay row (Figma 569:13707) -------------------------------------
   absolute, full width, 12px inset, space-between. DOM order is
   [wishlist, promo] so that under dir=rtl the heart lands in the
   inline-start (right) corner and the badge in the inline-end (left) one,
   exactly as the design renders — and mirrors correctly for an LTR store.
   pointer-events are handed back only to the two controls so the rest of
   the overlay does not steal clicks from the image link underneath. */
.spartrak-card__actions {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    padding: 12px;
    pointer-events: none;
}

.spartrak-card__actions > * {
    pointer-events: auto;
}

/* --- Wishlist heart (Figma 718:25231 / 718:25608) ----------------------
   40px white circle, shadow 0 1px 2px rgba(0,0,0,.1), 20px heart.
   Restyles Magento's own native `.action.towishlist` anchor: the heart is
   the real Figma SVG as a background image (one request, no extra DOM), and
   the anchor's label text stays in the markup for assistive tech. */
.spartrak-card__wishlist {
    position: static;
    inset: auto;
    flex: none;
}

.spartrak-card__wishlist .action.towishlist {
    display: inline-flex;
