    overflow: hidden;
}

.spartrak-card__name:hover {
    color: var(--color-action-primary);
}

/* --- Rating (Figma 569:13720) ------------------------------------------
   [5x20 stars][value][count], 4px gaps. `direction: ltr` scopes ONLY this
   row: a star meter is a numeric construct that fills left-to-right in both
   locales (Figma's own partial star is the 5th/rightmost one), so it must
   not mirror — while the row as a whole is still aligned to the layout's
   inline-start by the parent's align-items above. */
.spartrak-card__rating {
    display: flex;
    align-items: center;
    gap: 4px;
    direction: ltr;
}

/* The star row is ONE element: the real Figma star path is used as a
   repeating mask, the fill level as a hard-stop gradient behind it. One
   request, no per-star DOM, no JS, and both colours are real tokens.
   To ship Figma's literal all-empty render instead, delete the
   background-image declaration. */
.spartrak-card__stars {
    flex: none;
    width: 100px;
    height: 20px;
    background-color: var(--color-rating-empty);
    background-image: linear-gradient(
        to right,
        var(--color-action-accent) var(--spartrak-rating-fill, 0%),
        transparent var(--spartrak-rating-fill, 0%)
    );
    -webkit-mask-image: url('<?= /* @noEscape */ $iconStar ?>');
    mask-image: url('<?= /* @noEscape */ $iconStar ?>');
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    -webkit-mask-position: left center;
    mask-position: left center;
    -webkit-mask-size: 20px 20px;
    mask-size: 20px 20px;
}

/* Figma "Latin/Label": font/family/latin, medium, 14px, line-height 1.3. */
.spartrak-card__rating-value {
    color: var(--color-text-primary);
    font-family: var(--font-latin);
    font-size: var(--text-14);
    font-weight: 500;
