<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <!--
      Sequenced after the three modules whose tables this one adds a column to,
      and after Magento_Checkout because the storefront form this field appears
      on is built by the checkout's LayoutProcessor.
    -->
    <module name="Spartrak_CustomerAddress">
        <sequence>
            <module name="Magento_Customer"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Checkout"/>
        </sequence>
    </module>
</config>
