<?xml version="1.0"?>
<!--
  GLOBAL scope, deliberately.

  These events fire wherever an address is written - the storefront checkout,
  the REST API, My Account, and admin order create. Scoping them to `frontend`
  would make the fields work at checkout and vanish on an order an agent creates
  by phone, which is exactly the customer they exist for.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="sales_quote_address_save_before">
        <observer name="spartrak_flatten_additional_phone"
                  instance="Spartrak\CustomerAddress\Observer\FlattenAdditionalPhone"/>
        <observer name="spartrak_fill_city_from_governorate"
                  instance="Spartrak\CustomerAddress\Observer\FillCityFromGovernorate"/>
    </event>

    <!--
      A direct `$addressModel->save()` - a data patch, an import script, a
      legacy module that never adopted the repository. Figma's form collects no
      city, so such an address would otherwise be written without one.

      NOT the path My Account or the REST API take. Those go through
      AddressRepositoryInterface::save(), which VALIDATES before it saves, so
      this event fires after the "city is required" rejection has already
      happened. That door is covered by
      Spartrak\CustomerAddress\Plugin\FillCityOnAddressRepositorySave (etc/di.xml),
      whose header records the sequence in full. This observer stays for the
      doors the repository does not own.
    -->
    <event name="customer_address_save_before">
        <observer name="spartrak_fill_city_from_governorate"
                  instance="Spartrak\CustomerAddress\Observer\FillCityFromGovernorate"/>
    </event>
</config>
