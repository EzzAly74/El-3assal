<?xml version="1.0"?>
<!--
  Frontend-only, correctly: LayoutProcessor builds the rendered checkout page's
  jsLayout, which only exists in the frontend area.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="spartrak_scope_additional_phone"
                type="Spartrak\CustomerAddress\Plugin\ScopeAdditionalPhoneToCustomAttributes"
                sortOrder="100"/>
    </type>
</config>
