<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Spartrak_Catalog" setup_version="1.0.0">
        <sequence>
            <module name="Magento_Catalog"/>
            <module name="Magento_CatalogSearch"/>
            <!--
              Magento_Swatches: ViewModel\BrandNavigation reads the header
              mega-menu's brand logos from the per-option VISUAL SWATCH IMAGES
              an admin uploads against the `brand` attribute, using that
              module's own Helper\Data and Helper\Media. Declared so this
              module always loads after it.
            -->
            <module name="Magento_Swatches"/>
        </sequence>
    </module>
</config>
