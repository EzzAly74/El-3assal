<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Payment\Model\Method\Factory">
        <plugin name="paymob_dynamic_method_plugin" type="Paymob\Payment\Plugin\PaymentMethodFactoryPlugin" sortOrder="1"/>
    </type>

    <type name="Magento\Payment\Model\Config">
        <plugin name="paymob_dynamic_methods" type="Paymob\Payment\Plugin\PaymentConfigPlugin" />
    </type>

    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="paymob_config_provider" xsi:type="object">Paymob\Payment\Model\ConfigProvider</item>
            </argument>
        </arguments>
    </type>
  
    <type name="Paymob\Payment\Model\ConfigProvider">
        <arguments>
            <argument name="dynamicMethodsProvider" xsi:type="object">Paymob\Payment\Model\DynamicMethodsProvider</argument>
        </arguments>
    </type>

    <type name="Magento\Payment\Model\MethodList">
        <plugin name="paymob_methods_plugin" type="Paymob\Payment\Plugin\MethodListPlugin" sortOrder="10" />
    </type>

    <type name="Magento\Config\Block\System\Config\Form">
        <plugin name="paymob_add_dynamic_methods"
                type="Paymob\Payment\Plugin\Adminhtml\AddDynamicMethodsPlugin"
                sortOrder="10" />
    </type>
    
    <type name="Magento\Payment\Model\Method\AbstractMethod">
        <arguments>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
        </arguments>
    </type>

   <type name="Magento\Sales\Model\ResourceModel\Order\Grid\Collection">
        <plugin name="paymob_normalize_method_grid"
                type="Paymob\Payment\Plugin\NormalizePaymentMethodGridPlugin"
                sortOrder="10"/>
    </type>

    <type name="Paymob\Payment\Model\Method\PaymobGeneric">
        <arguments>
            <argument name="urlBuilder" xsi:type="object">Magento\Framework\UrlInterface</argument>
        </arguments>
    </type>

</config>
