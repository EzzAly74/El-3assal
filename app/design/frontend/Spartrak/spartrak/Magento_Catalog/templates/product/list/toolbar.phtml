<?php
/**
 * Spartrak — PLP / search-results toolbar.
 *
 * Overrides Smartwave/porto's Magento_Catalog/templates/product/list/
 * toolbar.phtml (the Magento\Catalog\Block\Product\ProductList\Toolbar
 * template). Category browsing and search results share this one block, so
 * this single file covers both.
 *
 * --- FIGMA PASS 2026-08-26, node 569:13635 ---------------------------
 * Read live via the Figma MCP server (file 6FRlQfPIncVUvNiJLn2kbT). The
 * design's toolbar is two stacked rows, 16px apart:
 *
 *   row 1  569:13636  results heading, pulled to the inline-start edge:
 *                     [ 2,500+ ]  Heading/H2  arabic bold 24/1.3
 *                     [ نتائج بحث منتجات "جون ديير" ]  Body/Small 14/1.5
 *                     grey, with the search term itself bold + text/primary
 *   row 2  569:13640  full width:
 *            569:13646  three quick-sort chips at the inline-start edge,
 *                       8px apart, each h40 / px16 / 1px border/default /
 *                       square corners / Shadow-Input, Label/Large 14/1.3,
 *                       with a 16px gradient icon AFTER the label in the
 *                       LTR canvas (= at the inline-start under RTL)
 *            569:13641  the sort control at the inline-end edge, h40 /
 *                       px20 / same border + shadow, "الترتيب: الافتراضي"
 *                       with a 16px chevron-down
 *
 * WHAT IS REUSED, NOT REBUILT
 *   - the sort <select> is Magento's own [data-role="sorter"] control, so
 *     productListToolbarForm still binds to it and sorting keeps working
 *     exactly as before — only its chrome is restyled;
 *   - the pager is Magento's own Html\Pager child block, untouched, just
 *     given its native anchor text so "Previous"/"Next" render as the words
 *     the design shows (a translatable string, not CSS content);
 *   - Porto's mobile filter-toggle anchor is carried over VERBATIM, inline
 *     SVG included, because spartrak-plp-filter-toggle.js is already wired
 *     to that exact element and Figma has no mobile PLP frame to replace it
 *     with (do not swap in a different icon here on a guess);
 *   - Porto's trailing infinite-loader script is kept unchanged.
 *
 * DELIBERATE OMISSIONS, per CLAUDE.md section 3 (Figma is the UI SSOT for
 * this surface) — say the word and either comes straight back:
 *   - the LIMITER ("products per page") and the VIEW-MODE switcher
 *     (grid/list). Neither exists anywhere in the Figma PLP.
 *   - the sort DIRECTION toggle (Magento's sort-asc/sort-desc anchor). The
 *     design's sort control is a single dropdown with no direction control.
 *
 * THE THREE CHIPS, AND WHAT IS AND IS NOT REAL ABOUT THEM
 * ---------------------------------------------------------------------
 * Figma names them "الأكثر مبيعا" (best selling), "الأكثر بحثا" (most
 * searched) and "خصومات مميزه" (special discounts). None of the three is a
 * native Magento sort option.
 *
 * An earlier revision of this file rendered a chip ONLY when its sort key
 * already existed in getAvailableOrders(), which on this catalog meant the
 * row was empty and the design's most recognisable control was missing from
 * the page. All three now render, always, exactly as drawn — but a chip whose
 * sort key does not exist yet is emitted as a NON-INTERACTIVE <span>, not as
 * an <a> pointing at a product_list_order value the toolbar would ignore.
 *
 * That distinction is the whole point and must not be "tidied" into a link:
 *   - a link that silently does nothing is a broken control, and it is
 *     announced to a screen reader and to a crawler as a real destination;
 *   - a <span aria-disabled="true"> looks identical, is honest about being
 *     inert, is skipped by keyboard navigation and adds no crawlable URL.
 *
 * The moment a sort key is registered — see below — its chip becomes a real
 * link on the next request with no change to this file.
 *
 * MAKING THEM REAL. All three are computable from data Magento already keeps:
 *   bestsellers    sales_bestsellers_aggregated_* (Magento_Sales' own
 *                  aggregation, refreshed by its cron)
 *   most_viewed    report_viewed_product_aggregated_* (Magento_Reports)
 *   special_price  the native attribute, or price - final_price out of
 *                  catalog_product_index_price
 * Each needs (a) an afterGetAttributeUsedForSortByArray plugin on
 * Magento\Catalog\Model\Config to register the option, and (b) something that
 * applies the ordering — which, on a storefront running Elasticsearch, means
 * indexing the value as a sortable field rather than bolting an ORDER BY onto
 * a collection that has already been paginated by the search engine. That is
 * a real piece of work with its own indexer, not a line in a template.
 *
 * @var $block \Magento\Catalog\Block\Product\ProductList\Toolbar
 */

$collectionSize = (int) $block->getCollection()->getSize();

// Real search term, used for the results heading. Present only on
// catalogsearch pages; a category page has no `q`.
$searchTerm = trim((string) $block->getRequest()->getParam('q', ''));

/**
 * Quick-sort chips (Figma 569:13646). The map is the DESIGN's intent; the
 * filter below is what keeps it honest. Order matters: the first entry is
 * the inline-start-most chip, which under RTL is the rightmost — matching
 * Figma, where "الأكثر مبيعا" sits furthest right.
 *
 * `icon` values are the exact gradient SVGs Figma exports for these three
 * chips; all three were byte-compared against the copies already in this
 * theme's web/images/icons/ and match, so no new asset was added:
 *   fire-simple.svg == 569:13663 (1277 B)   trend-up.svg == 569:13656 (1720 B)
 *   lightning.svg   == 569:13650 (1503 B)
 */
$quickSortMap = [
    'bestsellers' => ['label' => __('Best selling'), 'icon' => 'fire-simple.svg'],
    'most_viewed' => ['label' => __('Most searched'), 'icon' => 'trend-up.svg'],
    'special_price' => ['label' => __('Special offers'), 'icon' => 'lightning.svg'],
];

$availableOrders = (array) $block->getAvailableOrders();
$currentOrder = (string) $block->getCurrentOrder();

/*
 * Every chip in the design is rendered. `wired` records whether the toolbar
 * actually knows the sort key behind it, and that single flag is what decides
 * <a> vs inert <span> below — see the header for why the distinction matters.
 */
$quickSorts = [];
foreach ($quickSortMap as $orderKey => $chip) {
    $chip['wired'] = array_key_exists($orderKey, $availableOrders);
    $quickSorts[$orderKey] = $chip;
}

/*
 * NOTHING IS CONFIGURED ON THE PAGER FROM HERE ANY MORE.
 *
 * This used to call setAnchorTextForPrevious()/setAnchorTextForNext() so core
 * would print "السابق" / "التالي" inside the two pills. It did not work — both
 * rendered with the CSS arrow and no words — and rather than keep guessing at
 * core's conditions for honouring a setter applied from a template that runs
 * before the pager renders, the words now live in the markup itself:
 * Magento_Theme/templates/html/pager.phtml in this theme.
 *
 * The pager block is still NOT rendered here. list.phtml renders it once, on
 * its own, below the grid where Figma puts it (node 569:14143).
 */
?>
<?php if ($collectionSize) : ?>
    <div class="toolbar toolbar-products spartrak-toolbar" data-mage-init='<?= /* @noEscape */ $block->getWidgetOptionsJson() ?>'>


        <?php /*
          Row 1 — results heading (Figma 569:13636). DOM order is
          [count, label] so that under dir=rtl the number lands at the
          inline-start (right) edge with the sentence to its left, exactly
          as the design renders, and mirrors cleanly for an LTR store.
          The count is the collection's real size — no "+" flourish is
          added, because that would misstate a real number.
        */ ?>
        <p class="spartrak-toolbar__head">
            <strong class="spartrak-toolbar__count"><?= $block->escapeHtml(number_format($collectionSize)) ?></strong>
            <span class="spartrak-toolbar__label">
                <?php if ($searchTerm !== '') : ?>
                    <?= $block->escapeHtml(__('Product search results for')) ?>
                    &ldquo;<strong class="spartrak-toolbar__term"><?= $block->escapeHtml($searchTerm) ?></strong>&rdquo;
                <?php else : ?>
                    <?= $block->escapeHtml(__('products')) ?>
                <?php endif; ?>
            </span>
        </p>

        <?php /* Row 2 — quick-sort chips + the sort control (Figma 569:13640). */ ?>
        <div class="spartrak-toolbar__controls">
            <div class="spartrak-toolbar__quick">
                <?php foreach ($quickSorts as $orderKey => $chip) : ?>
                    <?php
                    $isActive = $chip['wired'] && $currentOrder === $orderKey;
                    // One shared inner body, so a wired and an unwired chip
                    // are pixel-identical and can never drift apart.
                    $chipIcon = $block->escapeUrl($block->getViewFileUrl('images/icons/' . $chip['icon']));
                    $chipClass = 'spartrak-chip'
                        . ($isActive ? ' spartrak-chip--active' : '')
                        . ($chip['wired'] ? '' : ' spartrak-chip--pending');
                    ?>
                    <?php if ($chip['wired']) : ?>
                        <a class="<?= $block->escapeHtmlAttr($chipClass) ?>"
                           href="<?= $block->escapeUrl($block->getOrderUrl($orderKey, 'desc')) ?>"
                           <?= $isActive ? 'aria-current="true"' : '' ?>>
                    <?php else : ?>
                        <?php /*
                          NOT a link and NOT a disabled <button>. There is no
                          destination to point at yet, so an <a> would be a
                          broken control announced as a real one; and a
                          <button disabled> would still be a form control the
                          design does not draw, greyed by the UA. A span with
                          aria-disabled is inert, keyboard-skipped, crawler-
                          invisible and visually identical to the real thing.
                        */ ?>
                        <span class="<?= $block->escapeHtmlAttr($chipClass) ?>" aria-disabled="true">
                    <?php endif; ?>
                            <img class="spartrak-chip__icon"
                                 src="<?= /* @noEscape */ $chipIcon ?>"
                                 alt=""
                                 width="16"
                                 height="16"
                                 loading="lazy"
                                 decoding="async" />
                            <span class="spartrak-chip__label"><?= $block->escapeHtml($chip['label']) ?></span>
                    <?php if ($chip['wired']) : ?>
                        </a>
                    <?php else : ?>
                        </span>
                    <?php endif; ?>
                <?php endforeach; ?>
            </div>

            <?php if (count($availableOrders) > 1) : ?>
                <div class="spartrak-toolbar__sort spartrak-sorter">
                    <span class="spartrak-sorter__text">
                        <label class="spartrak-sorter__label" for="sorter"><?= $block->escapeHtml(__('Sort:')) ?></label>
                        <select id="sorter" data-role="sorter" class="spartrak-sorter__select">
                            <?php foreach ($availableOrders as $orderKey => $orderLabel) : ?>
                                <option value="<?= $block->escapeHtmlAttr($orderKey) ?>"
                                    <?= $currentOrder === (string) $orderKey ? ' selected="selected"' : '' ?>>
                                    <?= $block->escapeHtml(__($orderLabel)) ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                    </span>
                    <span class="spartrak-sorter__chevron" aria-hidden="true"></span>
                </div>
            <?php endif; ?>

            <?php /*
              THE MOBILE FILTER BUTTON — Figma 864:20389.

              Porto ships this control as an <a href="#"> at the very TOP of
              the toolbar, above the results heading. Two things are changed
              and both are deliberate:

                - it MOVES here, beside the sort control, because that is
                  where the design puts it: one row of two equal controls
                  under the quick-sort chips;
                - it becomes a <button>. It opens a drawer rather than
                  navigating, and `href="#"` on a control that never goes
                  anywhere adds a history entry and a jump-to-top on every
                  press.

              Porto's own class names are KEPT so nothing else that keys off
              them breaks, and its inline SVG is carried over verbatim — it is
              the sliders glyph the design draws, and it already ships here.

              Rendered unconditionally: the stylesheet shows it only below the
              collapse breakpoint, so the desktop sidebar is untouched.
            */ ?>
            <?php /*
              MOUNTED HERE, ON THE TRIGGER ITSELF.

              It used to be mounted from layout as a data-mage-init attribute
              on <body>, declared separately in the category and the search
              layout XML. Two files had to keep a widget name in sync with
              this template for the button to do anything, and when the chain
              broke it broke silently. The behaviour now ships with the markup
              it belongs to, and the search route picks it up for free because
              both routes render this same toolbar.

              The module delegates from `document`, so it does not care that
              it is mounted on the trigger rather than on an ancestor of the
              sidebar it opens.
            */ ?>
            <button type="button"
                    class="porto-product-filters-toggle spartrak-toolbar__filter"
                    data-mage-init='{"spartrakPlpFilterToggle":{}}'
                    data-filter-drawer-open
                    aria-haspopup="dialog"
                    aria-expanded="false">
                <svg data-name="Layer 3" id="Layer_3" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><line class="cls-1" x1="15" x2="26" y1="9" y2="9"></line><line class="cls-1" x1="6" x2="9" y1="9" y2="9"></line><line class="cls-1" x1="23" x2="26" y1="16" y2="16"></line><line class="cls-1" x1="6" x2="17" y1="16" y2="16"></line><line class="cls-1" x1="17" x2="26" y1="23" y2="23"></line><line class="cls-1" x1="6" x2="11" y1="23" y2="23"></line><path class="cls-2" d="M14.5,8.92A2.6,2.6,0,0,1,12,11.5,2.6,2.6,0,0,1,9.5,8.92a2.5,2.5,0,0,1,5,0Z"></path><path class="cls-2" d="M22.5,15.92a2.5,2.5,0,1,1-5,0,2.5,2.5,0,0,1,5,0Z"></path><path class="cls-3" d="M21,16a1,1,0,1,1-2,0,1,1,0,0,1,2,0Z"></path><path class="cls-2" d="M16.5,22.92A2.6,2.6,0,0,1,14,25.5a2.6,2.6,0,0,1-2.5-2.58,2.5,2.5,0,0,1,5,0Z"></path></svg>
                <span class="spartrak-toolbar__filter-label"><?= $block->escapeHtml(__('Filter')) ?></span>
                <span class="spartrak-toolbar__filter-chevron" aria-hidden="true"></span>
            </button>
        </div>
    </div>
<?php endif; ?>
<script>
    require([
        'jquery'
    ], function ($) {
        'use strict';
        if ($('.layered-filter-block-container').length == 0) {
            $('.infinite-loader').hide();
            $('.toolbar.toolbar-products').show();
        }
    });
</script>
