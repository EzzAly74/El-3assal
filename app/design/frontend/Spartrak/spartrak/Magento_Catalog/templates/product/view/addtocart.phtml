/**
 * ===========================================================================
 * SPARTRAK — WHY THIS FILE IS A COPY OF PORTO'S
 * ===========================================================================
 * The ONLY change against
 * app/design/frontend/Smartwave/porto/Magento_Catalog/templates/product/view/
 * addtocart.phtml is the quantity field: Porto renders <input type="number">
 * plus its own +/- stepper, and Figma (526:23400, value 705:30188 beside
 * chevron 705:30491) draws a dropdown. Everything else below — the Smartwave
 * daily-deal countdown, the redirect-to-cart branch, the validation bootstrap
 * — is Porto's, byte for byte, because CLAUDE.md §2 keeps Porto's behaviour
 * wherever Figma does not override it.
 *
 * The field is inline markup in the middle of that template, so there is no
 * way to replace it without owning the file. Taking the copy is the cost of
 * the change; the alternative — rewriting the control in JavaScript after
 * Porto's input has already painted — would add script to the PDP's critical
 * path, shift layout, and break with scripting off (CLAUDE.md §4, §9).
 *
 * Both blocks that use this template (product.info.addtocart and
 * product.info.addtocart.additional) pick it up through theme fallback, so
 * the two never disagree.
 */

// phpcs:disable

/** @var $block \Magento\Catalog\Block\Product\View */
/** @var \Magento\Framework\Escaper $escaper */
?>
<?php $_product = $block->getProduct(); ?>
<?php $buttonTitle = __('Add to Cart'); ?>
<?php $dailydealhelper=$this->helper('Smartwave\Dailydeals\Helper\Data'); ?>
<?php if ($_product->isSaleable()): ?>
<div class="box-tocart">
    <?php if($block->getRequest()->getParam('dailydealproduct') || $dailydealhelper->isDealProduct($_product->getId())) : ?>
       <?php $productSku=$_product->getSku(); ?>
    <input type="text" id="todate" value="<?php echo $dailydealhelper->getDailydealToDate($productSku); ?>" style="display:none;" >
    <input type="text" style="display: none;" id="fromdate" value="<?php echo $dailydealhelper->getDailydealFromDate($productSku); ?>">
    <p id="countdown"></p>
    <div class="sw-dailydeal-wrapper">
      <div class="sw-dailydeal">
        <?php if($block->getRequest()->getParam('dailydealproduct')) :?>
            <p id="expired"></p>
        <?php endif; ?>
        <div class="countdowncontainer" style="display:none;">
            <span class="dailydeal-label">
                <?= $escaper->escapeHtml(__('Offer Ends In:')); ?>
            </span>
            <span class="number-wrapper">
                <div class="line"></div>
                <span class="number day"><p id="countdown_days"></p></span>
                <div class="caption"><?= $escaper->escapeHtml(__('Days')); ?></div>
            </span>

            <span class="number-wrapper">
                <div class="line"></div>
                <span class="number hour"><p id="countdown_hours"></p></span>
                <div class="caption"><?= $escaper->escapeHtml(__('Hours')); ?></div>
            </span>

