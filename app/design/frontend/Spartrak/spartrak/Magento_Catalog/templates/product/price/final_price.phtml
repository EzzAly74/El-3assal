<?php
/**
 * Spartrak — final price render (Phase 6).
 *
 * Overrides Smartwave/porto's Magento_Catalog/templates/product/price/
 * final_price.phtml. This is the ONE place price ever renders across the
 * whole site (PDP, PLP/category grid, search results, Homepage Featured
 * Products all route through Magento\Framework\Pricing\Render to this
 * template) — confirmed in Phase 6 discovery that no "call for price"/
 * zero-price fallback hook existed anywhere in the codebase before this.
 *
 * Every imported product currently has price=0.00 (real pricing data
 * does not exist yet — 16-ARCHITECTURE-DECISIONS.md). Rather than
 * display a fabricated "EGP 0.00" as if it were a real price, a zero (or
 * negative) final price short-circuits to a plain, honest, non-fabricated
 * "price on request" fallback and skips the daily-deal/special-price
 * branches entirely (a product with no real price cannot have a real
 * special/deal price either).
 *
 * ASSUMPTION — REQUIRES FIGMA VERIFICATION: the exact fallback copy/
 * styling. No Figma pass has captured a documented "missing price" state
 * (01-FIGMA-AUDIT.md) and no such UI existed anywhere in this codebase to
 * reuse. "Price on request" is a standard, non-fabricating e-commerce
 * convention (states no value, invents no discount) chosen as the
 * documented default until a real design/business decision replaces it.
 *
 * @var \Magento\Catalog\Pricing\Render\FinalPriceBox $block
 */

/** @var \Magento\Framework\Pricing\Price\PriceInterface $priceModel */
$priceModel = $block->getPriceType('regular_price');
/** @var \Magento\Framework\Pricing\Price\PriceInterface $finalPriceModel */
$finalPriceModel = $block->getPriceType('final_price');
$idSuffix = $block->getIdSuffix() ? $block->getIdSuffix() : '';
$schema = ($block->getZone() == 'item_view') ? true : false;

$finalPriceValue = $finalPriceModel->getAmount()->getValue();
?>
<?php if ($finalPriceValue <= 0) : ?>
    <!-- DATA REQUIRED: real price not yet available for this product (price=0.00 in the imported catalog). -->
    <span class="price-container spartrak-price-unavailable">
        <span class="spartrak-price-unavailable__label"><?= $block->escapeHtml(__('Price on request')) ?></span>
    </span>
<?php elseif ($helper = $this->helper('Smartwave\Dailydeals\Helper\Data') and $helper->isDealProduct($block->getSaleableItem()->getId())) : ?>
    <?php $deal_final_price_amount = number_format($helper->getDealproductbyId($block->getSaleableItem()->getId()), 2); ?>
    <span class="old-price">
        <?php /* @escapeNotVerified */ echo $block->renderAmount($finalPriceModel->getAmount(), [
            'display_label'     => __('Regular Price'),
            'price_id'          => $block->getPriceId('old-price-' . $idSuffix),
            'price_type'        => 'oldPrice',
            'include_container' => true,
            'skip_adjustments'  => true
        ]); ?>
    </span>
    <span class="special-price">
        <span class="price-container price-final_price tax weee">
            <span class="price-label">Special Price</span>
            <span id="product-price-<?php echo $idSuffix; ?>" data-price-amount="<?php echo $deal_final_price_amount; ?>" data-price-type="finalPrice" class="price-wrapper ">
                <span class="price"><?php echo $helper->getcurrencySymbol().''.$deal_final_price_amount; ?></span>
            </span>
        </span>
    </span>
<?php elseif ($block->hasSpecialPrice()) : ?>
    <span class="old-price">
        <?php /* @escapeNotVerified */ echo $block->renderAmount($priceModel->getAmount(), [
            'display_label'     => __('Regular Price'),
            'price_id'          => $block->getPriceId('old-price-' . $idSuffix),
            'price_type'        => 'oldPrice',
            'include_container' => true,
            'skip_adjustments'  => true
        ]); ?>
    </span>
    <span class="special-price">
        <?php /* @escapeNotVerified */ echo $block->renderAmount($finalPriceModel->getAmount(), [
            'display_label'     => __('Special Price'),
            'price_id'          => $block->getPriceId('product-price-' . $idSuffix),
            'price_type'        => 'finalPrice',
            'include_container' => true,
            'schema' => $schema
        ]); ?>
    </span>
<?php else : ?>
    <?php /* @escapeNotVerified */ echo $block->renderAmount($finalPriceModel->getAmount(), [
        'price_id'          => $block->getPriceId('product-price-' . $idSuffix),
        'price_type'        => 'finalPrice',
        'include_container' => true,
        'schema' => $schema
    ]); ?>
<?php endif; ?>

<?php if ($finalPriceValue > 0 && $block->showMinimalPrice()) : ?>
    <?php if ($block->getUseLinkForAsLowAs()) : ?>
        <a href="<?php /* @escapeNotVerified */ echo $block->getSaleableItem()->getProductUrl(); ?>" class="minimal-price-link">
            <?php /* @escapeNotVerified */ echo $block->renderAmountMinimal(); ?>
        </a>
    <?php else : ?>
        <span class="minimal-price-link">
            <?php /* @escapeNotVerified */ echo $block->renderAmountMinimal(); ?>
        </span>
    <?php endif; ?>
<?php endif; ?>
