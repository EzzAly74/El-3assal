    font-weight: 700;
}

/* Row 2 — quick-sort chips + sort control (569:13640). */
.spartrak-toolbar__controls {
    display: flex;
    align-self: stretch;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

.spartrak-toolbar__quick {
