// Verbatim from web/images/icons/slider-grip.svg — the byte-exact export of
// Figma node 569:14194, the two grip lines inside a price-slider handle.
$svgSliderGrip = '<svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.5 0V10" stroke="#C3D3F6"/><path d="M5.5 0V10" stroke="#C3D3F6"/></svg>';

// Verbatim from web/images/icons/chevron-down-16.svg — the byte-exact
// export of Figma node 718:25216, the chevron inside the sort control.
$svgChevronDown16 = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6L8 10L12 6" stroke="#1A144F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';

$uriChevronDown16 = $svgUri($svgChevronDown16);
$uriChevronDown20 = $svgUri($svgChevronDown20);
$uriChevronUp20 = $svgUri($svgChevronUp20);
$uriArrow = $svgUri($svgArrow);
$uriSliderGrip = $svgUri($svgSliderGrip);

