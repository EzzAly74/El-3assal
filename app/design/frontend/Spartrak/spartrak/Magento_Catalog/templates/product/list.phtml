    box-shadow: none;
}

/* Mageplaza renders TWO headings: `.filter-title` ("Shop By") and
   `.filter-subtitle` ("Shopping Options"). Figma's sidebar has exactly one
   title and it reads "خيارات التسوق" = Shopping Options, so the subtitle
   becomes the heading and the redundant one is dropped on desktop. It
   stays visible below the collapse breakpoint, where it is the drawer's
   own open/close control. */
@media (min-width: 768px) {
    #layered-filter-block > .block-title.filter-title {
        display: none;
    }
}

/* Source order in the markup is [state, actions, subtitle, options];
   Figma's order is [title, active filters, options]. `order` reflows it
   without touching Mageplaza's template. */
#layered-filter-block > .block-content.filter-content {
    display: flex;
    flex-direction: column;
}

#layered-filter-block .filter-subtitle {
    order: -2;
    display: block;
    margin: 0 0 16px;
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-24);
    font-weight: 700;
    line-height: 1.3;
    text-align: start;
}

#layered-filter-block .filter-current {
    order: -1;
}

#layered-filter-block .filter-actions {
    order: 0;
}

/* Figma 569:14161: 24px above and 24px below each divider, i.e. 48px
   between filter groups with a dashed rule at the midpoint. */
#layered-filter-block .filter-options {
    order: 1;
    display: flex;
    flex-direction: column;
    gap: 48px;
    margin: 0;
    padding: 0;
}

#layered-filter-block .filter-options-item {
    position: relative;
    margin: 0;
    padding: 0;
    border: 0;
}

/* Figma's divider asset (718:25423) is a 1px #CECED2 line with
   stroke-dasharray "2 2". A repeating gradient reproduces that 2-on/2-off
   pattern exactly and costs no request — `border-style: dashed` would not
   (browsers pick their own dash length). */
#layered-filter-block .filter-options-item + .filter-options-item::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: -24px;
    height: 1px;
    background-image: repeating-linear-gradient(
        to right,
        var(--color-border-strong) 0 2px,
        transparent 2px 4px
    );
}

/* Group header (569:14163 / :14222 / :14232 ...): Heading/H5 arabic bold
   16/1.3, with the 20px toggle chevron at the inline-end edge. Both
   chevrons are the real Figma assets. */
#layered-filter-block .filter-options-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 0;
    padding: 0;
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-16);
    font-weight: 700;
    line-height: 1.3;
    text-align: start;
    cursor: pointer;
}

#layered-filter-block .filter-options-title::after {
    display: none;
}

#layered-filter-block .filter-options-title .toggle {
    flex: none;
    width: 20px;
    height: 20px;
    background-image: url('<?= /* @noEscape */ $uriChevronDown20 ?>');
    background-repeat: no-repeat;
    background-position: center;
    background-size: 20px 20px;
}

/* Mageplaza's accordion marks the open group `.active`. */
#layered-filter-block .filter-options-item.active > .filter-options-title .toggle {
    background-image: url('<?= /* @noEscape */ $uriChevronUp20 ?>');
}

#layered-filter-block .filter-options-content {
    margin: 16px 0 0;
    padding: 0;
}

/* Figma 569:14205: 16px between option rows. */
#layered-filter-block .filter-options-content .items {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
}

/* Option row (569:14206). Mageplaza's DOM is [input, a[label, count]],
   which under RTL already resolves to the Figma order without any
   reordering: the control at the inline-start (right) edge, the label
   beside it, the count pill pushed to the far inline-end (left). */
#layered-filter-block .filter-options-content .item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    line-height: 1.3;
}

#layered-filter-block .filter-options-content .item > a {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    font-weight: 500;
    line-height: 1.3;
    text-align: start;
    text-decoration: none;
}

#layered-filter-block .filter-options-content .item > a:hover {
    color: var(--color-action-primary);
}

/* Count pill (718:25410): bg/field, h20, px8, pill, Label/Base 12/1.3. */
#layered-filter-block .count {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    height: 20px;
    padding-inline: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-field);
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-12);
    font-weight: 500;
    line-height: 1.3;
}

#layered-filter-block .filter-count-label {
    display: none;
}

/* Radio (718:25413): 16px, 0.667px border/strong, pill, bg/surface,
   shadow 0 0.667px 1px rgba(44,54,53,.03). Figma documents only the
   UNCHECKED state and has no multi-select control at all, so:
     - :checked reuses the construction the design already uses for a
       selected control in this very frame — the price-slider handle
       (569:14192): action/primary body with a white centre;
     - the checkbox (Mageplaza's multi-select filters) takes radius-4 and a
       solid action/primary fill rather than a checkmark glyph, because no
       checkmark asset exists in Figma and one must not be drawn.
   Both are flagged for a design decision. */
#layered-filter-block .filter-options-content .item > input[type="radio"],
#layered-filter-block .filter-options-content .item > input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    width: 16px;
    height: 16px;
    margin: 0;
    border: .667px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-bg-surface);
    box-shadow: 0 .667px 1px rgba(44, 54, 53, .03);
    cursor: pointer;
}

#layered-filter-block .filter-options-content .item > input[type="checkbox"] {
    border-radius: var(--radius-4);
}

#layered-filter-block .filter-options-content .item > input[type="radio"]:checked {
    border-color: var(--color-action-primary);
    background: var(--color-action-primary)
        radial-gradient(circle at 50% 50%, var(--color-bg-surface) 0 2.5px, transparent 2.5px);
}

#layered-filter-block .filter-options-content .item > input[type="checkbox"]:checked {
    border-color: var(--color-action-primary);
    background: var(--color-action-primary);
}

#layered-filter-block .filter-options-content .item > input:disabled {
    cursor: not-allowed;
    opacity: .5;
}

#layered-filter-block .filter-options-content .item > input:focus-visible,
#layered-filter-block .filter-options-content .item > a:focus-visible,
#layered-filter-block .filter-options-title:focus-visible,
.spartrak-chip:focus-visible,
.spartrak-sorter__select:focus-visible,
.spartrak-plp__pagination .pages a:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
}

/* --- Price range filter — Figma 569:14166 --------------------------- */

/* Figma 569:14167: histogram + track, then 16px, then the min/max inputs.
   The bars and the inputs come from this theme's own
   Mageplaza_LayeredNavigation/templates/layer/filter.phtml override; the
   slider itself is still Mageplaza's jQuery UI widget, untouched. */
#layered-filter-block .ln_slider_container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
    margin: 0;
}

/* Histogram (569:14169): 19 columns of 12px, 80px tall, space-between,
   sitting directly on the track (Figma pulls it down 12px into it).
   Bars inside the selected range take action/primary, bars outside take
   bg/field — exactly the two fills the design uses. */
.spartrak-price-histogram {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 80px;
    margin-block-end: -12px;
    overflow: hidden;
}

/* Figma: 19 columns of exactly 12px inside a 280px row, distributed by
   space-between (280 - 19*12 = 52px spread over 18 gaps). `flex: 0 1 12px`
   keeps that at 280px and lets the columns shrink rather than overflow on a
   narrower drawer. */
.spartrak-price-histogram__bar {
    flex: 0 1 12px;
    max-width: 12px;
    min-height: 2px;
    height: var(--spartrak-bar-height, 2px);
    background: var(--color-action-primary);
}

.spartrak-price-histogram__bar--muted {
    background: var(--color-bg-field);
}

/* Track (569:14189): 24px tall band with a 2px rule; range fill and two
   24px handles. */
#layered-filter-block .ui-slider {
    position: relative;
    height: 2px;
    margin-block: 11px;
    border: 0;
    border-radius: 0;
    background: var(--color-border-default);
}

#layered-filter-block .ui-slider .ui-slider-range {
    position: absolute;
    block-size: 100%;
    border-radius: 0;
    background: var(--color-action-primary);
}

/* Handle (569:14192): 1.5px white outer ring, a 2px action/primary body
   and a white centre carrying the real 6x10 grip asset. Painting order is
   background-colour, then background-image, then the inset shadow on
   top — which is exactly the design's ring-inside-ring construction. */
#layered-filter-block .ui-slider .ui-slider-handle {
    position: absolute;
    inset-block-start: 50%;
    width: 24px;
    height: 24px;
    margin-inline-start: -12px;
    transform: translateY(-50%);
    border: 1.5px solid var(--color-text-inverse);
    border-radius: var(--radius-pill);
    background: var(--color-bg-surface) url('<?= /* @noEscape */ $uriSliderGrip ?>') no-repeat center / 6px 10px;
    box-shadow: inset 0 0 0 2px var(--color-action-primary);
    cursor: pointer;
}

#layered-filter-block .ui-slider .ui-slider-handle:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
}

/* Min/max inputs (569:14202 / 718:25390): two equal columns, 12px apart;
   each is a 12px label above a 40px h input with border/default and
   Shadow/Input. */
.spartrak-price-inputs {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 0;
}

.spartrak-price-inputs__field {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
}

.spartrak-price-inputs__label {
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-12);
    font-weight: 500;
    line-height: 1.3;
    text-align: start;
}

.spartrak-price-inputs__input {
    width: 100%;
    height: 40px;
    padding: 8px 12px;
    border: 1px solid var(--color-border-default);
    border-radius: 0;
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-input);
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    font-weight: 400;
    line-height: 1.5;
    text-align: start;
}

.spartrak-price-inputs__input:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 1px;
}

/* Figma shows no Apply button — the range applies when the field is
   committed. A real submit button is still in the markup so that Enter
   submits reliably and assistive tech has something to activate; it is
   hidden visually only, never with display:none (which would take it out
   of the accessibility tree too). */
.spartrak-price-inputs__submit {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

/* Mageplaza's own range readout. Figma replaces it with the two inputs
   above, so it stays in the DOM (its JS writes to it on every slide) but
   is not shown twice. */
#layered-filter-block [id^="ln_slider_text_"] {
    display: none;
}

/* --- Swatch-based filters (e.g. Brand) ----------------------------- */
/* NO FIGMA REFERENCE: every filter group in Figma's sidebar is collapsed,
   so no option styling exists for an image-swatch filter. These are laid
   out to the same language as the rest of the sidebar — bordered tiles on
   bg/surface — and flagged for a Figma pass. */
#layered-filter-block .swatch-attribute-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
}

#layered-filter-block .swatch-option-link-layered {
    display: block;
    text-decoration: none;
}

#layered-filter-block .swatch-option.image {
    width: 56px;
    height: 40px;
    margin: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-4);
    background-color: var(--color-bg-surface);
    background-size: contain !important;
}

#layered-filter-block .swatch-option.image:hover,
#layered-filter-block .swatch-option-link-layered:focus-visible .swatch-option.image {
    border-color: var(--color-action-primary);
}

/* --- Category list block ------------------------------------------- */
/* Porto moves .block-category-list into the sidebar above the filters
   with its own inline script. It is real navigation and Figma's sidebar
   does not include it, so it is kept and styled to the sidebar's own
   language rather than hidden — flagged as a design decision. */
.sidebar-main .block-category-list {
    margin: 0 0 16px;
    padding: 8px;
    border-radius: var(--radius-4);
    background: var(--color-bg-surface-subtle);
}

.sidebar-main .block-category-list .block-title strong {
    display: block;
    margin: 0 0 12px;
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-16);
    font-weight: 700;
    line-height: 1.3;
}

.sidebar-main .block-category-list .items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.sidebar-main .block-category-list .item {
    margin: 0;
    padding: 0;
}

.sidebar-main .block-category-list .item a {
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
}

.sidebar-main .block-category-list .item a:hover {
    color: var(--color-action-primary);
}

/* Active filter chips (Magento_LayeredNavigation state.phtml) and
   "Clear All". Neither is in the Figma sidebar, so both keep the
   token-consistent treatment the theme already gave them. */
#layered-filter-block .filter-current,
#layered-filter-block .filter-actions {
    margin-block-end: 24px;
}

#layered-filter-block .filter-actions .filter-clear {
    display: inline-block;
    color: var(--color-action-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    text-decoration: none;
}

#layered-filter-block .filter-actions .filter-clear:hover {
    text-decoration: underline;
}

/* -------------------------------------------------------------------
   6. Below the collapse breakpoint
   NO FIGMA REFERENCE — documented default (the file's only mobile frame
   is the header).

   THE OFF-CANVAS DRAWER IS NOT REBUILT HERE. Porto already ships a
   working one: its category/config.phtml binds `.sidebar-toggle`, injects
   `.sidebar-overlay`, and toggles `sidebar-opened` on <html>, against the
   `.mobile-sidebar` class its own layout puts on this sidebar — all of it
   confirmed live in the page's own markup. Re-implementing a second
   drawer on #layered-filter-block would mean two mechanisms fighting over
   the same element, which is exactly the duplication CLAUDE.md section 2
   forbids. So this block only does what Porto does not: unstack the flex
   columns and give Porto's own toggle button the design's chip treatment.

   767px is used instead of the 440px the old _plp.less rule used: 440 is
   the Figma MOBILE FRAME WIDTH, not a switch point, and keying off it
   left every viewport from 441 to 1439 rendering a 296px desktop sidebar
   inside a phone — the same defect _breakpoints.less records for the
   header.
   ------------------------------------------------------------------- */
@media (max-width: 767px) {
    .page-layout-2columns-left .columns {
        display: block;
    }

    .page-layout-2columns-left .columns .sidebar-main,
    .page-layout-2columns-left .columns .sidebar-additional {
        width: auto;
        max-width: none;
    }

    .spartrak-toolbar .porto-product-filters-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 40px;
        padding-inline: 16px;
        border: 1px solid var(--color-border-default);
        border-radius: var(--radius-pill);
        background: var(--color-bg-surface);
        box-shadow: var(--shadow-input);
        color: var(--color-text-primary);
        font-family: var(--font-arabic);
        font-size: var(--text-14);
        font-weight: 500;
        text-decoration: none;
    }

    .spartrak-toolbar .porto-product-filters-toggle svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: var(--color-icon-default);
        stroke-width: 1.5px;
    }

    .spartrak-plp__pagination {
        margin-block-start: 32px;
    }

    .spartrak-plp__pagination .pages .pages-item-previous > a,
    .spartrak-plp__pagination .pages .pages-item-next > a {
        min-width: 0;
        padding-inline: 12px 16px;
    }
}

@media (prefers-reduced-motion: reduce) {
    #layered-filter-block {
        transition: none;
    }
}
</style>
<?php if (!$_productCollection->count()) : ?>
    <div class="message info empty spartrak-plp__empty">
        <div><?= $block->escapeHtml(__('We can\'t find products matching the selection.')) ?></div>
    </div>
<?php else : ?>
    <div class="spartrak-plp__toolbar"><?= $block->getToolbarHtml() ?></div>
    <?= $block->getAdditionalHtml() ?>
    <ol class="spartrak-plp__grid" style="--spartrak-plp-columns: <?= (int) $gridColumns ?>;">
        <?php $cardIndex = 0; ?>
        <?php foreach ($_productCollection as $_product) : ?>
            <li class="spartrak-plp__item">
                <?= $block->getLayout()->createBlock(Template::class)
                    ->setTemplate('Spartrak_Catalog::product/card.phtml')
                    ->setData('list_block', $block)
                    ->setData('product', $_product)
                    ->setData('index', $cardIndex)
                    ->toHtml() ?>
            </li>
            <?php $cardIndex++; ?>
        <?php endforeach; ?>
    </ol>
    <?php if ($_inscroll && $_inscrollAjax) : ?>
        <?php
        /*
         * KNOWN GAP, LEFT AS-IS DELIBERATELY. Gated by the admin's own
         * layered_navigation/general/infinite_scroller flag, so it only
         * appears if a merchant switched it on. If they do: AjaxLayer's
         * append path looks for `.products.wrapper .product-items` in the
         * response and this grid does not emit Porto's lister markup, so
         * items will not append. That is not worth "fixing" by adopting
         * Porto's classes — doing so would pull Porto's entire
         * _listings.less onto this grid and start exactly the specificity
         * war CLAUDE.md section 9 forbids. Figma specifies NUMBERED
         * PAGINATION (569:14143), which is implemented below, so the
         * correct resolution is to leave infinite_scroller OFF.
         */
        ?>
        <div class="infinite-loader<?php if ($_inscroll_mode == '2') : ?> scrolling<?php endif; ?>">
            <a href="javascript:void(0)" class="loading" style="display: none;"><?= $block->escapeHtml(__('Loading ...')) ?></a>
            <a href="javascript:void(0)" class="btn-load-more"><?= $block->escapeHtml(__('Load More ...')) ?></a>
        </div>
    <?php endif; ?>
    <?php if ($toolbarBlock) : ?>
        <div class="spartrak-plp__pagination"><?= /* @noEscape */ $toolbarBlock->getPagerHtml() ?></div>
    <?php endif; ?>
    <?php if (!$block->isRedirectToCartEnabled()) : ?>
        <script type="text/x-magento-init">
        {
            "[data-role=tocart-form], .form.map.checkout": {
                "catalogAddToCart": {}
            }
        }
        </script>
    <?php endif; ?>
<?php endif; ?>
