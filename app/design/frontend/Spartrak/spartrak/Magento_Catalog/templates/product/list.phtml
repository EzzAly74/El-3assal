<?php
/**
 * Spartrak — PLP / category / search product grid.
 *
 * Overrides Smartwave/porto's Magento_Catalog/templates/product/list.phtml
 * (the Magento\Catalog\Block\Product\ListProduct template — also the
 * template catalogsearch/result reuses, so this one file covers category
 * browsing and search results alike).
 *
 * REUSED FROM PORTO / MAGENTO, UNCHANGED IN SUBSTANCE: the toolbar and
 * pager child blocks (see this theme's own product/list/toolbar.phtml for
 * the toolbar's Figma pass), getAdditionalHtml(), the infinite-loader
 * markup gated by the same layered_navigation/general/* admin config Porto
 * reads, and the core catalogAddToCart AJAX init. That preserves Mageplaza
 * AjaxLayer's working partial-page filter/sort/paginate pipeline — nothing
 * about it is replaced. AjaxLayer swaps the contents of ITS OWN
 * #layer-product-list wrapper, so every element below is replaced and
 * re-initialised cleanly on each filter, sort or paginate.
 *
 * STYLES LIVE IN LESS. This template used to carry a ~34 KB inline <style>
 * block and five icons as data: URIs, re-sent inside every category and
 * search response AND again inside every AjaxLayer response. It was always
 * marked TEMPORARY: it existed so the Figma pass could be reviewed by
 * uploading .phtml only. The rules are now in
 * web/css/source/components/_plp.less, compiled into
 * spartrak-components.css and fetched once; the five icons are ordinary
 * cacheable requests against assets this theme already shipped. Same move
 * already made for _product-card.less and _pdp.less.
 *
 * THIS REQUIRES `setup:static-content:deploy` + a cache flush. Until that
 * runs, the category and search pages render unstyled.
 *
 * TOOLBAR RENDERS ONCE. Magento's convention is to call getToolbarHtml()
 * twice and let CSS hide half of each copy — which is why this page used to
 * show two identical sorter/limiter/view-as clusters, and why `#sorter`
 * appeared twice in the DOM. Instead the toolbar is rendered once at the
 * top and the PAGER is pulled out of it and rendered on its own at the
 * bottom, where Figma puts it (node 569:14143). No duplicate controls, no
 * duplicate element IDs, nothing hidden with CSS.
 *
 * --- FIGMA PASS 2026-08-26 -------------------------------------------
 * Read live via the Figma MCP server (file 6FRlQfPIncVUvNiJLn2kbT). The
 * PLP lives inside the "Explore" section, node 569:13630:
 *
 *   Product Section   569:13631   1344 wide inside a 1440 frame (48px gutters)
 *   Product Grid      569:13632   1024 wide
 *   Filter Sidebar    569:14157   296 wide, 24px away from the grid
 *   toolbar block     569:13635   see product/list/toolbar.phtml
 *   Product Cards     569:13666   4 columns, column-gap 16, row-gap 24
 *                                 (card x: 0/261/522/783, y: 0/412/824,
 *                                  card 245x388 -> 261-245 = 16, 412-388 = 24)
 *   Pagination        569:14143   48px below the grid
 *
 * ICONS ARE INLINED, NOT LINKED. Every icon used below is the byte-exact
 * SVG this theme already carries in web/images/icons/ (each one itself
 * byte-compared against the matching Figma export during this pass), but it
 * is embedded as a data: URI instead of referenced through
 * getViewFileUrl(). Two reasons:
 *   1. this storefront runs in production mode (static URLs carry a
 *      version stamp), so a linked icon 404s until someone runs
 *      setup:static-content:deploy — which is exactly what the brief asked
 *      to avoid; and
 *   2. it removes 4 render-blocking-adjacent image requests from the PLP
 *      critical path for ~2 KB of CSS (CLAUDE.md section 13, "fewer network
 *      requests" over "smaller assets" at this size).
 * Nothing is redrawn: the path data, stroke widths, fills and viewBoxes are
 * copied verbatim from the theme's own files.
 *
 * NOT CHANGED HERE, DELIBERATELY: the page container width. Figma's content
 * band is 1344px inside a 1440 viewport; this storefront's container is
 * Porto's `layout-1220` -> max-width 1420px (_porto-chrome.less). That is a
 * SITE-WIDE decision affecting the header, homepage and every other page
 * already signed off, so it is not quietly re-cut from a PLP template. The
 * two-column split below is expressed the way Figma expresses it — a fixed
 * 296px sidebar and a 24px gutter, main column takes the rest — so the
 * proportions hold at any container width.
 *
 * MOBILE: Figma has no mobile PLP frame (its only mobile frame is the
 * header, 440 wide). The breakpoints below are documented defaults built on
 * Magento's own @screen__m/@screen__l stops, not invented numbers.
 *
 * @var $block \Magento\Catalog\Block\Product\ListProduct
 */

use Magento\Framework\View\Element\Template;

$_productCollection = $block->getLoadedProductCollection();
$_portohelper = $this->helper('Smartwave\Porto\Helper\Data');
$_category_grid_config = $_portohelper->getConfig('porto_settings/category_grid');
$_inscrollAjax = $_portohelper->getConfig('layered_navigation/general/ajax_enable');
$_inscroll = $_portohelper->getConfig('layered_navigation/general/infinite_scroller');
$_inscroll_mode = $_portohelper->getConfig('layered_navigation/general/infinite_mode');
$gridColumns = isset($_category_grid_config['columns']) && $_category_grid_config['columns']
    ? (int) $_category_grid_config['columns']
    : 4;

/**
 * The toolbar's own pager child, rendered separately at the bottom of the
 * grid. getChildBlock('toolbar') is the same alias getToolbarHtml() uses,
 * so this resolves on category and search pages alike.
 */
$toolbarBlock = $block->getChildBlock('toolbar');
?>
<?php if (!$_productCollection->count()) : ?>
    <?php /*
        NOTHING MATCHED — the shared Spartrak empty state.

        This was Magento's `.message.info.empty` box: a yellow strip reading
        "لا توجد منتجات مطابقة لاختيارك." with nothing to do next. It now renders
        the same panel the search page's no-results state does — illustration,
        title, one sentence, one way out — from components/_empty-state.less's
        `--nothing-found` variant (Figma 1368:39180). One panel for both
        surfaces, because it is the same situation stated about a different
        collection.

        THE HEADING IS A <strong>, NOT AN <h1>, and that is the one difference
        from the search page's copy of this markup: a category page already has
        an <h1> — the hero title, see components/_category-top.less — so a
        second one here would be a duplicate landmark. The search page has no
        other heading, which is why its version is an h1.

        `spartrak-plp__empty` IS GONE from this element, not merely unstyled: it
        carried its own padding and grey background at one-class specificity, so
        alongside the panel the winner would have been decided by stylesheet
        order. Its rule is deleted from _plp.less rather than left to lose a
        cascade race.

        The words are this template's own. Core's phrase is kept verbatim as the
        title — already translated in this theme's ar_EG.csv, and it says the
        true thing, that the SELECTION matched nothing, which is the part a
        shopper who has applied filters needs to read. The sentence beneath it
        is the actionable half.
    */ ?>
    <div class="spartrak-empty-state spartrak-empty-state--nothing-found">
        <span class="spartrak-empty-state__art spartrak-empty-state__art--nothing-found" aria-hidden="true"></span>

        <div class="spartrak-empty-state__message">
            <div class="spartrak-empty-state__copy">
                <strong class="spartrak-empty-state__title">
                    <?= $block->escapeHtml(__('We can\'t find products matching the selection.')) ?>
                </strong>

                <p class="spartrak-empty-state__text">
                    <?= $block->escapeHtml(__('Try adjusting or removing some of your filters.')) ?>
                </p>
            </div>

            <a class="spartrak-empty-state__action spartrak-empty-state__action--primary"
               href="<?= $block->escapeUrl($block->getBaseUrl()) ?>">
                <?= $block->escapeHtml(__('Go to homepage')) ?>
            </a>
        </div>
    </div>
<?php else : ?>
    <div class="spartrak-plp__toolbar"><?= $block->getToolbarHtml() ?></div>
    <?= $block->getAdditionalHtml() ?>
    <ol class="spartrak-plp__grid" style="--spartrak-plp-columns: <?= (int) $gridColumns ?>;">
        <?php $cardIndex = 0; ?>
        <?php foreach ($_productCollection as $_product) : ?>
            <li class="spartrak-plp__item">
                <?= $block->getLayout()->createBlock(Template::class)
                    ->setTemplate('Spartrak_Catalog::product/card.phtml')
                    ->setData('list_block', $block)
                    ->setData('product', $_product)
                    ->setData('index', $cardIndex)
                    ->toHtml() ?>
            </li>
            <?php $cardIndex++; ?>
        <?php endforeach; ?>
    </ol>
    <?php if ($_inscroll && $_inscrollAjax) : ?>
        <?php
        /*
         * KNOWN GAP, LEFT AS-IS DELIBERATELY. Gated by the admin's own
         * layered_navigation/general/infinite_scroller flag, so it only
         * appears if a merchant switched it on. If they do: AjaxLayer's
         * append path looks for `.products.wrapper .product-items` in the
         * response and this grid does not emit Porto's lister markup, so
         * items will not append. That is not worth "fixing" by adopting
         * Porto's classes — doing so would pull Porto's entire
         * _listings.less onto this grid and start exactly the specificity
         * war CLAUDE.md section 9 forbids. Figma specifies NUMBERED
         * PAGINATION (569:14143), which is implemented below, so the
         * correct resolution is to leave infinite_scroller OFF.
         */
        ?>
        <div class="infinite-loader<?php if ($_inscroll_mode == '2') : ?> scrolling<?php endif; ?>">
            <a href="javascript:void(0)" class="loading" style="display: none;"><?= $block->escapeHtml(__('Loading ...')) ?></a>
            <a href="javascript:void(0)" class="btn-load-more"><?= $block->escapeHtml(__('Load More ...')) ?></a>
        </div>
    <?php endif; ?>
     <?php if ($toolbarBlock) : ?>
        <?php /*
          Two classes, two jobs. `spartrak-pagination` is the shared control
          (components/_pagination.less) — the same one the order list and the
          wishlist now carry; `spartrak-plp__pagination` is only this page's
          48px of space above it.
        */ ?>
        <?php /*
          `data-spartrak-nav-loader` OPTS THE PAGER INTO THE PROJECT LOADER.
          Paging reloads the page with a different slice of the same grid, so a
          shopper IS waiting on the result - the same case as sorting and
          filtering (see this theme's product/list/toolbar.phtml and
          Mageplaza_LayeredNavigation::layer/filter.phtml, the other two
          opt-ins). js/spartrak-nav-pending.js records why the default is off.

          ON THIS WRAPPER, and it has to be: the pager markup itself comes from
          core's Magento_Theme::html/pager.phtml, which is vendor and not ours
          to fork for one attribute. This div is the theme's own and holds the
          whole control, so scoping here needs no core change.
        */ ?>
        <div class="spartrak-plp__pagination spartrak-pagination" data-spartrak-nav-loader>
            <?= /* @noEscape */ $toolbarBlock->getPagerHtml() ?>
        </div>
    <?php endif; ?>
    <?php if (!$block->isRedirectToCartEnabled()) : ?>
        <script type="text/x-magento-init">
        {
            "[data-role=tocart-form], .form.map.checkout": {
                "catalogAddToCart": {}
            }
        }
        </script>
    <?php endif; ?>
<?php endif; ?>
