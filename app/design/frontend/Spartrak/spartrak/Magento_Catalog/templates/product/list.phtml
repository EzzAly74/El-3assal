/**
 * Inline-asset helper. Wraps an SVG source string as a data: URI usable in
 * a CSS url(). rawurlencode keeps it valid inside url('...') under every
 * browser, including the '#' that would otherwise terminate the URI.
 */
$svgUri = static function (string $svg): string {
    return 'data:image/svg+xml;charset=utf-8,' . rawurlencode($svg);
};

