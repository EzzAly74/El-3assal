    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

/* The sort control is pushed to the inline-end edge with an auto margin
   rather than space-between, so the row still lays out correctly when no
   quick-sort chip is available to render (see toolbar.phtml's header). */
.spartrak-toolbar__sort {
    margin-inline-start: auto;
}

/* Chips (569:13647 / :13653 / :13660): h40, px16, gap 8, 1px
   border/default, bg/surface, SQUARE corners, Shadow/Input,
   Label/Large 14/1.3. DOM is [icon, label] so the icon sits at the
   inline-start edge — the right under RTL, matching the design. */
.spartrak-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    padding-inline: 16px;
    border: 1px solid var(--color-border-default);
    border-radius: 0;
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-input);
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
}

.spartrak-chip__icon {
    display: block;
    flex: none;
    width: 16px;
    height: 16px;
}

.spartrak-chip:hover {
    border-color: var(--color-border-strong);
}

/* Figma has no "selected chip" variant. This is the same navy the design
   already uses for the selected pagination page and the slider handles —
   the design system's own "this one is active" colour — not a new
   invented treatment. */
.spartrak-chip--active {
    border-color: var(--color-action-primary);
    color: var(--color-action-primary);
}

/* Sort control (569:13641 / :13642 / :13643): h40, px20, same border and
   shadow, square corners; chevron 16px at 6px from the text. DOM is
   [text, chevron] so the chevron lands at the inline-end edge (the left
   under RTL). Label and <select> sit inline inside one span so the space
   between "Sort:" and the current value is a real text space, as it is in
   Figma's single text node. */
.spartrak-sorter {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding-inline: 20px;
    border: 1px solid var(--color-border-default);
    border-radius: 0;
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-input);
}

.spartrak-sorter__text {
    display: inline;
    white-space: nowrap;
}

.spartrak-sorter__label,
.spartrak-sorter__select {
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    font-weight: 500;
    line-height: 1.3;
    vertical-align: middle;
}

.spartrak-sorter__label {
    margin: 0;
    cursor: pointer;
}

/* The native [data-role=sorter] control, chrome removed. Keeping the real
   <select> is what keeps productListToolbarForm — and therefore sorting —
   working untouched, and it gives keyboard and screen-reader support for
   free that a custom dropdown would have to re-implement. */
.spartrak-sorter__select {
    appearance: none;
    -webkit-appearance: none;
    width: auto;
    height: auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    cursor: pointer;
}

.spartrak-sorter__chevron {
    flex: none;
    width: 16px;
    height: 16px;
    background-image: url('<?= /* @noEscape */ $uriChevronDown16 ?>');
    background-repeat: no-repeat;
    background-position: center;
    background-size: 16px 16px;
}

/* Porto's mobile filter toggle — below the collapse breakpoint only. */
.spartrak-toolbar .porto-product-filters-toggle {
    display: none;
}

/* -------------------------------------------------------------------
   4. Pagination — Figma 569:14143
   Magento's own pager markup, restyled, rendered once below the grid.
   Magento's DOM order is [previous, pages, next], which under RTL puts
   Previous on the right and Next on the left — exactly the design — and
   mirrors correctly for LTR.
   ------------------------------------------------------------------- */
.spartrak-plp__pagination .pages {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    padding: 0;
    text-align: start;
}

/* "Page" / "You're currently reading page" — real screen-reader text the
   design does not show. Hidden visually, kept for assistive tech. */
