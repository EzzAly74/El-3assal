/* Prev/Next pills (569:14144 / :14154): bg/field, pill, h40, min-width 92,
   gap 8. Figma's padding is 20px on one physical edge and 16px on the
   other; expressed logically that is the same `padding-inline: 16px 20px`
   for both pills, and it mirrors for LTR. The arrow is drawn on ::after
   for Next and ::before for Previous, which is what places each one on the
   correct side under either direction. */
.spartrak-plp__pagination .pages .pages-item-previous > a,
.spartrak-plp__pagination .pages .pages-item-next > a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 92px;
    height: 40px;
    padding-inline: 16px 20px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-bg-field);
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
}

.spartrak-plp__pagination .pages .pages-item-previous > a:hover,
.spartrak-plp__pagination .pages .pages-item-next > a:hover {
    background: var(--color-border-default);
}

.spartrak-plp__pagination .pages .pages-item-next > a::after,
.spartrak-plp__pagination .pages .pages-item-previous > a::before {
    content: "";
    flex: none;
    width: 16px;
    height: 16px;
    background-image: url('<?= /* @noEscape */ $uriArrow ?>');
    background-repeat: no-repeat;
    background-position: center;
    background-size: 16px 16px;
    transform: var(--spartrak-arrow-rotate, rotate(0deg));
}

/* The arrow points toward physical right. "Next" must point toward the
   inline-END of the reading direction and "Previous" toward the
   inline-START, so exactly one of the two is rotated — and which one
   swaps with the document direction. No logical equivalent of `rotate`
   exists, so this keys off <html dir>, the precedent this theme already
   set for the PLP filter drawer. */
.spartrak-plp__pagination .pages .pages-item-previous > a::before {
    --spartrak-arrow-rotate: rotate(180deg);
}

html[dir="rtl"] .spartrak-plp__pagination .pages .pages-item-next > a::after {
    --spartrak-arrow-rotate: rotate(180deg);
}

html[dir="rtl"] .spartrak-plp__pagination .pages .pages-item-previous > a::before {
    --spartrak-arrow-rotate: rotate(0deg);
}

