<style>
/* ===================================================================
   Spartrak — PLP: layout, grid, toolbar, pagination, filter sidebar.
   Figma 569:13630 (Explore) / 569:13635 / 569:14143 / 569:14157.
   TEMPORARY inline home; final home is components/_plp.less.
   =================================================================== */

:root {
    /* Figma semantic role `border/subtle` (#f3f3f4). Resolves to a
       primitive this theme already ships, but the SEMANTIC alias does not
       exist yet — PROMOTE into foundations/_semantic.less with the CSS. */
    --color-border-subtle: var(--primitive-field-bg);

    /* Figma "Shadow/Input" / "Input field": DROP_SHADOW #2C363506
       offset(0,1) radius 1.5. Written as box-shadow rather than
       filter: drop-shadow() — identical on an opaque rectangle, without
       forcing a compositing layer per element. */
    --shadow-input: 0 1px 1.5px rgba(44, 54, 53, 0.03);
}

/* -------------------------------------------------------------------
   1. Two-column shell — Figma 569:13631
   Grid 1024 | 24px gutter | sidebar 296, inside a 1344 band.
   `order` puts the sidebar first in the flex line, which resolves to the
   right under RTL (as designed) and to the left for an LTR store — the
   2columns-left layout this page already uses.

   Porto also drops two overlay elements straight into .columns
   (.sidebar-overlay for the mobile drawer, #ln_overlay for Mageplaza's
   AJAX spinner). They are real, working elements, but as flex children
   they would each claim a column, so they are taken out of flow here
   rather than removed.
   ------------------------------------------------------------------- */
.page-layout-2columns-left .columns {
    display: flex;
    align-items: flex-start;
    gap: 24px;
}

.page-layout-2columns-left .columns .column.main {
    flex: 1 1 0;
    min-width: 0;
    width: auto;
    padding: 0;
    order: 2;
}

.page-layout-2columns-left .columns .sidebar-main {
    flex: 0 0 296px;
    width: 296px;
    max-width: 296px;
    padding: 0;
    order: 1;
}

.page-layout-2columns-left .columns .sidebar-additional {
    flex: 0 0 296px;
    width: 296px;
    padding: 0;
    order: 3;
}

.page-layout-2columns-left .columns > .sidebar-overlay,
.page-layout-2columns-left .columns > #ln_overlay {
    position: absolute;
}

/* Porto's page layout wraps the sidebar's blocks in .sidebar-content, and
   its sidebar-sticky script (Smartwave_Porto/templates/html/
   sidebar_sticky.phtml, gated by porto_settings/general/sidebar_sticky)
   wraps THAT in .pin-wrapper and writes inline width/height onto both.
   Neither wrapper should introduce geometry of its own. NOTE: the inline
   styles that script writes cannot be undone from CSS without
   !important — turn `Sidebar Sticky` off in the Porto admin section to
   stop them being written at all. Figma's sidebar is a plain column, not
   a sticky one, and dropping the script also drops a scroll handler that
   reads offsets on every frame. */
.page-layout-2columns-left .columns .sidebar-main .sidebar-content,
.page-layout-2columns-left .columns .sidebar-main .pin-wrapper {
    display: block;
    max-width: 100%;
}

/* -------------------------------------------------------------------
   2. Product grid — Figma 569:13666
   4 columns, column-gap 16, row-gap 24. Cards stretch to a common row
   height (the design equalises its own row 1 the same way — node
   569:13749's content block is stretched by exactly the 29px needed to
   match its taller siblings), with each card's price row pinned to the
   bottom by _product-card's margin-block-start:auto.

   BREAKPOINTS ARE A DOCUMENTED DEFAULT, NOT FROM FIGMA (no mobile PLP
   frame exists). 768px and 1200px are Magento core's own @screen__m and
   @screen__l, the widths at which the rest of this page's chrome already
   flips — the same reasoning _breakpoints.less records for the header.
   ------------------------------------------------------------------- */
.spartrak-plp__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 24px;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
}

.spartrak-plp__item {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
}

@media (min-width: 768px) {
    .spartrak-plp__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (min-width: 1200px) {
    .spartrak-plp__grid {
        grid-template-columns: repeat(var(--spartrak-plp-columns, 4), minmax(0, 1fr));
    }
}

/* Figma: 16px between the toolbar block and the first card row, 48px
   between the last row and the pagination. */
.spartrak-plp__toolbar {
    margin-block-end: 16px;
}

.spartrak-plp__pagination {
    margin-block-start: 48px;
}

/* Empty state — native Magento "message info empty", no Figma frame. */
.spartrak-plp__empty {
    padding: 32px 16px;
    border-radius: var(--radius-10);
    background: var(--color-bg-surface-subtle);
    color: var(--color-text-secondary);
    font-family: var(--font-arabic);
    font-size: var(--text-16);
    text-align: center;
}

/* -------------------------------------------------------------------
   3. Toolbar — Figma 569:13635
   ------------------------------------------------------------------- */
.spartrak-toolbar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
}

/* Row 1 — results heading (569:13636). DOM is [count, label]: under RTL
   the number lands at the inline-start (right) edge with the sentence to
   its left, which is how the design renders. */
.spartrak-toolbar__head {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
}

/* Figma "Heading/H2": arabic bold, size/2xl 24px, line-height 1.3. */
.spartrak-toolbar__count {
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-24);
    font-weight: 700;
    line-height: 1.3;
}

/* Figma "Body/Small": arabic regular 14/1.5 on greyscale/500, with the
   search term itself bold on text/primary (569:13638's own mixed run). */
.spartrak-toolbar__label {
    padding-block-end: 2px;
    color: var(--color-text-secondary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
