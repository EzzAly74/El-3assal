.spartrak-plp__pagination .pages .pages-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.spartrak-plp__pagination .pages .items.pages-items {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
}

.spartrak-plp__pagination .pages .item {
    display: flex;
    margin: 0;
    padding: 0;
}

/* Page circles (569:14148 / :14150 / :14152): 40px, pill, 1px
   border/default, Label/Large 14/1.3 on text/primary. */
.spartrak-plp__pagination .pages .item > .page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-14);
