<?xml version="1.0"?>
<!--
  Search results share the category page's controls exactly — the same
  toolbar, the same sort disclosure, the same filter sidebar and the same
  numbered pager, all of them links — so they share its navigation loader too.

  See Magento_Catalog/layout/catalog_category_view.xml for the full note, and
  js/spartrak-nav-pending.js for why a class on <html> rather than
  `processStart`. Nothing here is search-specific; this file exists only
  because layout handles cannot be shared between two routes without one.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!--
          The category/search stylesheet: components/_plp.less and
          components/_category-top.less, which were part of the render-blocking
          css/spartrak-components.css on every route and match nothing outside
          these two handles. Splitting them out took the global bundle from
          42,404 to 17,328 gzipped bytes; this page pays 18,000 of that back and
          every other route pays none of it. See web/css/spartrak-plp.less.
        -->
        <css src="css/spartrak-plp.css"/>
    </head>
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="spartrak.nav_loader"
                   template="Magento_Theme::html/nav-loader.phtml"/>
        </referenceContainer>

        <!--
          Porto's `Magento_Catalog::category/config.phtml`, which its own
          Magento_CatalogSearch/layout/catalogsearch_result_index.xml declares
          on this handle exactly as it does on the category one.

          Dead on both, and its sticky-toolbar half threw
          "Cannot read properties of undefined (reading 'top')" on every scroll
          frame below 992px. The full reasoning — both halves, why the selector
          cannot match Spartrak's markup, and why Porto's file is neither edited
          nor copied — is written out once in this theme's
          Magento_Catalog/layout/catalog_category_view.xml. A block added on a
          handle can only be removed on a handle that is also loaded, which is
          why the removal is repeated here rather than shared.
        -->
        <referenceBlock name="catalog_view_config" remove="true"/>

        <!--
          Core's "Recently Ordered" box (Magento\Sales\Block\Reorder\Sidebar),
          which Magento_Sales/view/frontend/layout/default.xml drops into
          `sidebar.additional` on every route that has that container — this one
          included, since search shares the category page's
          page-layout-2columns-left shell.

          Invisible to guests (that block's _toHtml() returns '' unless the
          customer is authenticated), so it only shows once signed in. Figma
          draws one sidebar on this page, the filter column, and no second one.

          Full reasoning — including why the BLOCK goes and not the container —
          is written out once in this theme's
          Magento_Catalog/layout/catalog_category_view.xml. Repeated here
          because a block declared on the `default` handle has to be removed on
          each handle that renders it.
        -->
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
    </body>
</page>
