<?xml version="1.0"?>
<!--
  Spartrak Phase 5 — Homepage sections.

  cms_index_index is a core Magento handle (not Porto-owned), so no
  module-sequence-ordering concern applies here the way it did for
  porto_header/footer_block in Phase 4 (see that phase's Smartwave_Porto/
  layout/default.xml comments) — this file can safely live under this
  theme's own Magento_Cms bucket.

  SCOPE DECISION: implements ia-and-flows.md's 11-module homepage
  architecture (the documented non-negotiable list), NOT a literal replica
  of the single Figma iteration audited in 01-FIGMA-AUDIT.md, which also
  contains "Flash Deals" (needs discount/sale data), a differentiated
  "New Arrivals" vs "Best Sellers" vs multiple "Top Products" carousels
  (needs real timestamps/sales history to differentiate honestly), and a
  "Buyer Section" not named in ia-and-flows.md's module list at all. None
  of that data exists in the real catalog (no orders, no sale flags, no
  promo data) — building those sections would mean fabricating business
  claims, which is explicitly prohibited. The one Figma-confirmed element
  reused here is the dual-path "Fork Row" (Shop by Machine/Brand selector),
  which maps directly onto real brand/model attribute data already
  imported — see sections.phtml for how.

  Modules 2 (Utility Header), 3 (Search), 4 (Mega Nav), and 11 (Footer)
  are already built in Phase 4 and untouched here. This file adds modules
  1, 5, 6, 7, 8, 9, 10.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="spartrak.homepage_sections" template="Magento_Cms::homepage/sections.phtml" before="-">
                <block class="Magento\Cms\Block\Block" name="spartrak.homepage.promo_strip">
                    <arguments>
                        <argument name="block_id" xsi:type="string">spartrak_homepage_promo_strip</argument>
                    </arguments>
                </block>
                <!--
                  17-FIGMA-CODE-AUDIT.md §2/§3 fix (2026-08-24): Module 5
                  Hero is a real multi-slide carousel in Figma (node
                  595:14562 — 5-dot pagination + arrows), not the single
                  static block this replaced. 5 optional slide blocks (same
                  hide-if-empty convention as everything else) instead of
                  the old spartrak_homepage_hero single block — admins
                  populate 1-5 of them, no deploy needed either way.
                -->
                <block class="Magento\Cms\Block\Block" name="spartrak.homepage.hero_slide_1">
                    <arguments>
                        <argument name="block_id" xsi:type="string">spartrak_homepage_hero_slide_1</argument>
                    </arguments>
                </block>
                <block class="Magento\Cms\Block\Block" name="spartrak.homepage.hero_slide_2">
                    <arguments>
                        <argument name="block_id" xsi:type="string">spartrak_homepage_hero_slide_2</argument>
                    </arguments>
                </block>
                <block class="Magento\Cms\Block\Block" name="spartrak.homepage.hero_slide_3">
                    <arguments>
                        <argument name="block_id" xsi:type="string">spartrak_homepage_hero_slide_3</argument>
                    </arguments>
                </block>
                <block class="Magento\Cms\Block\Block" name="spartrak.homepage.hero_slide_4">
                    <arguments>
                        <argument name="block_id" xsi:type="string">spartrak_homepage_hero_slide_4</argument>
                    </arguments>
                </block>
                <block class="Magento\Cms\Block\Block" name="spartrak.homepage.hero_slide_5">
                    <arguments>
                        <argument name="block_id" xsi:type="string">spartrak_homepage_hero_slide_5</argument>
                    </arguments>
                </block>
                <block class="Magento\Cms\Block\Block" name="spartrak.homepage.trust_strip">
                    <arguments>
                        <argument name="block_id" xsi:type="string">spartrak_homepage_trust_strip</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
