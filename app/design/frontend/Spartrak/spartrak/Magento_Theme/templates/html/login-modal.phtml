        <section class="spartrak-auth__step" data-auth-step="reset-password" hidden>
            <?= /* @noEscape */ $head(
                'reset-password',
                __('Choose a new password'),
                __('Pick a new password for your account.')
            ) ?>

            <form class="spartrak-auth__form" method="post" novalidate
                  data-auth-form
                  data-auth-endpoint="passwordReset"
                  data-auth-next="finish">
                <?= /* @noEscape */ $errorRegion() ?>

                <?= /* @noEscape */ $passwordField(
                    'spartrak-reset-password',
                    'password',
                    __('New password'),
                    __('Please enter your new password'),
