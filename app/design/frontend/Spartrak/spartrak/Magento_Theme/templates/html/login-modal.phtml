        <!-- ============================ Loading ===========================
             Figma 572:15113 / 688:25653. A TRANSITIONAL state, not a
             confirmation — the panel narrows to 400 and pads 40 top and
             bottom, which the stylesheet applies off this step being visible
             rather than via a JS class. -->
        <section class="spartrak-auth__step" data-auth-step="success" hidden>
            <div class="spartrak-auth__success" role="status" aria-live="polite">
                <img class="spartrak-auth__success-icon"
                     src="<?= $block->escapeUrl($block->getViewFileUrl('images/icons/spinner.svg')) ?>"
                     width="80" height="80" alt="" aria-hidden="true" />
                <div class="spartrak-auth__head">
                    <h2 class="spartrak-auth__title" id="spartrak-auth-title-success" data-auth-success-message>
                        <?= $block->escapeHtml(__('One moment please!')) ?>
                    </h2>
                    <?php
                    /**
                     * QA FIX (2026-08-27): this line was a single hardcoded
                     * string — "Your account is being created…" — and this step
                     * is the terminal state of ALL THREE journeys, so signing in
                     * to an account you have had for a year announced that your
                     * account was being created. Reported from the live site.
                     *
                     * The three variants are rendered as data attributes rather
                     * than looked up in JS, so the copy stays translated by
                     * __() in the same place as every other string in this
                     * template (i18n/ar_EG.csv), instead of depending on the JS
                     * translation dictionary being deployed. spartrak-auth.js
                     * picks one from the submitting form's own
                     * `data-auth-endpoint`, which is the only thing that
                     * reliably identifies the journey at that point — the step
                     * id is already 'success' by then.
                     *
                     * The element's own text is the signup copy, so the markup
                     * is still correct with JavaScript disabled or before the
                     * widget initialises.
                     */
                    ?>
                    <p class="spartrak-auth__lede spartrak-auth__lede--loading"
                       data-auth-loading-lede
                       data-lede-login="<?= $block->escapeHtmlAttr(__("You're being signed in. Please don't close this page.")) ?>"
                       data-lede-signup="<?= $block->escapeHtmlAttr(__("Your account is being created. Please don't close this page.")) ?>"
                       data-lede-reset="<?= $block->escapeHtmlAttr(__("Your password is being updated. Please don't close this page.")) ?>">
                        <?= $block->escapeHtml(__("Your account is being created. Please don't close this page.")) ?>
                    </p>
                </div>
            </div>
        </section>
    </div>
</div>
