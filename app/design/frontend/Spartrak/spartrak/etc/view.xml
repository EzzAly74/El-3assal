<?xml version="1.0"?>
<!--
  ===========================================================================
  Spartrak theme view configuration.
  ===========================================================================
  ADDITIVE. A theme's view.xml MERGES with its parent's, so this file declares
  only what Spartrak needs to differ on. Everything else still comes from
  Smartwave/porto and Magento/blank.
-->
<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">
    <media>
        <images module="Magento_Catalog">
            <!--
              ===================================================================
              MINICART THUMBNAIL — 192, BECAUSE THE DRAWER DRAWS IT AT 96
              ===================================================================
              Figma 819:19872 puts a 96x96 image on each cart line. Porto declares
              this role at 100x100, and Magento's Knockout image component writes
              the rendered size inline as `width / 2` — so a 100 here produced a
              50px image sitting inside a 96px frame.

              That inline style cannot be overridden from CSS without
              `!important`, which CLAUDE.md section 9 rules out. It does not need
              to be: the number it prints comes from THIS file. Declaring 192
              makes `width / 2` resolve to exactly the 96 the design asks for.

              The 2:1 ratio is the point rather than a side effect. Magento
              generates and caches a 192px file and the browser paints it into a
              96px box, so the line is sharp on a 2x display while still being a
              small, correctly-sized asset — which is what section 11 asks for,
              and the opposite of shipping a full-size product image to a
              thumbnail slot.
            -->
            <image id="mini_cart_product_thumbnail" type="thumbnail">
                <width>192</width>
                <height>192</height>
            </image>

            <!--
              ===================================================================
              BRAND LOGOS — 270x180, BECAUSE THEY WERE BEING GENERATED AT 30x20
              ===================================================================
              This storefront uses VISUAL SWATCHES for brand logos, not colour
              chips: Spartrak\Catalog\ViewModel\BrandNavigation reads the
              `brand` attribute's per-option swatch image and both the header's
              brand pane and the homepage brand rail render it.

              Magento_Swatches/etc/view.xml declares `swatch_image` at THIRTY BY
              TWENTY PIXELS, which is the right size for the colour chip the
              feature was built for. Magento generates and caches a file at
              exactly that size (Helper\Media::generateSwatchVariations ->
              Image::resize), and this theme then paints it into a 134.779px
              plate on the homepage rail — a 4.5x upscale of a 30px file. That,
              and not the upload format, is why the brand marks looked pixelated.

              Uploading an SVG would not have fixed it: the same resize step runs
              regardless of what was uploaded, so the served file would still be
              30px wide.

              270x180 keeps core's own 3:2 frame exactly — so nothing about how a
              logo is composed inside it changes — and gives it nine times the
              pixels. 270 is the homepage plate (134.779) at 2x, which is the
              largest this asset is ever painted; the header's brand mark is 58px
              and is comfortably covered by the same file.

              The resize is `constrainOnly`, so this is a CEILING and not an
              upscale: a merchant who uploads a 200px mark still gets their 200px
              mark, never a blurry 270px one. It costs nothing on a page that
              does not show swatches, and the generated files are still small.

              Re-generating is not automatic for logos already uploaded — the
              cached variation is keyed by size, so the new one is written on
              first request after a cache flush.
            -->
            <image id="swatch_image" type="swatch_image">
                <width>270</width>
                <height>180</height>
            </image>
        </images>
    </media>
</view>
