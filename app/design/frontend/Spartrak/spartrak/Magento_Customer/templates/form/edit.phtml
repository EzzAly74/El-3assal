<?php
/**
 * "حسابي" — the account information card, EDIT state. Figma 562:17237.
 *
 * ===========================================================================
 * WHAT THIS POSTS TO, AND WHY THAT MATTERS
 * ===========================================================================
 * customer/account/editPost — core's own controller, unchanged. That is what
 * gives this card, for free: email-format and per-website-uniqueness
 * validation, the password confirmation Magento demands before an email
 * change, the session invalidation and credentials-changed notification that
 * follow one, and repopulation of the form from session data after a failed
 * save. A Spartrak controller would have had to reimplement all five.
 *
 * ===========================================================================
 * TWO NAME INPUTS IN ONE BAND — THE ONE STRUCTURAL DEVIATION
 * ===========================================================================
 * Figma draws a single "اسم المستخدم" control holding "Mohamed Ahmed".
 * Magento stores and requires firstname and lastname separately.
 *
 * Collapsing them into one input and splitting the submitted string was
 * rejected: an Arabic name is routinely three or four words
 * ("محمد أشرف الفضالي"), so any split rule assigns the parts wrongly for a
 * large share of real customers, and a single-word entry produces an empty
 * required field. Spartrak_CustomerAuth's Registrar carries the same warning
 * about mangling Arabic names.
 *
 * So the row renders as ONE bordered 48px band containing two segments. That
 * is not an invented pattern — it is the grammar the same card already uses
 * one row below, where the phone number is a band split into a dialling-code
 * segment and a number segment (562:16478). The band reads as the single
 * control Figma draws while each half stays a field Magento can validate.
 *
 * ===========================================================================
 * THERE IS NO PASSWORD FIELD ON THE CARD, AND THAT IS DELIBERATE
 * ===========================================================================
 * Magento will not change an email address without the account's current
 * password (EditPost::processChangeEmailRequest). Figma draws no password
 * field, because at rest none is needed — nothing has changed yet.
 *
 * The password is therefore collected at SUBMIT time, in the dialog at the
 * foot of this file, by js/account-edit — which also injects `change_email`,
 * the flag EditPost reads. An earlier revision instead kept a hidden field on
 * the card and revealed it with js/email-change; that field is gone and so is
 * that script (it had been looking for markup that no longer existed and was
 * silently doing nothing on every render of this page).
 *
 * WITH JAVASCRIPT DISABLED this degrades to exactly the safe outcome:
 * `change_email` is never set, so populateNewCustomerDataObject() restores the
 * stored address and the name still saves. No silent failure, no unverified
 * email change.
 *
 * ===========================================================================
 * THE PHONE IS NOT EDITABLE
 * ===========================================================================
 * See account/dashboard/info.phtml for the full reasoning. It is the sign-in
 * identifier, it is uniquely indexed, and there is no verified change-phone
 * flow in Spartrak_CustomerAuth (Otp\Purpose has only SIGNUP and
 * PASSWORD_RESET) nor a Figma frame for one. It renders in the same read-only
 * treatment the view state uses, so the card still shows all three values.
 *
 * @var \Magento\Customer\Block\Form\Edit $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

use Spartrak\CustomerAccount\ViewModel\Profile;
use Spartrak\CustomerAuth\ViewModel\CustomerEmail;

/** @var Profile|null $profile */
$profile = $block->getData('profile');
/** @var CustomerEmail|null $customerEmail */
$customerEmail = $block->getData('customer_email');

$storedEmail = (string) $block->getCustomer()->getEmail();
$isPlaceholder = $customerEmail !== null && $customerEmail->isPlaceholder($storedEmail);
$emailValue = $isPlaceholder ? '' : $storedEmail;

/** @var \Spartrak\CustomerAuth\ViewModel\AuthConfig|null $authConfig */
$authConfig = $block->getData('auth_config');
// One box per digit, from the same setting the login modal reads. Four is the
// shipped default and only applies if the argument is missing entirely.
$codeLength = $authConfig !== null ? $authConfig->getCodeLength() : 4;
?>
<form class="spartrak-account-card spartrak-account-card--editing form form-edit-account"
      action="<?= $escaper->escapeUrl($block->getUrl('customer/account/editPost')) ?>"
      method="post"
      id="form-validate"
      data-hasrequired="<?= $escaper->escapeHtmlAttr(__('* Required Fields')) ?>"
      autocomplete="off">
    <?= $block->getBlockHtml('formkey') ?>

    <div class="spartrak-account-card__header">
        <div class="spartrak-account-card__heading">
            <h1 class="spartrak-account-card__title"><?= $escaper->escapeHtml(__('My account')) ?></h1>
            <p class="spartrak-account-card__subtitle">
                <?= $escaper->escapeHtml(
                    __('Edit or complete your account details, including how your data is secured.')
                ) ?>
            </p>
        </div>
        <!--
          Save first in the DOM so an RTL row puts it at the reading start,
          which is where Figma draws it — and so a keyboard user reaches the
          affirmative action before the escape hatch.
        -->
        <div class="spartrak-account-card__actions">
            <button type="submit" class="spartrak-account-card__save">
                <?= $escaper->escapeHtml(__('Save changes')) ?>
            </button>
            <a class="spartrak-account-card__cancel"
               href="<?= $escaper->escapeUrl($block->getUrl('customer/account')) ?>">
                <?= $escaper->escapeHtml(__('Cancel')) ?>
            </a>
        </div>
    </div>

    <div class="spartrak-account-card__body">
        <?php /*
          ===================================================================
          ONE FIELD, NOT TWO SEGMENTS
          ===================================================================
          This was a split band — two inputs behind one border with a hairline
          between them — on the reading that "اسم المستخدم" stands for
          Magento's firstname and lastname pair.

          It does not. Figma 821:17286 is a single "Text Input" with a single
          value node, and the read state (562:16395) prints a single joined
          name. The split rendered as two visibly unequal boxes with the name
          broken across them, which is what it looked like on the store.

          So the field is one input, and the pair is reassembled on the way in
          by Spartrak\CustomerAccount\Plugin\Customer\SplitFullName — which is
          also where the single-word case is decided. Posting a joined name and
          splitting server-side keeps Magento's data model intact without
          asking the shopper a question the design does not ask.
        */ ?>
        <div class="spartrak-account-field">
            <label class="spartrak-account-field__label" for="spartrak-account-fullname">
                <?= $escaper->escapeHtml(__('User name')) ?>
            </label>
            <div class="spartrak-account-field__band">
                <input type="text"
                       name="spartrak_fullname"
                       id="spartrak-account-fullname"
                       value="<?= $escaper->escapeHtmlAttr($profile?->getName() ?? '') ?>"
                       autocomplete="name"
                       class="spartrak-account-field__input"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('Please enter your name')) ?>"
                       data-validate="{required:true}">
            </div>
        </div>

        <div class="spartrak-account-field">
            <label class="spartrak-account-field__label" for="email">
                <?= $escaper->escapeHtml(__('Email address')) ?>
            </label>
            <div class="spartrak-account-field__band">
                <input type="email"
                       name="email"
                       id="email"
                       value="<?= $escaper->escapeHtmlAttr($emailValue) ?>"
                       autocomplete="email"
                       class="spartrak-account-field__input"
                       data-input="change-email"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('name@example.com')) ?>"
                       data-validate="{'validate-email':true}">
            </div>
        </div>

        <?php /*
          ===================================================================
          THE PHONE IS EDITABLE HERE, AND VERIFIED BEFORE IT IS SAVED
          ===================================================================
          It used to be a read-only band with "تواصل معنا لتغييره" underneath,
          flagged as awaiting a design. That design exists: Figma 821:17158
          draws this field editable, and its overlay (1078:7263) reads
          "لقد قمنا بارسال رمز التحقق إلى رقم الهاتف الجديد الخاص بك" — a code
          sent to the NEW number.

          `phone_number` is NOT posted with this form. Core's editPost has
          never known the attribute exists, and that is what stops an ungated
          write: the field carries no `name`, so submitting the card cannot
          change the number. The dialog owns the change end to end —
          /phone-auth/otp/send, /phone-auth/otp/verify, then
          /phone-auth/account/phonechange, which is the only writer of the
          attribute (Spartrak\CustomerAuth\Model\Customer\PhoneChanger).

          So the two ways to leave this field disagreeing with the account are
          both closed: pressing حفظ التغييرات ignores it, and changing it for
          real requires the code.
        */ ?>
        <div class="spartrak-account-field"
             data-spartrak-phone-field
             data-current-phone="<?= $escaper->escapeHtmlAttr($profile?->getPhoneE164() ?? '') ?>">
            <label class="spartrak-account-field__label" for="spartrak-account-phone">
                <?= $escaper->escapeHtml(__('Phone number')) ?>
            </label>
            <div class="spartrak-account-field__band">
                <span class="spartrak-account-field__dial"><?= $escaper->escapeHtml(
                    $profile?->getPhoneDialCode() ?? ''
                ) ?></span>
                <input type="tel"
                       id="spartrak-account-phone"
                       class="spartrak-account-field__input"
                       value="<?= $escaper->escapeHtmlAttr($profile?->getPhoneNational() ?? '') ?>"
                       autocomplete="tel"
                       dir="ltr"
                       data-spartrak-phone-input>
            </div>
            <p class="spartrak-account-field__hint" data-spartrak-phone-hint hidden>
                <?= $escaper->escapeHtml(
                    __('We will send a verification code to the new number before saving it.')
                ) ?>
            </p>
        </div>

        <?php /*
          ===================================================================
          THERE IS NO PASSWORD ROW ON THIS CARD — REMOVED 2026-09-03
          ===================================================================
          Figma 821:17342 draws one: eight dots with a تغيير link that opened a
          change-password dialog. It was built, and it is now gone, on an
          explicit product decision — a shopper must not be able to change
          their password from the profile card.

          NOTHING IS LOST TO THE CUSTOMER. Magento's own password flows are
          untouched and still reachable:

            customer/account/edit?changepass=1   the core change-password form
            customer/account/forgotpassword      the reset flow, which on this
                                                 storefront is the OTP one
                                                 (Spartrak_CustomerAuth,
                                                 Otp\Purpose::PASSWORD_RESET)

          So this removes an entry point, not a capability, which is why no
          controller or model changed with it.

          WHAT DID NOT GO WITH IT: the CURRENT-password prompt. Core will not
          change an email address without it
          (Account\EditPost::processChangeEmailRequest), so the dialog below
          keeps its confirm step — one password box, used to authorise an email
          change and nothing else. Deleting that too would have made the email
          field silently unsaveable.
        */ ?>

        <?= $block->getChildHtml('form_additional_info') ?>
    </div>
</form>

<?php /*
  ===========================================================================
  THE CARD'S TWO DIALOGS — Figma 1078:7263 (OTP) and the password prompt
  ===========================================================================
  One host, two steps, exactly as the login modal is built
  (Magento_Theme::html/login-modal.phtml): the step markup is rendered inert
  and the script shows one at a time. Unlike the address dialog these are not
  fetched — they are a fixed set of fields with no server-side state to read,
  so a request to fetch them would buy nothing.

  BOTH STEPS SHIP WITH `hidden`, AND THE STYLESHEET HAS TO HONOUR IT. It did
  not: `.spartrak-account-dialog__step` declared `display: flex`, which beats
  the UA sheet's `[hidden] { display: none }`, so opening the OTP step drew
  the password step underneath it in the same modal. Fixed in
  components/_account.less, where the full note lives — recorded here too
  because this markup is what depends on it.

  THE OTP STEP is the design's own. THE PASSWORD STEP is not in Figma; it is
  composed from components that are — the same `.spartrak-account-field`
  band, the same footer buttons — because Magento will not change an email
  address without the current password
  (Account\EditPost::processChangeEmailRequest), and this card has no password
  box for it. Confirmed as the approach before building it; the frame it
  deserves is still outstanding.
*/ ?>
<div class="spartrak-account-dialog" data-spartrak-account-dialog hidden>

    <section class="spartrak-account-dialog__step" data-spartrak-dialog-step="otp" hidden>
        <p class="spartrak-account-dialog__lede">
            <?= $escaper->escapeHtml(
                __('We have sent a verification code to your new phone number.')
            ) ?>
        </p>

        <p class="spartrak-account-dialog__phone" dir="ltr" data-spartrak-otp-phone>
            <span class="spartrak-account-dialog__phone-icon" aria-hidden="true"></span>
            <span data-spartrak-otp-phone-value></span>
        </p>

        <?php /*
          One input per digit. `inputmode=numeric` puts a phone keypad up
          without `type=number`, which would add spinners and accept "e".
        */ ?>
        <div class="spartrak-otp" data-spartrak-otp-group role="group"
             aria-label="<?= $escaper->escapeHtmlAttr(__('Verification code')) ?>">
            <?php for ($i = 1; $i <= $codeLength; $i++) : ?>
                <input type="text"
                       class="spartrak-otp__box"
                       data-spartrak-otp-box
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="1"
                       aria-label="<?= $escaper->escapeHtmlAttr(__('Digit %1', $i)) ?>">
            <?php endfor; ?>
        </div>

        <p class="spartrak-account-dialog__error" data-spartrak-dialog-error role="alert" hidden></p>

        <div class="spartrak-account-dialog__actions">
            <button type="button" class="spartrak-account-dialog__submit" data-spartrak-otp-submit>
                <?= $escaper->escapeHtml(__('Next')) ?>
            </button>
            <button type="button" class="spartrak-account-dialog__secondary" data-spartrak-otp-resend>
                <?= $escaper->escapeHtml(__('Resend the code')) ?>
            </button>
        </div>
    </section>

    <section class="spartrak-account-dialog__step" data-spartrak-dialog-step="password" hidden>
        <?php /*
          ONE FIELD, AND ONLY FOR AN EMAIL CHANGE.

          It used to carry three — current, new, confirm — because the card had
          a تغيير link that reused this step to change the password. That link
          is gone (see the card body above), so the two new-password fields
          went with it: leaving them here as markup no path can reach is the
          "commented-out dead code" CLAUDE.md §18 rules out.

          Posts through the CARD's own form, not its own action: the field is
          moved into `#form-validate` on submit so core's editPost receives it
          alongside the name and email it already expects. One save path, which
          is what keeps this dialog from being a second place that can change
          an account.
        */ ?>
        <p class="spartrak-account-dialog__lede">
            <?= $escaper->escapeHtml(__('Confirm your current password to save these changes.')) ?>
        </p>

        <div class="spartrak-account-field">
            <label class="spartrak-account-field__label" for="spartrak-dialog-current-password">
                <?= $escaper->escapeHtml(__('Current password')) ?>
            </label>
            <div class="spartrak-account-field__band">
                <input type="password"
                       id="spartrak-dialog-current-password"
                       class="spartrak-account-field__input"
                       autocomplete="current-password"
                       data-spartrak-dialog-current-password>
            </div>
        </div>

        <p class="spartrak-account-dialog__error" data-spartrak-dialog-error role="alert" hidden></p>

        <div class="spartrak-account-dialog__actions">
            <button type="button" class="spartrak-account-dialog__submit" data-spartrak-password-submit>
                <?= $escaper->escapeHtml(__('Save changes')) ?>
            </button>
            <button type="button" class="spartrak-account-dialog__secondary" data-spartrak-dialog-cancel>
                <?= $escaper->escapeHtml(__('Cancel')) ?>
            </button>
        </div>
    </section>
</div>

<script type="text/x-magento-init">
    {
        "#form-validate": {
            "validation": {}
        },
        "[data-spartrak-account-dialog]": {
            "Spartrak_CustomerAccount/js/account-edit": {
                "formSelector": "#form-validate",
                "otpSend": "<?= $escaper->escapeJs($escaper->escapeUrl(
                    $block->getUrl('spartrak_auth/otp/send', ['_secure' => true])
                )) ?>",
                "otpVerify": "<?= $escaper->escapeJs($escaper->escapeUrl(
                    $block->getUrl('spartrak_auth/otp/verify', ['_secure' => true])
                )) ?>",
                "phoneCommit": "<?= $escaper->escapeJs($escaper->escapeUrl(
                    $block->getUrl('spartrak_auth/account/phoneChange', ['_secure' => true])
                )) ?>",
                "purpose": "<?= $escaper->escapeJs($authConfig?->getPhoneChangePurpose() ?? '') ?>",
                "codeLength": <?= (int) $codeLength ?>,
                "dialCode": "<?= $escaper->escapeJs($profile?->getPhoneDialCode() ?? '') ?>",
                "otpTitle": "<?= $escaper->escapeJs(__('Enter the OTP code')) ?>",
                "confirmTitle": "<?= $escaper->escapeJs(__('Confirm your password')) ?>"
            }
        }
    }
</script>
